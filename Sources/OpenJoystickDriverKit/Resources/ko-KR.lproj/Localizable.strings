"platform.macos.cli.root.group.abstract" = "macOS 게임패드 드라이버인 OpenJoystickDriver를 구성하고 점검합니다.";
"platform.macos.cli.root.group.discussion" = "여기서 시작하세요:\n  ojd status             서비스, 확장 프로그램, 권한을 확인합니다.\n  ojd diagnose           모든 검사를 실행하고 문제를 보고합니다.\n  ojd controller list    연결된 컨트롤러를 나열합니다.\n\n예시:\n  # 컨트롤러 하나의 입력이 바뀔 때마다 출력\n  ojd controller watch 045E:028E\n  # 연결된 컨트롤러를 JSON으로 나열\n  ojd --json controller list\n\n환경 변수(플래그가 변수보다 우선합니다):\n  OJD_NO_INPUT=1         --no-input과 같습니다.\n  OJD_TIMEOUT=SECONDS    --timeout과 같습니다.\n  OJD_COLOR=WHEN         auto, always(터미널이 아니어도 색상 사용), 또는 never.\n\n셸 자동 완성:\n  ojd --generate-completion-script zsh|bash|fish\n\n종료 코드:\n  0    성공.\n  1    명령이 실패했습니다.\n  64   사용법 오류.\n  69   서비스가 실행 중이 아닙니다. ‘ojd service start’로 시작하세요.\n  77   macOS 권한이 없습니다.\n  127  저장소 빌드가 명령을 설치된 앱에 넘기지 못했습니다.\n  130  중단됨.";
"cli.shared.help.globalOptions" = "모든 명령은 전역 옵션도 받습니다. 목록은 ‘ojd --help’에서 확인하세요.";
"cli.shared.error.envTimeout" = "OJD_TIMEOUT에는 0보다 큰 초 단위 숫자가 필요합니다.";
"cli.shared.error.envColor" = "OJD_COLOR에는 auto, always, never 중 하나가 필요합니다.";
"cli.shared.error.envNoInput" = "OJD_NO_INPUT에는 1, true, yes, 0, false, no 중 하나가 필요합니다.";
"cli.virtual.feed.errorPlain" = "--plain은 JSON 줄을 출력하는 ‘virtual feed’에 적용되지 않습니다. --plain을 빼세요.";
"cli.controller.watch.examples" = "예시:\n  # 10초 동안 입력 출력\n  ojd controller watch 045E:028E --duration 10\n  # 처음 누른 컨트롤을 JSON으로 출력\n  ojd controller watch 045E:028E --first-press --json\n  # 모든 컨트롤러와 해당 가상 게임패드가 보내는 내용을 관찰\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "예시:\n  # 주 모터 두 개를 세기 180으로 0.45초 동안 작동\n  ojd controller rumble 045E:028E\n  # 주 모터 두 개를 최대 세기로 2초 동안 작동\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "예시:\n  # 라이트바를 주황색으로 설정\n  ojd controller light 054C:09CC --color FF8000\n  # 색상과 낮은 밝기 설정\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "예시:\n  # 컨트롤러 모델용 프로필 만들기\n  ojd profile create Racing --controller 045E:028E\n  # Safari가 맨 앞에 있을 때만 적용\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "예시:\n  # 프로필 이름 변경\n  ojd profile set Racing name Rally\n  # 첫 번째 스틱 매핑의 안쪽 데드존 설정\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "예시:\n  # 남쪽 버튼을 누르고 있는 동안 Space 누름 유지\n  ojd binding set Racing button:south key:space\n  # 누를 때마다 J 켜기와 끄기 전환\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # 누르고 있는 동안 J를 초당 10번 반복\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "예시:\n  # 레코드 파일 설치\n  ojd record install 045E-028E.json\n  # 표준 입력에서 레코드 읽기\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "예시:\n  # 프로그램이 서비스를 사용하도록 허용\n  ojd access grant /Applications/Example.app\n  # 한 출처에서 제공되는 페이지용 토큰 만들기\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
"cli.service.group.abstract" = "OpenJoystickDriver 서비스를 시작 또는 중지하거나, 서비스가 요청을 받을 때까지 기다립니다.";
