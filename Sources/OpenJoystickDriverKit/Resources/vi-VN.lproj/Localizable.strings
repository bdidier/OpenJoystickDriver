"cli.access.enable.discussion" = "Hỏi xác nhận trước. Chỉ các chương trình được cấp quyền mới dùng được điểm cuối; thêm chúng bằng “ojd access grant”.";
"cli.access.enable.success" = "Điểm cuối đang lắng nghe tại %@.";
"cli.access.grant.abstract" = "Cho phép một chương trình đã ký, hoặc một token mới, dùng điểm cuối.";
"cli.access.grant.ad_hoc" = "%@ được ký ad-hoc hoặc chưa ký, nên bất kỳ chương trình cục bộ nào cũng có thể mạo nhận chữ ký của nó. Hãy ký bằng chứng chỉ Developer ID hoặc Apple Development, rồi cấp quyền.";
"cli.access.grant.platform_warning" = "Chương trình này do Apple ký. Nếu nó chạy các tập lệnh, như python3 hoặc osascript, mọi tập lệnh nó chạy đều có quyền truy cập này.";
"cli.access.grant.client_or_token" = "Đưa CLIENT hoặc --token NAME.";
"cli.access.grant.confirm" = "Cho phép %@, được ký %@, dùng điểm cuối với %@?";
"cli.access.grant.control_warning" = "Phạm vi control cho phép chương trình nhấn nút trên một tay cầm ảo, mà trò chơi và ứng dụng coi là đầu vào của bạn.";
"cli.access.grant.discussion" = "CLIENT là đường dẫn của chương trình hoặc một ID từ “ojd access list”. Quyền được cấp theo chữ ký của chương trình, nên vẫn hợp lệ khi chương trình được cập nhật hoặc di chuyển. Không thể cấp quyền cho chương trình ký ad-hoc hoặc chưa ký. Với --token thay cho CLIENT, lệnh tạo một token mà máy khách dùng để ký thử thách của dịch vụ trong hello: trên socket, trên WebSocket từ một trang ở một trong các giá trị --origin, hoặc, với token không có --origin, trên WebSocket từ chương trình không gửi tiêu đề Origin, chẳng hạn ứng dụng chạy trong hộp cát. Một trang không thể dùng phạm vi control. Token chỉ hiển thị một lần. Hỏi xác nhận trước.";
"cli.access.grant.origin" = "Một origin web, như http://127.0.0.1:8080, có các trang được phép dùng token trên WebSocket. Lặp lại để thêm. Các trang lớp phủ mà WebSocket phục vụ có origin http://127.0.0.1:PORT, với cổng mà “ojd access status” hiển thị.";
"cli.access.grant.origin_control" = "--origin không thể kết hợp với phạm vi control. Một trang không bao giờ điều khiển tay cầm ảo; hãy cấp control cho token không có --origin.";
