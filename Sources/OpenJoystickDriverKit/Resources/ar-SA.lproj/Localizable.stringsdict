<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>status.controllerConnected</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d وحدة تحكم متصلة</string>
			<key>zero</key>
			<string>لا توجد وحدات تحكم متصلة (%d)</string>
			<key>two</key>
			<string>%d وحدتا تحكم متصلتان</string>
			<key>few</key>
			<string>%d وحدات تحكم متصلة</string>
			<key>many</key>
			<string>%d وحدة تحكم متصلة</string>
			<key>other</key>
			<string>%d وحدة تحكم متصلة</string>
		</dict>
	</dict>
	<key>profiles.assignments</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d تعيين</string>
			<key>zero</key>
			<string>لا توجد تعيينات (%d)</string>
			<key>two</key>
			<string>%d تعيينان</string>
			<key>few</key>
			<string>%d تعيينات</string>
			<key>many</key>
			<string>%d تعيين</string>
			<key>other</key>
			<string>%d تعيين</string>
		</dict>
	</dict>
	<key>debug.outputDevices</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>zero</key>
			<string>لم يُكتشف أي جهاز إخراج لوحدة التحكم</string>
			<key>one</key>
			<string>اكتُشف %d جهاز إخراج لوحدة التحكم</string>
			<key>two</key>
			<string>اكتُشف جهازا إخراج لوحدة التحكم (%d)</string>
			<key>few</key>
			<string>اكتُشفت %d أجهزة إخراج لوحدة التحكم</string>
			<key>many</key>
			<string>اكتُشف %d جهاز إخراج لوحدة التحكم</string>
			<key>other</key>
			<string>اكتُشف %d جهاز إخراج لوحدة التحكم</string>
		</dict>
	</dict>
	<key>library.records.bundled</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>d</string>
			<key>one</key>
			<string>%d سجل إضافي مضمّن مع التطبيق.</string>
			<key>zero</key>
			<string>%d سجل إضافي مضمّن مع التطبيق.</string>
			<key>two</key>
			<string>%d سجلان إضافيان مضمّنان مع التطبيق.</string>
			<key>few</key>
			<string>%d سجلات إضافية مضمّنة مع التطبيق.</string>
			<key>many</key>
			<string>%d سجلًا إضافيًا مضمّنًا مع التطبيق.</string>
			<key>other</key>
			<string>%d سجل إضافي مضمّن مع التطبيق.</string>
		</dict>
	</dict>
</dict>
</plist>
