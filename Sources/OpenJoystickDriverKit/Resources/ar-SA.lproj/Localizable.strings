/* Text of error E1001, sent to a client that connects to the endpoint while the endpoint is off, and printed by 'ojd explain'. The command in quotes stays as written. */
"error.E1001.message" = "نقطة النهاية متوقفة. شغّلها باستخدام «ojd access enable» ثم اتصل مرة أخرى.";
/* Text of error E1002, sent to an endpoint client that has no grant for the scopes it asked for or whose signature or proof is not valid. The two commands in quotes stay as written. */
"error.E1002.message" = "رفضت الخدمة هذا العميل. ليس لديه إذن للنطاقات التي طلبها، أو أن توقيعه أو إثباته غير صالح. شغّل «ojd access list»، وامنح العميل الإذن باستخدام «ojd access grant»، ثم اتصل مرة أخرى.";
/* Text of error E1003, sent when a line on the endpoint is invalid or arrives at the wrong time. Hello is the name of the first line kind and stays as written. */
"error.E1003.message" = "تعذّر على الخدمة قبول السطر. إما أنه غير صالح أو أنه وصل في وقت خاطئ. أرسل hello أولًا ثم طلبًا واحداً، وتحقّق من كل سطر مقابل مخطط نقطة النهاية.";
/* Text of error E1004, sent when the endpoint refuses a ninth connection on one transport. The number 8 is the fixed limit; the socket and the WebSocket are the two transports. */
"error.E1004.message" = "بلغت نقطة النهاية الحد الأقصى وهو 8 اتصالات لكل وسيلة نقل (المقبس وWebSocket كلٌّ على حدة). أغلق اتصالًا لا تحتاج إليه ثم اتصل مرة أخرى.";
/* Text of error E1005, sent to an endpoint client whose grant is removed while it is connected. The command in quotes stays as written. */
"error.E1005.message" = "أُزيل إذن هذا العميل أثناء اتصاله. امنحه الإذن مرة أخرى باستخدام «ojd access grant» ثم اتصل مرة أخرى.";
/* Text of error E1006, sent to an endpoint client that reads lines too slowly, so that 256 lines wait for it. 256 is the fixed limit. */
"error.E1006.message" = "قرأ العميل الأسطر ببطء شديد وانتظر 256 سطرًا. اقرأ الأسطر بالسرعة التي تصل بها ثم اتصل مرة أخرى.";
/* Text of error E1007, sent when the service runs four virtual gamepads and a feed asks for another one. feed is a request kind of the endpoint and stays as written. */
"error.E1007.message" = "تشغّل الخدمة بالفعل 4 وحدات تحكم افتراضية. أغلق feed لا تحتاج إليه ثم أرسل feed مرة أخرى.";
/* Text of error E1008, sent when the virtual gamepad of a feed is closed. feed is a request kind of the endpoint and stays as written. */
"error.E1008.message" = "أُغلقت وحدة التحكم الافتراضية، أو لا تشغّل الخدمة أي وحدة. اتصل مرة أخرى وأرسل feed.";
/* Text of error E1009, sent when a line names an API version that the service does not speak. apiVersion and details.supportedAPIVersions are field names and stay as written. */
"error.E1009.message" = "لا تدعم الخدمة apiVersion الموجود في أحد الأسطر. أرسل أحد الإصدارات المذكورة في details.supportedAPIVersions ثم اتصل مرة أخرى.";
/* Text of error E1010, sent when a line has a kind that the service does not know or does not accept at this point. Hello, Subscription, FeedRequest and Frame are kinds of lines and stay as written. */
"error.E1010.message" = "يحتوي أحد الأسطر على kind لا تعرفه الخدمة أو لا تقبله في هذه المرحلة. أرسل Hello أولًا، ثم Subscription أو FeedRequest، ثم أسطر Frame، واتصل مرة أخرى.";
/* Text of error E1011, sent when a line has no apiVersion or no kind. apiVersion and kind are field names and stay as written. */
"error.E1011.message" = "لا يحتوي أحد الأسطر على apiVersion أو على kind. يجب أن يحمل كل سطر كليهما. أضفهما واتصل مرة أخرى.";
