"error.E4006.message" = "لا توجد حزمة مثبتة بهذا الاسم. شغّل ojd mod list لعرض الحزم المثبتة.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "تعذّر تغيير مجلد الحزم. افحص مساحة القرص الحرة وأذونات المجلد.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "المستند لا يحتوي على apiVersion، أو أن apiVersion غير مدعوم في هذا الإصدار من OpenJoystickDriver. غيّر المستند إلى apiVersion المدعوم الذي تذكره الرسالة، ثم شغّل الأمر مرة أخرى.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "وصف البروتوكول غير صالح. تحقق من الملف مقابل مخطط protocol-description وأصلح الحقل الذي تذكره الرسالة.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "يذكر وصف البروتوكول عائلة تختلف عن اسم ملفه. سمِّ الملف باسم عائلته.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "يدرج وصف البروتوكول متغيرًا لا توجد في عائلته. استخدم أحد متغيرات العائلة.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.json is a file name and stays as written. */
"error.E5005.message" = "ملف الوصول AccessGrants.json تالف. أصلح الملف أو احذفه، ثم امنح الوصول مرة أخرى.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "تعذرت قراءة ملف مفتاح معرّفات الأجهزة PortKeyInstallation.key، أو أن حجمه ليس 32 بايت. استعد الملف من نسخة احتياطية. إذا حذفته بدلاً من ذلك، فسينشئ OpenJoystickDriver مفتاحاً جديداً وسيتغير كل معرّف جهاز.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "سجل وحدة التحكم أو patch غير صالح. تحقق من الملف مقابل مخططه وأصلح الحقل الذي تذكره الرسالة.";
