"platform.macos.cli.root.group.abstract" = "اضبط OpenJoystickDriver، مشغّل أذرع اللعب لنظام macOS، وافحصه.";
"platform.macos.cli.root.group.discussion" = "ابدأ من هنا:\n  ojd status             فحص الخدمة والامتداد والأذونات.\n  ojd diagnose           تشغيل كل الفحوصات والإبلاغ عن الخلل.\n  ojd controller list    عرض وحدات التحكم المتصلة.\n\nأمثلة:\n  # طباعة مدخلات وحدة تحكم واحدة عند تغيّرها\n  ojd controller watch 045E:028E\n  # عرض وحدات التحكم المتصلة بصيغة JSON\n  ojd --json controller list\n\nالبيئة (الخيار يتغلب على متغيره):\n  OJD_NO_INPUT=1         مثل --no-input.\n  OJD_TIMEOUT=SECONDS    مثل --timeout.\n  OJD_COLOR=WHEN         auto أو always (ألوان حتى خارج الطرفية) أو never.\n\nإكمال الصدفة:\n  ojd --generate-completion-script zsh|bash|fish\n\nرموز الخروج:\n  0    نجاح.\n  1    فشل الأمر.\n  64   خطأ في الاستخدام.\n  69   الخدمة غير قيد التشغيل. ابدأها باستخدام «ojd service start».\n  77   إذن macOS مفقود.\n  127  تعذّر على بناء المستودع تسليم الأمر إلى التطبيق المثبّت.\n  130  تمت المقاطعة.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "كل أمر يقبل الخيارات العامة أيضًا؛ يعرضها «ojd --help».";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "يحتاج OJD_TIMEOUT إلى عدد ثوانٍ أكبر من 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "يحتاج OJD_COLOR إلى auto أو always أو never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "يحتاج OJD_NO_INPUT إلى 1 أو true أو yes أو 0 أو false أو no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "لا ينطبق --plain على «virtual feed» الذي يطبع أسطر JSON. احذف --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "أمثلة:\n  # طباعة المدخلات لمدة 10 ثوانٍ\n  ojd controller watch 045E:028E --duration 10\n  # طباعة أول عنصر تحكم يُضغط عليه بصيغة JSON\n  ojd controller watch 045E:028E --first-press --json\n  # مراقبة كل وحدات التحكم وما ترسله وحدة التحكم الافتراضية الخاصة بها\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "أمثلة:\n  # تشغيل المحركين الرئيسيين بقوة 180 لمدة 0.45 ثانية\n  ojd controller rumble 045E:028E\n  # تشغيل المحركين الرئيسيين بكامل القوة لمدة ثانيتين\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "أمثلة:\n  # ضبط شريط الإضاءة على اللون البرتقالي\n  ojd controller light 054C:09CC --color FF8000\n  # ضبط اللون مع سطوع منخفض\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "أمثلة:\n  # إنشاء ملف تعريف لطراز وحدة تحكم\n  ojd profile create Racing --controller 045E:028E\n  # تطبيقه فقط أثناء ظهور Safari في المقدمة\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "أمثلة:\n  # إعادة تسمية ملف تعريف\n  ojd profile set Racing name Rally\n  # ضبط المنطقة الميتة الداخلية لأول تعيين للعصا\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "أمثلة:\n  # الضغط مطولًا على Space أثناء الضغط على الزر الجنوبي\n  ojd binding set Racing button:south key:space\n  # تبديل J عند كل ضغطة\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # تكرار J عشر مرات في الثانية أثناء الضغط\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "أمثلة:\n  # تثبيت ملف سجل\n  ojd record install 045E-028E.json\n  # قراءة السجل من الإدخال القياسي\n  ojd record install - < 045E-028E.json";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "أمثلة:\n  # السماح لبرنامج باستخدام الخدمة\n  ojd access grant /Applications/Example.app\n  # إنشاء رمز مميز لصفحات تُقدَّم من أصل واحد\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
