"platform.macos.cli.controller.disconnect.bluetoothLe" = "%@ متصلة عبر Bluetooth Low Energy، ولا تستطيع الخدمة فصلها. أوقف تشغيل وحدة التحكم أو افصلها في إعدادات النظام > Bluetooth.";
