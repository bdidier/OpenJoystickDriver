"cli.shared.error.staleInstallation" = "تطبيق OpenJoystickDriver.app المثبّت أقدم من مصادر المستودع هذه. شغّل «./Scripts/ojd build install-fast dev» أو اضبط OJD_RUN_REPOSITORY_CLI=1 لتشغيل هذا الإصدار.";
