"cli.diagnose.group.soakVerdictResidentLimit" = "Se superó el límite de tamaño residente: tamaño residente %1$.1f MiB, huella de memoria %2$.1f MiB, descriptores de archivo %3$lld, CPU %4$.1f %% durante %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when resources such as file descriptors grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictResourceGrowth" = "Crecimiento de recursos observado: tamaño residente %1$.1f MiB, huella de memoria %2$.1f MiB, descriptores de archivo %3$lld, CPU %4$.1f %% durante %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when nothing grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictStable" = "Estable: tamaño residente %1$.1f MiB, huella de memoria %2$.1f MiB, descriptores de archivo %3$lld, CPU %4$.1f %% durante %5$.0f s";
