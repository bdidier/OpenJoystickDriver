"platform.macos.cli.root.group.abstract" = "Configura e inspecciona OpenJoystickDriver, el controlador de gamepads para macOS.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Empieza aquí:\n  ojd status             Comprueba el servicio, la extensión y los permisos.\n  ojd diagnose           Ejecuta todas las comprobaciones e informa de fallos.\n  ojd controller list    Lista los mandos conectados.\n\nEjemplos:\n  # Muestra la entrada de un mando cuando cambia\n  ojd controller watch 045E:028E\n  # Lista los mandos conectados como JSON\n  ojd --json controller list\n\nEntorno (una opción prevalece sobre su variable):\n  OJD_NO_INPUT=1         Igual que --no-input.\n  OJD_TIMEOUT=SECONDS    Igual que --timeout.\n  OJD_COLOR=WHEN         auto, always (color incluso sin terminal) o never.\n\nCompletado del shell:\n  ojd --generate-completion-script zsh|bash|fish\n\nCódigos de salida:\n  0    Correcto.\n  1    El comando falló.\n  64   Error de uso.\n  69   El servicio no se está ejecutando. Inícialo con «ojd service start».\n  77   Falta un permiso de macOS.\n  127  Una compilación del repositorio no pudo pasar el comando a la app instalada.\n  130  Interrumpido.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Todos los comandos aceptan también las opciones globales; «ojd --help» las lista.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT necesita un número de segundos mayor que 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR necesita auto, always o never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT necesita 1, true, yes, 0, false o no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain no se aplica a «virtual feed», que imprime líneas JSON. Omite --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Ejemplos:\n  # Muestra la entrada durante 10 segundos\n  ojd controller watch 045E:028E --duration 10\n  # Muestra el primer control pulsado, como JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Observa todos los mandos y lo que envía su mando virtual\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Ejemplos:\n  # Activa los dos motores principales a 180 durante 0,45 segundos\n  ojd controller rumble 045E:028E\n  # Activa los dos motores principales a plena potencia durante 2 segundos\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Ejemplos:\n  # Pone la barra de luz en naranja\n  ojd controller light 054C:09CC --color FF8000\n  # Establece el color y un brillo bajo\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Ejemplos:\n  # Crea un perfil para un modelo de mando\n  ojd profile create Racing --controller 045E:028E\n  # Aplícalo solo mientras Safari está en primer plano\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Ejemplos:\n  # Cambia el nombre de un perfil\n  ojd profile set Racing name Rally\n  # Establece la zona muerta interior de la primera asignación de stick\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Ejemplos:\n  # Mantiene Espacio mientras se mantiene el botón sur\n  ojd binding set Racing button:south key:space\n  # Alterna J en cada pulsación\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Repite J 10 veces por segundo mientras se mantiene\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Ejemplos:\n  # Instala un archivo de registro\n  ojd record install 045E-028E.json\n  # Lee el registro desde stdin\n  ojd record install - < 045E-028E.json";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Ejemplos:\n  # Permite que un programa use el servicio\n  ojd access grant /Applications/Example.app\n  # Crea un token para páginas servidas desde un origen\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "Inicia o detiene el servicio de OpenJoystickDriver, o espera hasta que acepte solicitudes.";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "El servicio se está ejecutando.";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "Abre la app en segundo plano y espera hasta que su servicio acepte solicitudes.";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "Este ojd no está dentro de OpenJoystickDriver.app, así que no puede iniciar el servicio. Abre la app instalada o ejecuta el ojd que contiene.";
/* Error of 'ojd service start' when macOS cannot open the app. %@ is the path of the app. Finder is the macOS file manager. */
"platform.macos.cli.service.start.openFailed" = "macOS no pudo abrir %@. Ábrelo desde el Finder para ver el motivo.";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "Detiene el servicio y espera hasta que termine. Los mandos conectados vuelven a macOS.";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "No se pudo detener el servicio: %@. Sal de OpenJoystickDriver desde su menú.";
/* Error of 'ojd service stop' when the service keeps running. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.service.stop.timeout" = "El servicio no se detuvo en %@. Vuelve a intentarlo con un --timeout mayor.";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "El servicio está detenido.";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "Espera hasta que el servicio acepte solicitudes. --timeout limita la espera (5 segundos por defecto).";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "El servicio no aceptó solicitudes en %@. Inícialo con «ojd service start» o vuelve a intentarlo con un --timeout mayor.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Muestra el servicio, la extensión, los permisos y los mandos conectados.";
/* Long description in the help of 'ojd status'. */
"cli.status.group.discussion" = "Funciona con el servicio detenido: lo informa como detenido y termina con 0.";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "Accesibilidad";
/* Row label in the output of 'ojd status'. The version of this command line tool follows. */
"cli.status.group.labelCommandLineTool" = "Herramienta de línea de comandos";
/* Heading in the output of 'ojd status' above the list of connected controllers. %lld is the number of controllers. */
"cli.status.group.labelControllers" = "Mandos (%lld)";
/* Row label in the output of 'ojd status'. The state of the driver extension follows. */
"cli.status.group.labelTransportExtension" = "Extensión";
/* Row label in the output of 'ojd status' for the Input Monitoring permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputRead" = "Monitorización de entrada";
/* Row label in the output of 'ojd status'. The reason why the stored profile overrides could not be read follows. */
"cli.status.group.labelOverrideError" = "Error de anulación";
/* Heading in the output of 'ojd status' above the list of controllers that macOS serves natively. %lld is the number of controllers. */
"platform.macos.cli.status.group.labelPassThrough" = "Cedidos a macOS (%lld)";
/* Row label in the output of 'ojd status'. The state and version of the service follow. */
"cli.status.group.labelService" = "Servicio";
/* Heading in the output of 'ojd status' above the list of connected devices that the driver does not support. %lld is the number of devices. */
"cli.status.group.labelUnbound" = "Dispositivos no compatibles (%lld)";
/* Row label in the output of 'ojd status'. The state of the virtual gamepad follows. */
"cli.status.group.labelVirtualDevice" = "Mando virtual";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "Los mandos y los permisos aparecen cuando el servicio se ejecuta: «ojd service start».";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "Activa el punto de conexión y elige qué programas pueden leer mandos a través de él.";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "La ruta del programa o un ID de cliente.";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "No hay ningún programa en %@ ni ningún cliente con ese ID. Consulta los ID con «ojd access list».";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ no contiene ningún programa firmado. Concede acceso al paquete de la app o al ejecutable del programa.";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "Desactiva el punto de conexión y cierra sus conexiones; los accesos concedidos se conservan.";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "El punto de conexión está desactivado y sus conexiones están cerradas.";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "El punto de conexión es un socket local desde el que los programas autorizados leen eventos de los mandos. Está desactivado hasta que ejecutes «ojd access enable», y el servicio solo atiende a los programas cuya firma hayas autorizado, o que envíen un token que hayas autorizado. «ojd access web enable» añade un WebSocket en 127.0.0.1 para páginas de overlay.";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "Activa el punto de conexión.";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "¿Activar el punto de conexión para que los programas que autorices puedan leer la entrada de todos los mandos?";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "Pide confirmación primero. Solo los programas autorizados pueden usar el punto de conexión; añádelos con «ojd access grant».";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "El punto de conexión escucha en %@.";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "Permite que un programa firmado, o un token nuevo, use el punto de conexión.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ tiene firma ad-hoc o no está firmado, así que cualquier programa local puede reclamar su firma. Fírmalo con un certificado Developer ID o Apple Development y luego concédele acceso.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "Apple firmó este programa. Si ejecuta scripts, como python3 u osascript, todos los scripts que ejecute obtendrán este acceso.";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "Indica CLIENT o --token NAME.";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "¿Permitir que %1$@, firmado como %2$@, use el punto de conexión con %3$@?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
"cli.access.grant.controlWarning" = "El ámbito control permite que el programa pulse botones de un mando virtual, que los juegos y las apps tratan como tu entrada.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT es la ruta del programa o un ID de «ojd access list». El acceso se asocia a la firma del programa, así que sigue siendo válido cuando el programa se actualiza o se mueve. No se puede conceder acceso a programas con firma ad-hoc ni a programas sin firmar. Con --token en lugar de CLIENT, crea un token con el que un cliente firma el desafío del servicio en su hello, por el socket, por el WebSocket desde una página de uno de los valores de --origin o, si el token no tiene --origin, por el WebSocket desde un programa que no envía encabezado Origin, como una app en un entorno aislado. Una página no puede usar el ámbito control. El token solo se muestra una vez. Pide confirmación primero.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Un origen web, como http://127.0.0.1:8080, cuyas páginas pueden usar el token en el WebSocket. Repítelo para más. Las páginas de overlay que sirve el WebSocket tienen el origen http://127.0.0.1:PORT, con el puerto que muestra «ojd access status».";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin no se puede combinar con el ámbito control. Una página nunca maneja un mando virtual; concede control a un token sin --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin necesita --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Un ámbito que conceder: read o control. Repítelo para ambos.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "Se concedió %1$@ a %2$@ (ID %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Crea un token con este nombre en lugar de autorizar un programa.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "¿Crear el token %1$@ con %2$@, para los programas de este Mac?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "Se concedió %1$@ al token %2$@ (ID %3$@). Mantén el token en secreto; no se vuelve a mostrar:";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "¿Crear el token %1$@ con %2$@, para los programas de este Mac y para las páginas de %3$@?";
/* One-line summary of 'ojd access list' in the command list and at the top of its help. */
"cli.access.list.abstract" = "Muestra los clientes y tokens autorizados, y los rechazados en las últimas 24 horas.";
/* Long description in the help of 'ojd access list'. It says that the printed IDs work with 'ojd access grant' and 'ojd access revoke'. token:NAME stays as written. */
"cli.access.list.discussion" = "Cada cliente tiene un ID que aceptan «ojd access grant» y «ojd access revoke»; el ID de un token es token:NAME.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Autorizados:";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Ninguno";
/* Heading of the list of clients that connected and were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refused" = "Rechazados en las últimas 24 horas:";
/* Heading of the list of tokens that were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refusedTokens" = "Tokens rechazados en las últimas 24 horas:";
/* Heading of the list of granted tokens printed by 'ojd access list'. */
"cli.access.list.tokens" = "Tokens autorizados:";
/* Lowercase placeholder printed in the token list when a refused token has no name. */
"cli.access.list.unknownToken" = "token desconocido";
/* Error of 'ojd access' commands that change who may read the controllers, when the input is not a terminal and --force is missing. --force stays as written. */
"cli.access.group.needsForce" = "Este cambio da a los programas acceso a tus mandos. Añade --force para confirmarlo sin preguntar.";
/* One-line summary of 'ojd access revoke' in the command list and at the top of its help. */
"cli.access.revoke.abstract" = "Quita el acceso de un programa, o algunos de sus ámbitos.";
/* Help text of the CLIENT argument of 'ojd access revoke'. token:NAME stays as written. */
"cli.access.revoke.client" = "La ruta del programa, un ID de cliente o token:NAME.";
/* Long description in the help of 'ojd access revoke'. CLIENT, --scope, 'ojd access list' and token:NAME stay as written. */
"cli.access.revoke.discussion" = "CLIENT es la ruta del programa, un ID de «ojd access list» o token:NAME para un token. Sin --scope, se quita todo el acceso. Las conexiones que pierden un ámbito se cierran.";
/* Message printed after 'ojd access revoke --scope' removed some scopes. %1$@ is the client ID, %2$@ is the list of scopes it keeps and %3$@ is the number of connections that were closed. */
"cli.access.revoke.partial" = "El cliente %1$@ conserva %2$@. Conexiones cerradas: %3$@.";
/* Help text of the --scope option of 'ojd access revoke'. The values read and control stay as written because the user types them. */
"cli.access.revoke.scope" = "Un ámbito que quitar: read o control. Repítelo para ambos.";
/* Message printed after 'ojd access revoke' removed a whole grant. %1$@ is the client ID and %2$@ is the number of connections that were closed. */
"cli.access.revoke.success" = "Se quitó el acceso del cliente %1$@. Conexiones cerradas: %2$@.";
/* One-line summary of 'ojd access status' in the command list and at the top of its help. */
"cli.access.status.abstract" = "Muestra si el punto de conexión está activado, su socket y sus clientes conectados.";
/* Line of 'ojd access status' with three counts. %1$@ is the number of connected clients, %2$@ the number of granted clients and %3$@ the number of clients refused in the last 24 hours. */
"cli.access.status.counts" = "Clientes conectados: %1$@. Clientes autorizados: %2$@. Rechazados en las últimas 24 horas: %3$@.";
/* Line of 'ojd access status' when the endpoint is off. Keep the colon and the space after it. */
"cli.access.status.off" = "Punto de conexión: desactivado";
/* Line of 'ojd access status' when the endpoint is on. Keep the colon and the space after it. */
"cli.access.status.on" = "Punto de conexión: activado";
/* Line of 'ojd access status' that shows where the endpoint listens. %@ is the socket path. */
"cli.access.status.socket" = "Ubicación del socket: %@";
/* Line of 'ojd access status' with two token counts. %1$@ is the number of granted tokens and %2$@ the number of tokens refused in the last 24 hours. */
"cli.access.status.tokenCounts" = "Tokens autorizados: %1$@. Tokens rechazados en las últimas 24 horas: %2$@.";
/* Line of 'ojd access status' when the WebSocket is turned on but its port could not be opened. %@ is the port number. */
"cli.access.status.webClosed" = "WebSocket: activado, pero no se pudo abrir el puerto %@";
/* Line of 'ojd access status' when the WebSocket is off. Keep the colon and the space after it. */
"cli.access.status.webOff" = "WebSocket: desactivado";
/* Line of 'ojd access status' when the WebSocket is on. %1$@ is the WebSocket address, %2$@ is the address of the overlay pages and %3$@ is the folder they are served from. */
"cli.access.status.webOn" = "WebSocket: activado en %1$@; páginas de overlay en %2$@ desde %3$@";
/* One-line summary of 'ojd access web' in the command list and at the top of its help. The WebSocket serves overlay pages. */
"cli.access.web.abstract" = "Activa o desactiva el WebSocket para páginas de overlay.";
/* One-line summary of 'ojd access web disable' in the command list and at the top of its help. */
"cli.access.web.disableAbstract" = "Desactiva el WebSocket y cierra sus conexiones; los tokens se conservan.";
/* Message printed after 'ojd access web disable' turned the WebSocket off. */
"cli.access.web.disableSuccess" = "El WebSocket está desactivado y sus conexiones están cerradas.";
/* Long description in the help of 'ojd access web'. It names the address, the path /endpoint and the Overlays folder, which stay as written, and explains which pages may connect. */
"cli.access.web.discussion" = "El WebSocket solo escucha en 127.0.0.1, en /endpoint, y sirve los archivos de su carpeta Overlays en el mismo puerto. Una página debe proceder de un origen para el que se haya autorizado un token, y debe firmar el desafío del servicio con ese token en su hello; autoriza uno con «ojd access grant --token NAME --origin URL».";
/* One-line summary of 'ojd access web enable' in the command list and at the top of its help. */
"cli.access.web.enableAbstract" = "Activa el WebSocket.";
/* Yes or no question that 'ojd access web enable' asks on a terminal before it turns the WebSocket on. */
"cli.access.web.enableConfirm" = "¿Activar el WebSocket para que las páginas de los orígenes para los que autorices tokens puedan usar el punto de conexión?";
/* Long description in the help of 'ojd access web enable'. It says that a confirmation comes first and how the port is chosen. --port stays as written. */
"cli.access.web.enableDiscussion" = "Pide confirmación primero. Sin --port, usa el puerto guardado; la primera vez, el sistema elige un puerto libre y el servicio lo guarda.";
/* Help text of the --port option of 'ojd access web enable'. The range is a fixed fact of the command. */
"cli.access.web.port" = "El puerto en 127.0.0.1, de 1024 a 65535.";
/* Help text of the --automatic option of 'ojd access web enable'. */
"cli.access.web.automatic" = "Dejar que el sistema elija un puerto libre en lugar del guardado.";
/* Error of 'ojd access web enable' when --automatic and --port are both given. Both option names stay as written. */
"cli.access.web.automaticConflict" = "--automatic no se puede usar con --port.";
/* Error of 'ojd access web enable' when --port is outside the allowed range. --port stays as written. */
"cli.access.web.portRange" = "--port debe estar entre 1024 y 65535.";
