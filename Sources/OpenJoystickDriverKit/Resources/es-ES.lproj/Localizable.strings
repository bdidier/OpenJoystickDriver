"cli.controller.group.sessionNotFound" = "«%@» se desconectó antes de que la solicitud llegara. Vuelve a conectarlo e inténtalo de nuevo.";
/* One-line summary of 'ojd controller show' in the command list and at the top of its help. */
"cli.controller.show.abstract" = "Mostrar la identidad, la propiedad, las capacidades y el mando virtual de un mando.";
