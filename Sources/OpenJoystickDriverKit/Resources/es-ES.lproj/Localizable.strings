"error.E1009.message" = "El servicio no admite la apiVersion de una línea. Envía una de las versiones de details.supportedAPIVersions y vuelve a conectar.";
/* Text of error E1010, sent when a line has a kind that the service does not know or does not accept at this point. Hello, Subscription, FeedRequest and Frame are kinds of lines and stay as written. */
"error.E1010.message" = "Una línea tiene un kind que el servicio no conoce o no acepta en este punto. Envía primero Hello, después Subscription o FeedRequest y luego líneas Frame, y vuelve a conectar.";
/* Text of error E1011, sent when a line has no apiVersion or no kind. apiVersion and kind are field names and stay as written. */
"error.E1011.message" = "A una línea le falta apiVersion o kind. Cada línea lleva ambos. Añádelos y vuelve a conectar.";
