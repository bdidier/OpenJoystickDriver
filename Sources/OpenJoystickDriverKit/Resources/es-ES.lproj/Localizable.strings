/* One-line summary of 'ojd config' in the command list and at the top of its help. */
"cli.config.group.abstract" = "Muestra la configuración que aplica OpenJoystickDriver y qué capa estableció cada valor.";
/* Long description in the help of 'ojd config'. It lists the configuration layers from lowest to highest priority; all.patch.json is a file name that stays as written. */
"cli.config.group.discussion" = "Los valores se apilan en capas, de la más baja a la más alta: valor predeterminado del controlador, registro incluido, registro del paquete, all.patch.json, tu registro, perfil activo. Cada clave de ajuste toma el valor de la capa más alta que la establece.";
/* One-line summary of 'ojd config show' in the command list and at the top of its help. */
"cli.config.show.abstract" = "Imprime cada valor de ajuste y la capa que lo estableció.";
/* Help text of the --controller option of 'ojd config show'. VVVV:PPPP stands for the vendor ID and product ID in hexadecimal and stays as written. */
"cli.config.show.controller" = "Muestra el ajuste efectivo de un mando, como VVVV:PPPP, en lugar de los valores predeterminados globales.";
/* Warning printed by 'ojd config show' when a part of the defaults file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.config.show.defaultsIgnored" = "%1$@ ignorado: %2$@";
/* Long description in the help of 'ojd config show'. --controller and all.patch.json stay as written. */
"cli.config.show.discussion" = "Sin --controller, imprime todas las claves de ajuste con su valor de all.patch.json y las familias cuyos registros las leen. Con él, imprime el registro del mando una vez apilados el registro incluido, los registros del paquete, all.patch.json y tu registro. Una clave que ninguna capa establece muestra «valor predeterminado del controlador».";
/* Indented line below a tuning key of 'ojd config show' that lists the controller families whose records read the key. %@ is the comma-separated list of family names. */
"cli.config.show.readBy" = "lo leen: %@";
/* Warning of 'ojd config show' about a key in all.patch.json that no connected controller reads. %1$@ is the key and %2$@ lists the families that do read it. */
"cli.config.show.unread" = "all.patch.json define %1$@, pero ningún mando conectado la lee. Familias que la leen: %2$@.";
/* Note printed by 'ojd config show' when it cannot check for unread keys because no controller is connected. all.patch.json stays as written. */
"cli.config.show.unreadSkippedNoController" = "No hay ningún mando conectado, así que se omitió la comprobación de las claves de all.patch.json que ningún mando lee.";
/* Note printed by 'ojd config show' when it cannot check for unread keys because the service is not running. all.patch.json stays as written. */
"cli.config.show.unreadSkippedNoService" = "El servicio no se está ejecutando, así que se omitió la comprobación de las claves de all.patch.json que ningún mando conectado lee.";
/* Value shown by 'ojd config show' for a tuning key that no layer sets, so the driver default applies. */
"cli.config.show.unset" = "valor predeterminado del controlador";
/* One-line summary of 'ojd setting' in the command list and at the top of its help. */
"cli.setting.group.abstract" = "Lista, lee o cambia los ajustes de la app OpenJoystickDriver.";
/* Error of 'ojd setting set' when the value is neither true nor false. %1$@ is the text the user gave and %2$@ is the setting name, which stays as written. true and false stay as written. */
"cli.setting.group.badValue" = "«%1$@» no es un valor válido para %2$@. Usa true o false.";
/* Help text of the developerTools setting in 'ojd setting list'. */
"cli.setting.group.developerTools" = "Muestra las herramientas de desarrollo en la ventana de Ajustes.";
/* Long description in the help of 'ojd setting'. */
"cli.setting.group.discussion" = "El servicio en ejecución aplica cada ajuste, así que todos los comandos de ajustes lo necesitan.";
/* One-line summary of 'ojd setting get' in the command list and at the top of its help. */
"cli.setting.get.abstract" = "Imprime el valor de un ajuste.";
/* Long description in the help of 'ojd setting get'. true, false and --json stay as written. */
"cli.setting.get.discussion" = "Imprime solo true o false, para scripts. Con --json, imprime la clave y el valor.";
/* Help text of the includePrereleaseUpdates setting in 'ojd setting list'. A pre-release version is a test version before a stable release. */
"cli.setting.group.includePrereleaseUpdates" = "Incluye versiones preliminares al buscar actualizaciones.";
/* Help text of the KEY argument of 'ojd setting get'. launchAtLogin is a setting name and stays as written. */
"cli.setting.group.key" = "El ajuste que leer, como launchAtLogin.";
/* Help text of the launchAtLogin setting in 'ojd setting list'. OpenJoystickDriver is the product name. */
"cli.setting.group.launchAtLogin" = "Abre OpenJoystickDriver cuando inicias sesión.";
/* One-line summary of 'ojd setting list' in the command list and at the top of its help. */
"cli.setting.list.abstract" = "Lista todos los ajustes y su valor.";
/* Help text of the notificationSounds setting in 'ojd setting list'. */
"cli.setting.group.notificationSounds" = "Reproduce un sonido con las notificaciones.";
/* Help text of the notifyControllerConnected setting in 'ojd setting list'. */
"cli.setting.group.notifyControllerConnected" = "Notifica cuando un mando se conecta o requiere atención.";
/* Help text of the notifyControllerDisconnected setting in 'ojd setting list'. */
"cli.setting.group.notifyControllerDisconnected" = "Notifica cuando un mando se desconecta.";
/* Help text of the notifyProfileActivated setting in 'ojd setting list'. */
"cli.setting.group.notifyProfileActivated" = "Notifica cuando se activa o cambia un perfil.";
/* Help text of the notifyProfileDeactivated setting in 'ojd setting list'. */
"cli.setting.group.notifyProfileDeactivated" = "Notifica cuando se desactiva el perfil activo.";
/* One-line summary of 'ojd setting set' in the command list and at the top of its help. */
"cli.setting.set.abstract" = "Cambia un ajuste.";
/* Long description in the help of 'ojd setting set'. true, false, launchAtLogin and System Settings stay as written. */
"platform.macos.cli.setting.set.discussion" = "Los valores son true o false. Termina con código 1 cuando macOS deja launchAtLogin desactivado hasta que lo apruebes en Ajustes del Sistema.";
/* Help text of the KEY argument of 'ojd setting set'. launchAtLogin is a setting name and stays as written. */
"cli.setting.set.key" = "El ajuste que cambiar, como launchAtLogin.";
/* Error of 'ojd setting set' when macOS does not apply a setting that needs approval. %1$@ is the setting name and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"platform.macos.cli.setting.set.notApplied" = "macOS no aplicó %1$@. Permite OpenJoystickDriver en Ajustes del Sistema > General > Ítems de inicio y extensiones y ejecuta «ojd setting get %2$@».";
/* Message printed after 'ojd setting set'. %1$@ is the setting name, which stays as written, and %2$@ is the value the service applied, true or false. */
"cli.setting.set.success" = "%1$@ establecido en %2$@.";
/* Help text of the VALUE argument of 'ojd setting set'. true and false stay as written. */
"cli.setting.set.value" = "El valor nuevo: true o false.";
/* Error of 'ojd setting' commands for an unknown setting. %1$@ is the text the user gave and %2$@ is the comma-separated list of valid setting names, which stay as written. */
"cli.setting.group.unknownKey" = "Ajuste desconocido «%1$@». Usa uno de estos: %2$@.";
/* One-line summary of 'ojd update' in the command list and at the top of its help. */
"cli.update.group.abstract" = "Comprueba si existe una versión más reciente de OpenJoystickDriver.";
/* One-line summary of 'ojd update check' in the command list and at the top of its help. GitHub is a brand name. */
"cli.update.check.abstract" = "Compara esta versión con la etiqueta de la última versión en GitHub.";
/* Message printed by 'ojd update check' when a newer release exists. %1$@ is the version of the release, %2$@ is the installed version and %3$@ is the address of the release page. */
"cli.update.check.available" = "OpenJoystickDriver %1$@ está disponible (tienes %2$@): %3$@";
/* Long description in the help of 'ojd update check'. ojd stays as written. */
"cli.update.check.discussion" = "Solo se ejecuta cuando lo pides; ojd nunca comprueba por su cuenta. No descarga ni instala nada. Termina con código 0 haya o no una actualización, y con 1 si la comprobación falla.";
/* Error of 'ojd update check' when the check fails because of the network. %@ is the reason from the system. */
"cli.update.check.failed" = "No se pudo buscar actualizaciones: %@. Comprueba tu conexión de red e inténtalo de nuevo.";
/* Error of 'ojd update check' when the check fails for a reason other than the network. %@ is the reason. */
"cli.update.check.failedReason" = "No se pudo buscar actualizaciones: %@.";
/* Value shown in the structured output of 'ojd update check' when the check did not produce a result. */
"cli.update.check.incomplete" = "sin resultado";
/* Help text of the --prerelease flag of 'ojd update check'. A pre-release version is a test version before a stable release. */
"cli.update.check.prerelease" = "Incluye versiones preliminares.";
/* Message printed by 'ojd update check' when the installed version is the latest. %1$@ is the installed version and %2$@ is the latest release. */
"cli.update.check.upToDate" = "OpenJoystickDriver %1$@ está actualizado (última versión: %2$@).";
"ui.settings.commandLine.tool" = "Herramienta de línea de comandos";
"ui.settings.commandLine.toolBlocked" = "%@ es un archivo, no un enlace. Elimínalo y vuelve a instalar.";
"ui.settings.commandLine.toolCancelled" = "Cancelado.";
/* Error shown in the Command Line Tool section of the settings window when macOS refuses to install or remove the tool. */
"platform.macos.ui.settings.commandLine.toolFailed" = "macOS no permitió el cambio.";
"ui.settings.commandLine.toolInstall" = "Instalar herramienta de línea de comandos";
/* Status in the Command Line Tool section of the settings window when ojd is installed. %@ is the path of the link. Terminal is the macOS app and ojd is the command name. */
"platform.macos.ui.settings.commandLine.toolInstalled" = "Instalada. Ejecuta ojd en Terminal; al desinstalar se elimina %@.";
"ui.settings.commandLine.toolLinkedElsewhere" = "%1$@ apunta a %2$@. Al instalar, se enlaza con esta app.";
/* Description in the Command Line Tool section of the settings window before the tool is installed. %@ is the path where the link is created. Terminal is the macOS app and ojd is the command name. */
"platform.macos.ui.settings.commandLine.toolNotInstalled" = "Enlaza %@ con esta app para que puedas ejecutar ojd en Terminal. macOS pide una contraseña de administrador.";
"ui.settings.commandLine.toolUninstall" = "Desinstalar";
/* One-line summary of 'ojd controller' in the command list and at the top of its help. */
"cli.controller.group.abstract" = "Listar, inspeccionar, probar y controlar los mandos conectados.";
/* Help text of the CONTROLLER argument shared by the 'ojd controller' commands. VVVV:PPPP is the vendor ID and product ID in hexadecimal and stays as written. */
"cli.controller.group.argument" = "El mando: un ID de «ojd controller list», o VVVV:PPPP.";
/* One-line summary of 'ojd controller capture' in the command list and at the top of its help. */
"cli.controller.capture.abstract" = "Mostrar los paquetes sin procesar que envía y recibe un mando.";
/* Long description in the help of 'ojd controller capture'. rx and tx mark received and transmitted packets and stay as written, as does --json. */
"cli.controller.capture.discussion" = "Muestra cada paquete nuevo al llegar: hora, dirección (rx o tx), longitud y bytes en hexadecimal. Con --json, muestra un objeto JSON por línea.";
/* Message printed by 'ojd controller capture' when the capture ends without a packet. */
"cli.controller.capture.noPackets" = "No se han recibido paquetes.";
/* First line of 'ojd controller capture'. %1$@ is the controller name and %2$@ is its vendor and product ID. */
"cli.controller.capture.started" = "Capturando paquetes de %1$@ (%2$@). Pulsa botones del mando.";
/* Warning printed by 'ojd controller capture' before the packets. Packets can hold data of the user's controller. */
"cli.controller.capture.warning" = "El contenido de los paquetes varía según el mando. Revísalo antes de compartirlo.";
/* One-line summary of 'ojd controller disconnect' in the command list and at the top of its help. */
"cli.controller.disconnect.abstract" = "Desconectar un mando Bluetooth clásico.";
/* Long description in the help of 'ojd controller disconnect'. It explains that classic Bluetooth controllers stay paired and that the wait is at least 6 seconds. */
"platform.macos.cli.controller.disconnect.discussion" = "Cierra la conexión Bluetooth clásica. El mando sigue emparejado y se vuelve a conectar cuando lo enciendes de nuevo. Espera al menos 6 segundos a que Bluetooth lo confirme. El servicio no puede desconectar un mando Bluetooth Low Energy. Apágalo o desconéctalo en Ajustes del Sistema > Bluetooth.";
/* Message printed after 'ojd controller disconnect' disconnected the controller. %@ is the controller name. */
"cli.controller.disconnect.done" = "%@ desconectado.";
/* Error of 'ojd controller disconnect' for a Bluetooth Low Energy controller. %@ is the controller name. System Settings and Bluetooth are macOS names. */
"platform.macos.cli.controller.disconnect.bluetoothLe" = "%@ está conectado mediante Bluetooth Low Energy y el servicio no puede desconectarlo. Apaga el mando o desconéctalo en Ajustes del Sistema > Bluetooth.";
/* Error of 'ojd controller disconnect' when the Bluetooth disconnect fails. %1$@ names the step that failed and %2$@ is the system's reason, which can end with an error code. */
"cli.controller.disconnect.failed" = "Error al desconectar por Bluetooth durante %1$@: %2$@.";
/* Error of 'ojd controller disconnect' for a controller on a wire. %@ is the controller name. */
"cli.controller.disconnect.notBluetooth" = "%@ no está conectado por Bluetooth. Desenchúfalo para desconectarlo.";
/* Long description in the help of 'ojd controller'. CONTROLLER, the command in quotes and VVVV:PPPP stay as written. */
"cli.controller.group.discussion" = "CONTROLLER es un ID de «ojd controller list», o VVVV:PPPP (ID hexadecimal de fabricante y de producto) cuando solo un mando conectado lo tiene. Todos los comandos de mando necesitan el servicio.";
/* Second paragraph of the help of 'ojd controller'. It explains the unit ID, which starts with U- and stays as written. */
"cli.controller.group.discussionUnit" = "Un ID de unidad (U-...) identifica un mando por su modelo y el puerto USB que usa. Sigue siendo el mismo tras los reinicios mientras el mando use ese puerto.";
/* Error of 'ojd controller' commands when --duration is not a number above 0. --duration stays as written. */
"cli.controller.group.errorDuration" = "--duration necesita un número de segundos mayor que 0.";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureBrightness" = "brillo de luz ajustable";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureColor" = "color de luz programable";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featurePlayer" = "luces indicadoras de jugador";
/* Noun phrase for a controller capability. It is inserted after 'has no' in the message that a controller lacks a feature, so it must fit there. */
"cli.controller.group.featureRumble" = "motor de vibración";
/* One-line summary of 'ojd controller light' in the command list and at the top of its help. */
"cli.controller.light.abstract" = "Establecer el color o el brillo de la luz de un mando.";
/* Help text of the --brightness option of 'ojd controller light'. LED means light-emitting diode. */
"cli.controller.light.brightness" = "Brillo del LED.";
/* Help text of the --color option of 'ojd controller light'. The value is a hexadecimal RGB color; FF8000 stays as written. */
"cli.controller.light.color" = "Color de la barra de luz en hexadecimal, como FF8000.";
/* Error of 'ojd controller light' when no option is given. --color and --brightness stay as written. */
"cli.controller.light.errorMissing" = "Indica --color, --brightness o ambos.";
/* One-line summary of 'ojd controller list' in the command list and at the top of its help. */
"cli.controller.list.abstract" = "Listar los mandos conectados.";
/* Message printed by 'ojd controller list' when no controller is connected. */
"cli.controller.list.empty" = "No hay ningún mando conectado.";
/* Marker appended to the line of a suspended controller in 'ojd controller list'. Keep the parentheses. */
"cli.controller.list.suspended" = "(suspendido)";
/* Help text of the --duration option of 'ojd controller watch' and 'ojd controller capture'. Control-C is the key combination that stops a program in a terminal. */
"cli.controller.group.optionDuration" = "Se detiene tras este número de segundos. Si no se indica, funciona hasta que pulses Control-C.";
/* Error of the controller output commands when the controller rejects a command. %1$@ is the controller name, %2$@ is the command name and %3$@ is the outcome in kebab case, which stays as written. The command in quotes stays as written. */
"cli.controller.group.outputFailed" = "%1$@ no ha aceptado el comando %2$@ (%3$@). Compruébalo con «ojd log show».";
/* Error of the controller output commands when the controller disconnects before the command is sent. %@ is the controller name. */
"cli.controller.group.outputGone" = "%@ se desconectó antes de enviar el comando. Vuelve a conectarlo e inténtalo de nuevo.";
/* Error of the controller output commands when the controller cannot take output yet. %@ is the controller name. */
"cli.controller.group.outputNotReady" = "%@ aún no está listo para la salida. Inténtalo de nuevo en un momento.";
/* Message printed after the controller output commands succeeded. %1$@ is the comma-separated list of commands sent and %2$@ is the controller name. */
"cli.controller.group.outputSent" = "%1$@ enviado a %2$@.";
/* Error of the controller output commands when the controller lacks the feature. %1$@ is the controller name, %2$@ is the missing feature as a noun phrase and %3$@ is the session token for 'ojd controller show'. */
"cli.controller.group.outputUnsupported" = "%1$@ no tiene %2$@. Ejecuta «ojd controller show %3$@» para ver qué admite.";
/* One-line summary of 'ojd controller claim' in the command list and at the top of its help. OpenJoystickDriver is the product name. To serve a model means to read its input and publish it as a virtual gamepad. */
"cli.controller.claim.abstract" = "Haz que OpenJoystickDriver gestione un modelo de mando.";
/* Long description in the help of 'ojd controller claim'. server, ojd, VVVV-PPPP.json and the record terms stay as written. */
"platform.macos.cli.controller.claim.discussion" = "Establece server en ojd en tu registro del modelo, VVVV-PPPP.json en tu directorio de registros, y conserva los demás campos del registro. Se aplica a todos los mandos del modelo. El servicio en ejecución lo aplica sin volver a conectar. Necesita el servicio para encontrar el mando. --dry-run no escribe nada. Termina con 1 y E2023 para un mando que usa USB sin procesar, que OpenJoystickDriver gestiona siempre, o que macOS no gestiona de forma nativa.";
/* One-line summary of 'ojd controller release' in the command list and at the top of its help. */
"platform.macos.cli.controller.release.abstract" = "Devuelve un modelo de mando a macOS.";
/* Long description in the help of 'ojd controller release'. server, system and VVVV-PPPP.json stay as written. */
"platform.macos.cli.controller.release.discussion" = "Establece server en system en tu registro del modelo, VVVV-PPPP.json en tu directorio de registros, y conserva los demás campos del registro. Se aplica a todos los mandos del modelo. El servicio en ejecución lo aplica sin volver a conectar. Necesita el servicio para encontrar el mando. --dry-run no escribe nada. Termina con 1 y E2023 para un mando que usa USB sin procesar, que OpenJoystickDriver gestiona siempre, o que macOS no gestiona de forma nativa.";
/* Message printed by 'ojd controller claim' and related commands with --dry-run instead of writing the record. %1$@ is the controller identity, %2$@ is the server name in kebab case and %3$@ is the record file. */
"cli.controller.group.serverDryRun" = "Establecería %1$@ en %2$@ en %3$@.";
/* Error when the record file of a controller cannot be changed. %1$@ is the path of the record file and %2$@ is the description of the problem. */
"cli.controller.group.serverInvalid" = "No se puede cambiar %1$@: %2$@";
/* Error when a controller has no record to change. %1$@ is the controller identity and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.controller.group.serverNoRecord" = "%1$@ no tiene un registro de mando que cambiar. Crea uno con «ojd record draft %2$@».";
/* Message when a controller cannot be released to macOS because macOS does not serve it natively. %@ is the controller identity. OpenJoystickDriver is the product name. */
"platform.macos.cli.controller.group.serverNotNative" = "macOS no gestiona %@ de forma nativa, así que OpenJoystickDriver siempre lo gestiona.";
/* Message when the server of a controller cannot be changed because it uses raw USB. %@ is the controller identity. OpenJoystickDriver is the product name. */
"cli.controller.group.serverRawUsb" = "%@ usa USB sin procesar, así que OpenJoystickDriver siempre lo gestiona.";
/* Message printed after the server of a controller is changed. %1$@ is the controller identity, %2$@ is the server name in kebab case and %3$@ is the record file. The service picks the change up without a restart. */
"cli.controller.group.serverSuccess" = "%1$@ se ha establecido en %2$@ en %3$@. El servicio en ejecución lo aplica ahora.";
/* One-line summary of 'ojd controller player' in the command list and at the top of its help. */
"cli.controller.player.abstract" = "Establecer las luces indicadoras de jugador de un mando.";
/* Help text of the PLAYER argument of 'ojd controller player'. off is a value the user types and stays as written. */
"cli.controller.player.number" = "El número de jugador, del 1 al 4, o off.";
/* One-line summary of 'ojd controller resume' in the command list and at the top of its help. */
"cli.controller.resume.abstract" = "Permitir que OpenJoystickDriver vuelva a controlar un mando suspendido.";
/* Message of 'ojd controller resume' when the controller is not suspended. %@ is the controller name. */
"cli.controller.resume.already" = "%@ ya está activo.";
/* Message printed after 'ojd controller resume'. %@ is the controller name. */
"cli.controller.resume.done" = "%@ reanudado.";
/* One-line summary of 'ojd controller rumble' in the command list and at the top of its help. */
"cli.controller.rumble.abstract" = "Activar los motores de vibración de un mando.";
