/* Detail of the records check of 'ojd diagnose'. %lld is the number of the user's controller records that the driver applies. */
"cli.diagnose.group.recordsApplied" = "registros de usuario aplicados: %lld";
/* Detail of the records check of 'ojd diagnose' when the configuration files are valid. all.patch.json is a file name that stays as written. */
"cli.diagnose.group.recordsConfigOk" = "all.patch.json y los archivos de persona son válidos";
/* Detail of the records check of 'ojd diagnose' when parts of the configuration are ignored or skipped. %@ is the list of those parts. The command in quotes stays as written. */
"cli.diagnose.group.recordsConfigProblems" = "ignorados u omitidos: %@; corrígelos y compruébalo con «ojd status»";
/* Detail of the records check of 'ojd diagnose' when records are skipped. %@ is the list of skipped records. The command in quotes stays as written. */
"cli.diagnose.group.recordsSkipped" = "omitidos: %@; revísalos con «ojd record list»";
/* One line of the frame timings of 'ojd diagnose'. %1$lld is the frame number, %2$@ is the controller name, %3$@ is the controller ID and %4$@ is the timestamp of the frame from the monotonic clock in nanoseconds. */
"cli.diagnose.group.timingsFrame" = "Fotograma %1$lld de %2$@ (%3$@), reloj monótono en nanosegundos: %4$@";
/* One-line summary of 'ojd record' in the command list and at the top of its help. */
"cli.record.group.abstract" = "Redacta, lista, comprueba, instala o elimina registros de mando.";
/* Long description in the help of 'ojd record'. The folder path stays as written. A controller record describes how the driver talks to one controller model. */
"cli.record.group.discussion" = "Un registro de mando indica a OpenJoystickDriver cómo manejar un modelo de mando. Tus registros están en ~/Library/Application Support/OpenJoystickDriver/Controllers y añaden un modelo o modifican uno incluido. El servicio en ejecución los aplica cuando cambia el directorio. Solo «ojd record draft» necesita el servicio.";
/* One-line summary of 'ojd record draft' in the command list and at the top of its help. */
"cli.record.draft.abstract" = "Redacta un registro de mando a partir de un mando conectado.";
/* Line printed by 'ojd record draft' with the number of input reports it captured. %lld is that number. */
"cli.record.draft.captured" = "Informes de entrada capturados: %lld.";
/* Line printed by 'ojd record draft' for a byte that changed between reports. %1$lld is the byte position, %2$lld is the value before and %3$lld is the value after. */
"cli.record.draft.changedByte" = "El byte %1$lld cambió: %2$lld a %3$lld.";
/* Long description in the help of 'ojd record draft'. HID report descriptor and input report are terms of the USB HID standard. */
"cli.record.draft.discussion" = "Lee el descriptor de informes HID del mando y captura sus informes de entrada mientras pulsas cada control, y después imprime un registro desde el que empezar. El registro asigna los botones, los sticks, los gatillos y la cruceta que el descriptor indica con claridad. Los bytes que cambiaron durante la captura muestran dónde están los demás controles. Necesita el servicio.";
/* Help text of the duration option of 'ojd record draft'. */
"cli.record.draft.duration" = "Captura informes de entrada durante esta cantidad de segundos.";
/* Hint printed after 'ojd record draft'. The command in quotes stays as written, including FILE. */
"cli.record.draft.next" = "Guarda el registro en un archivo, comprueba cada control y luego ejecuta «ojd record validate FILE».";
/* Message of 'ojd record draft' when the descriptor of the controller yields no controls and the bundled record names the family. %1$@ is the controller identity, VVVV:PPPP, and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.record.draft.noLayout" = "No se pudo leer ningún control de %1$@ a partir de su descriptor de informes HID, y su registro incluido ya indica su familia. «ojd record show %2$@» muestra ese registro.";
/* Prompt of 'ojd record draft' while it captures reports. %1$@ is the controller name and %2$@ is its vendor and product ID. */
"cli.record.draft.started" = "Pulsa cada control de %1$@ (%2$@) y mueve cada palanca y cada gatillo.";
/* Error of the 'ojd record' commands when a record file cannot be read. %1$@ is the file path and %2$@ is the reason from the system. */
"cli.record.group.errorUnreadable" = "No se puede leer %1$@: %2$@";
/* Help text of the file argument of the 'ojd record' commands. The single hyphen means stdin and stays as written. */
"cli.record.group.file" = "Un archivo de registro, o - para leer el registro desde la entrada estándar.";
/* Help text of the controller model argument of the 'ojd record' commands. VVVV:PPPP is the vendor ID and product ID in hexadecimal and stays as written. */
"cli.record.group.identity" = "El modelo de mando, como VVVV:PPPP.";
/* One-line summary of 'ojd record install' in the command list and at the top of its help. */
"cli.record.install.abstract" = "Comprueba un registro de mando y lo instala para tu usuario.";
/* Yes or no question that 'ojd record install' asks on a terminal before it replaces an installed record. %@ is the path of the installed file. */
"cli.record.install.confirm" = "¿Reemplazar %@?";
/* Long description in the help of 'ojd record install'. VVVV-PPPP.json and --force stay as written. */
"cli.record.install.discussion" = "Escribe el registro como VVVV-PPPP.json en tu directorio de registros. El servicio en ejecución lo aplica al instante. Reemplazar el registro ya instalado para ese modelo pide confirmación en una terminal; en otro caso necesita --force. --dry-run comprueba el registro y no escribe nada. Termina con 1 y no escribe nada cuando el registro no es válido.";
/* Message printed by 'ojd record install --dry-run' instead of installing. %@ is the target file path. */
"cli.record.install.dryRun" = "Instalaría %@.";
/* Error when the record file cannot be written. %1$@ is the target file path and %2$@ is the reason from the system. */
"cli.record.install.failed" = "No se puede escribir %1$@: %2$@";
/* Message printed after 'ojd record install'. %@ is the target file path. The service picks the record up without a restart. */
"cli.record.install.success" = "Instalación de %@ completada. El servicio en ejecución lo aplica ahora.";
/* Error of the 'ojd record' commands when a record is invalid. %1$@ is the file path or the word stdin and %2$@ is the description of the problem. */
"cli.record.group.invalid" = "%1$@ no es un registro válido: %2$@";
/* One-line summary of 'ojd record list' in the command list and at the top of its help. */
"cli.record.list.abstract" = "Lista cada registro de mando y la capa de la que proviene.";
/* Help text of the flag of 'ojd record list' that limits the list to the bundled catalog. The bundled catalog is the set of records inside the app. */
"cli.record.list.bundled" = "Lista solo el catálogo incluido.";
/* Long description in the help of 'ojd record list'. OJD is the short product name. */
"cli.record.list.discussion" = "Lista los registros incluidos con tus registros aplicados, e indica cada archivo que OJD omitió y por qué.";
/* One-line summary of 'ojd record remove' in the command list and at the top of its help. */
"cli.record.remove.abstract" = "Elimina tu registro para un modelo de mando.";
/* Yes or no question that 'ojd record remove' asks on a terminal. %@ is the list of files to delete. */
"cli.record.remove.confirm" = "¿Eliminar %@?";
/* Long description in the help of 'ojd record remove'. --force stays as written. */
"cli.record.remove.discussion" = "Un modelo incluido vuelve a su registro incluido. Pide confirmación en una terminal; en otro caso necesita --force.";
/* Message printed by 'ojd record remove --dry-run' instead of deleting. %@ is the list of files. */
"cli.record.remove.dryRun" = "Eliminaría %@.";
/* Error of 'ojd record remove' when a file cannot be deleted. %1$@ is the file path and %2$@ is the reason from the system. */
"cli.record.remove.failed" = "No se puede eliminar %1$@: %2$@";
/* Error of 'ojd record remove' when the user has no record for the model. %@ is the model, VVVV:PPPP. The command in quotes stays as written. */
"cli.record.remove.notFound" = "No tienes ningún registro para %@. «ojd record list» muestra tus registros.";
/* Message printed after 'ojd record remove'. %@ is the list of deleted files. */
"cli.record.remove.success" = "Eliminación de %@ completada.";
/* One-line summary of 'ojd record show' in the command list and at the top of its help. */
"cli.record.show.abstract" = "Muestra el registro efectivo de un modelo de mando y la capa de cada parte.";
/* Error of 'ojd record show' and 'ojd config show' when no record matches the model. %@ is the model, VVVV:PPPP. The command in quotes stays as written. */
"cli.record.show.notFound" = "No hay registro de mando para %@. «ojd record list» muestra todos los registros.";
/* Line of the output of 'ojd record list' for a record file the driver skipped. %1$@ is the file name and %2$@ is the reason. */
"cli.record.group.skipped" = "Omitido %1$@: %2$@";
/* One-line summary of 'ojd record test' in the command list and at the top of its help. A parser turns the packets of a controller into its state. */
"cli.record.test.abstract" = "Reproducir informes capturados con el analizador de un registro y comparar el estado analizado.";
/* Error of 'ojd record test' when the capture file is not a packet capture. %1$@ is the file path and %2$@ is the line number and the problem found on that line. */
"cli.record.test.captureInvalid" = "%1$@ no es una captura de paquetes: %2$@";
/* Line of the output of 'ojd record test' for each field of the controller state that differs. %1$@ is the field name, %2$@ is the expected value and %3$@ is the value found. */
"cli.record.test.difference" = "%1$@: se esperaba %2$@, se obtuvo %3$@";
/* Long description in the help of 'ojd record test'. The command in quotes and the JSON terms stay as written. */
"cli.record.test.discussion" = "Reproduce los paquetes recibidos de una captura con el analizador del registro y compara el estado del mando tras el último informe de entrada con el estado esperado. La captura son las líneas JSON de «ojd controller capture --json». El estado esperado es un objeto JSON con la forma de una línea de «ojd controller watch --json». El comando enumera cada campo que difiere y termina con el código 1 si alguno difiere. Compara todos los campos salvo connection, que establece el servicio en ejecución. No necesita un servicio en ejecución.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "El estado esperado del mando, como archivo JSON.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ no es un estado de mando: %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "Ningún informe de %1$@ contenía entrada para %2$@. Captura de nuevo mientras pulsas los controles.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "La familia de %@ no tiene un analizador que funcione sin un mando.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "Una captura de paquetes, como las líneas JSON de «ojd controller capture --json».";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "El analizador de %1$@ rechazó el paquete recibido %2$lld de %3$@.";
/* Text of error E2022, printed when the controller state that a record parser produces from a capture differs from the expected state. */
"error.E2022.message" = "El estado que el analizador del registro produjo a partir de los informes capturados difiere del estado esperado. Lee los campos que enumera el comando.";
/* Text of error E2023, printed when a controller cannot be claimed or released because its protocol family uses raw USB or the system does not serve it natively. The settings window shows it too. */
"error.E2023.message" = "Este mando no se puede reclamar ni devolver: su familia de protocolo usa USB sin procesar, o el sistema no lo admite de forma nativa. El mensaje indica el motivo.";
/* Text of error E2024, printed when no endpoint client or token has the given ID. ojd access is the command that lists the IDs and stays as written. */
"error.E2024.message" = "Ningún cliente ni token del endpoint tiene este ID. Ejecuta ojd access para ver los ID y usa uno de ellos.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "No se puede conceder acceso a un cliente con este tipo de firma, porque cualquier programa local puede reclamar su firma.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Elige al menos un ámbito que conceder.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "El servicio se está deteniendo. Inícialo y vuelve a intentarlo.";
/* Text of error E2028, printed when a token with the chosen name exists. */
"error.E2028.message" = "Ya existe un token con este nombre. Revócalo primero o elige otro nombre.";
/* Text of error E2029, printed when a token name has characters that are not allowed. The limit of 64 characters is fixed. */
"error.E2029.message" = "Esto no es un nombre de token. Usa de 1 a 64 letras, dígitos, puntos, guiones o guiones bajos.";
/* Text of error E2030, printed when a web origin is not valid. scheme://host[:port], http, https and the example in backticks stay as written. */
"error.E2030.message" = "Esto no es un origen web. Usa scheme://host[:port] con http o https, por ejemplo `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Este puerto en 127.0.0.1 está en uso o no se puede abrir. Elige otro con --port.";
/* Text of error E2032, printed when the control scope is granted to a token that has origins. */
"error.E2032.message" = "Un token con orígenes no puede tener el ámbito control, porque una página nunca debe manejar un mando virtual. Concede control a un token sin orígenes.";
/* Text of error E2033, printed when 'ojd virtual launch' cannot start the program. */
"error.E2033.message" = "No se pudo iniciar el programa. Comprueba que su ruta indique un archivo ejecutable o una app y que tengas permiso para ejecutarlo.";
/* Error E2034, shown in the app or the CLI when the service no longer accepts requests. */
"error.E2034.message" = "El servicio ha dejado de aceptar solicitudes. Cierra OpenJoystickDriver, ábrelo de nuevo y vuelve a intentarlo.";
/* Error E2035, shown in the app or the CLI when the file that records why the request listener stopped is unusable. */
"error.E2035.message" = "No se puede usar el archivo que registra por qué se detuvo la escucha de solicitudes. Elimina el archivo y abre OpenJoystickDriver de nuevo.";
/* Error E2036, shown by ojd and the app when no OpenJoystickDriver app took the test notification or reported on it before the deadline. */
"error.E2036.message" = "Ninguna app de OpenJoystickDriver respondió a tiempo a la notificación de prueba. Comprueba que la app esté en ejecución y vuelve a intentarlo.";
/* Error E2037, shown by ojd and the app when notifications are not allowed for the app, so the test notification could not be shown. */
"error.E2037.message" = "Las notificaciones no están permitidas para OpenJoystickDriver. Permítelas en los ajustes de notificaciones del sistema y vuelve a intentarlo.";
/* Note about a controller record whose raw USB family the USB extension cannot claim because Apple signs its product list. OJD is the short product name. */
"platform.macos.cli.record.group.usbNotClaimed" = "La familia usa USB sin procesar, y la extensión USB no puede reclamar este mando, porque su lista de productos está firmada por Apple. OJD solo llega a él mediante acceso USB directo, cuando macOS lo permite.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "Solo USB: añade bluetoothLE.vibrationCharacteristic a este registro de Switch 2 para conectar el mando por Bluetooth LE.";
/* One-line summary of 'ojd record validate' in the command list and at the top of its help. */
"cli.record.validate.abstract" = "Comprueba un registro de mando sin instalarlo.";
/* Long description in the help of 'ojd record validate'. */
"cli.record.validate.discussion" = "Comprueba la forma del registro, sus campos entre sí y su encaje con el catálogo incluido, e indica si el mando necesita la extensión USB. Termina con 1 cuando el registro no es válido.";
/* Message printed by 'ojd record validate' for a correct record. %1$@ is the file path, %2$@ is the operation in kebab case such as install, %3$@ is the controller model and %4$@ is the protocol family. The command in quotes stays as written. */
"cli.record.validate.valid" = "%1$@ es un registro %2$@ válido para %3$@ (%4$@). Instálalo con «ojd record install».";
/* Heading in the output of 'ojd status' above the defaults file that the driver ignores. */
"cli.status.group.labelIgnoredDefaults" = "Archivo de valores predeterminados ignorado";
/* Heading in the output of 'ojd status' above the list of skipped persona files. %lld is the number of files. */
"cli.status.group.labelSkippedPersonas" = "Archivos de persona omitidos (%lld)";
/* Heading in the output of 'ojd status' above the list of skipped controller records. %lld is the number of records. */
"cli.status.group.labelSkippedRecords" = "Registros de mando omitidos (%lld)";
/* One-line summary of 'ojd binding' in the command list and at the top of its help. */
"cli.binding.group.abstract" = "Lista, define y borra las asignaciones de un perfil de reasignación.";
/* Error of 'ojd binding set' when the JSON of --actions-json cannot be read. %@ is the description of the parse problem. --actions-json stays as written. */
"cli.binding.group.actionsInvalid" = "--actions-json no es una lista de acciones válida: %@";
/* Error of 'ojd binding set' when the JSON of --actions-json exceeds the size limit. --actions-json stays as written. */
"cli.binding.group.actionsTooLarge" = "--actions-json es demasiado grande.";
/* Error of 'ojd binding set' when the value of --double-tap or --long-hold does not have the form MS:TARGET. %@ is the option name. MS:TARGET and the example stay as written. */
"cli.binding.group.alternateFormat" = "%@ acepta MS:TARGET, como 500:key:key-b.";
/* Error of 'ojd binding set' when an axis option is used with a source that is not an axis. The option names stay as written. */
"cli.binding.group.axisOptionsSource" = "--deadzone, --gain, --invert, --response-curve y --digital-threshold necesitan un origen de eje.";
/* One-line summary of 'ojd binding clear' in the command list and at the top of its help. */
"cli.binding.clear.abstract" = "Elimina las asignaciones de los orígenes indicados, o todas.";
/* Help text of the --all flag of 'ojd binding clear'. */
"cli.binding.clear.all" = "Elimina todas las asignaciones, combinaciones, secuencias y capas.";
/* Warning of 'ojd binding clear' when removing the bindings leaves an active profile without any binding, so its controller sends no input. %@ is the profile name. The two commands in quotes stay as written. */
"cli.binding.clear.blocksInput" = "«%@» está activo en un mando conectado y ahora bloquea toda su entrada. Añade una asignación con «ojd binding set» o detén el perfil con «ojd profile deactivate».";
/* Yes or no question that 'ojd binding clear --all' asks on a terminal. %@ is the profile name. */
"cli.binding.clear.confirm" = "¿Eliminar todas las asignaciones, combinaciones, secuencias y capas de «%@»?";
/* Long description in the help of 'ojd binding clear'. --all and --force stay as written. */
"cli.binding.clear.discussion" = "--all también elimina las combinaciones, secuencias y capas del perfil, y pide confirmación en un terminal; sin terminal necesita --force. Se mantienen los ajustes de palancas, gatillos, táctil, movimiento y salida.";
/* Message printed after 'ojd binding clear' removed bindings. %1$@ is the profile name and %2$lld is the number of removed bindings, shown after a colon. */
"cli.binding.clear.done" = "Asignaciones eliminadas de «%1$@»: %2$lld.";
