"cli.binding.clear.dryRun" = "Asignaciones que se eliminarían de «%1$@»: %2$lld.";
/* Message of 'ojd binding clear' when a source has no binding. %1$@ is the profile name and %2$@ is the source the user gave. */
"cli.binding.clear.missing" = "«%1$@» no tiene ninguna asignación para %2$@. No se ha cambiado nada.";
/* Help text of the SOURCES argument of 'ojd binding clear'. */
"cli.binding.clear.sources" = "Los orígenes cuyas asignaciones se eliminan.";
/* Error of 'ojd binding clear' when neither sources nor --all are given. --all stays as written. */
"cli.binding.clear.usage" = "Indica uno o más orígenes, o --all.";
/* Long description in the help of 'ojd binding'. It lists the SOURCE and TARGET forms. Words in capitals, forms such as button:NAME and all option names stay as written. */
"cli.binding.group.discussion" = "Una asignación envía un TARGET cuando se usa un SOURCE del mando.\n\nSOURCE: button:NAME, dpad:DIRECTION, axis:NAME[:negative|positive], trigger:NAME:STAGE, motion:lean:DIRECTION, touch:SURFACE:contact, touch:SURFACE:grid:COLUMNS:ROWS:COLUMN:ROW o touch:SURFACE:swipe:DIRECTION:DISTANCE.\n\nTARGET: key:KEY[:mods=meta,control,alt,shift], mouse:BUTTON, move:x|y, scroll:x|y, gamepad:button:NAME, gamepad:dpad:DIRECTION, gamepad:axis:NAME o physical:... para vibración, luces y gatillos adaptativos.\n\n«ojd profile show» imprime las asignaciones con estas formas. Edita combinaciones, secuencias y capas con «ojd profile edit».";
/* One-line summary of 'ojd binding list' in the command list and at the top of its help. */
"cli.binding.list.abstract" = "Lista las asignaciones de un perfil.";
/* Message of 'ojd binding list' when the profile has no bindings. %@ is the profile name. The command in quotes stays as written. */
"cli.binding.list.empty" = "«%@» no tiene asignaciones. Añade una con «ojd binding set».";
/* Help text of the --actions-json option of 'ojd binding set'. 'ojd profile export' stays as written. */
"cli.binding.group.optionActionsJson" = "Acciones adicionales como matriz JSON, con la forma que escribe «ojd profile export».";
/* Help text of the --behavior option of 'ojd binding set'. The behavior hold is a value the user types. */
"cli.binding.group.optionBehavior" = "Cuándo se activa el destino. Predeterminado: el comportamiento de la asignación actual, o hold.";
/* Help text of the --deadzone option of 'ojd binding set'. The dead zone is the part of an axis travel that is ignored. */
"cli.binding.group.optionDeadzone" = "Orígenes de eje: la parte del recorrido que se ignora, de 0 a 0.95. Predeterminado: 0.1.";
/* Help text of the --digital-threshold option of 'ojd binding set'. It sets the axis travel that counts as a press. */
"cli.binding.group.optionDigitalThreshold" = "Orígenes de eje: el recorrido que cuenta como pulsación para destinos de botón. Predeterminado: 0.5.";
/* Help text of the --double-tap option of 'ojd binding set'. The example 300:key:key-c stays as written. */
"cli.binding.group.optionDoubleTap" = "Envía otro destino cuando el origen se pulsa dos veces dentro de este tiempo, como 300:key:key-c.";
/* Help text of the --gain option of 'ojd binding set'. Gain scales the axis output. */
"cli.binding.group.optionGain" = "Orígenes de eje: la escala de salida, de 0.1 a 10. Predeterminado: 1.";
/* Help text of the --invert flag of 'ojd binding set'. */
"cli.binding.group.optionInvert" = "Orígenes de eje: invierte la dirección.";
/* Help text of the --long-hold option of 'ojd binding set'. The example 500:key:key-b stays as written. */
"cli.binding.group.optionLongHold" = "Envía otro destino cuando el origen se mantiene pulsado este tiempo, como 500:key:key-b.";
/* Help text of the --pulse-ms option of 'ojd binding set'. ms means milliseconds. */
"cli.binding.group.optionPulseMs" = "Cuánto tiempo mantiene el destino un pulso, de 1 a 5000 ms. Predeterminado: 100.";
/* Help text of the --response-curve option of 'ojd binding set'. linear is a value the user types. */
"cli.binding.group.optionResponseCurve" = "Orígenes de eje: cómo crece la salida con el recorrido. Predeterminado: linear.";
/* Help text of the --turbo-duty option of 'ojd binding set'. The duty is the share of each turbo cycle in which the target is held. */
"cli.binding.group.optionTurboDuty" = "La parte de cada ciclo turbo en que se mantiene el destino, mayor que 0 y menor que 1.";
/* Help text of the --turbo-rate option of 'ojd binding set'. --turbo-duty stays as written. */
"cli.binding.group.optionTurboRate" = "Repite el destino estas veces por segundo mientras se mantiene pulsado. Necesita --turbo-duty.";
/* One-line summary of 'ojd binding set' in the command list and at the top of its help. */
"cli.binding.set.abstract" = "Asigna un origen del mando a un destino, sustituyendo la asignación actual del origen.";
/* Message printed after 'ojd binding set' stored a binding. %1$@ is the profile name and %2$@ describes the source bound to the target. */
"cli.binding.set.done" = "«%1$@» ahora asigna %2$@.";
