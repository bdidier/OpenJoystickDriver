/* One-line summary of 'ojd explain' in the command list and at the top of its help. */
"cli.explain.group.abstract" = "Explica un código de error: qué significa y cómo solucionarlo.";
/* Long description in the help of 'ojd explain'. ojd explain stays as written. The code case does not matter, so E2004 and e2004 are the same. */
"cli.explain.group.discussion" = "ojd explain cubre todos los códigos de error. Funciona sin conexión y no importa si el código va en mayúsculas o minúsculas.";
/* Help text of the CODE argument of 'ojd explain'. E2004 is an example of an error code and stays as written. */
"cli.explain.group.code" = "El código de error, por ejemplo E2004.";
/* Error of 'ojd explain' when the code does not exist. %@ is the text the user gave. Error-Codes is the name of a wiki page and stays as written. */
"cli.explain.group.unknown" = "%@ no es un código de error activo. Revisa la ortografía; la página Error-Codes de la wiki muestra todos los códigos.";
/* Line of the output of 'ojd explain' that names the area of the error. %@ is the area name, one of the area labels. */
"cli.explain.group.area" = "Área: %@";
/* Area label in the output of 'ojd explain' for errors of the endpoint that programs connect to. */
"cli.explain.group.areaEndpoint" = "Punto final";
/* Area label in the output of 'ojd explain' for errors of the command line. */
"cli.explain.group.areaCli" = "Línea de comandos";
/* Area label in the output of 'ojd explain' for errors of button remapping. */
"cli.explain.group.areaRemapping" = "Reasignación";
/* Area label in the output of 'ojd explain' for errors of mod packages, the packages that add controller support. */
"cli.explain.group.areaMod" = "Paquetes de mods";
/* Area label in the output of 'ojd explain' for errors of the documents that the driver reads, such as profiles and records. */
"cli.explain.group.areaDocument" = "Documentos";
/* Line of the output of 'ojd explain' with the exit status that the command ends with for this error. %@ is the number. */
"cli.explain.group.exitCode" ="Código de salida: %@";
/* Line of the output of 'ojd explain' with the wire value of the code, which other programs read. %@ is that value and stays as written. */
"cli.explain.group.wire" = "Valor de transmisión: %@";
/* Error when the installed app is older than the repository sources that built this ojd. The build command, the environment variable OJD_RUN_REPOSITORY_CLI=1 and OpenJoystickDriver.app stay as written. */
"cli.shared.error.staleInstallation" = "La OpenJoystickDriver.app instalada es más antigua que estas fuentes del repositorio. Ejecuta «./Scripts/ojd build install-fast dev» o define OJD_RUN_REPOSITORY_CLI=1 para ejecutar esta compilación.";
/* Error when ojd cannot hand the command line to the installed ojd. ojd stays as written. */
"cli.shared.error.forwarderAllocation" = "No se pudieron reservar los argumentos para el ojd instalado. Vuelve a ejecutar el comando.";
/* Error when ojd cannot start the installed ojd. %@ is the reason from the system. OpenJoystickDriver.app stays as written. */
"cli.shared.error.forwarderExec" = "No se pudo ejecutar el ojd instalado: %@. Vuelve a instalar OpenJoystickDriver.app.";
/* Text of error E2001, printed when ojd meets a failure that has no code of its own. ojd and the command in quotes stay as written. */
"error.E2001.message" = "ojd encontró un error que no reconoce. Ejecuta «ojd diagnose» e informa del problema con su salida.";
/* Text of error E2002, printed when the first word after ojd is not a command. ojd and the command in quotes stay as written. */
"error.E2002.message" = "Eso no es un comando de ojd. Ejecuta «ojd --help» para ver los comandos.";
/* Text of error E2003, printed when the options or values of a command are wrong or missing. --help stays as written. */
"error.E2003.message" = "La línea de comandos tiene una opción o un valor incorrecto o ausente. Ejecuta el comando con --help para ver qué acepta.";
/* Text of error E2004, printed when a command needs the service and it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2004.message" = "El servicio de OpenJoystickDriver no se está ejecutando. Inícialo con «ojd service start».";
/* Text of error E2005, printed when the service does not answer in time. The command in quotes and --timeout stay as written. */
"error.E2005.message" = "El servicio no respondió a tiempo. Compruébalo con «ojd status» o espera más con --timeout.";
/* Text of error E2006, printed when the service reports that it could not complete a request. The command in quotes stays as written. */
"error.E2006.message" = "El servicio no completó la solicitud. Compruébalo con «ojd status» y vuelve a intentarlo.";
/* Text of error E2007, printed when the service refuses this ojd because its code signature differs from the app. ojd and OpenJoystickDriver.app stay as written. */
"error.E2007.message" = "El servicio rechazó este ojd porque no está firmado como la aplicación. Ejecuta el ojd que viene dentro de OpenJoystickDriver.app.";
/* Text of error E2008, printed when a command needs a macOS permission that is missing. The command in quotes stays as written. */
"error.E2008.message" = "Falta un permiso. Concédelo con «ojd permission request».";
/* Text of error E2009, printed when a command that changes or deletes data runs without a terminal and without --force. --force stays as written. */
"error.E2009.message" = "Este comando cambia o elimina datos y necesita confirmación. Vuelve a ejecutarlo con --force.";
/* Text of error E2010, printed when a command stops before it finishes because the user declined, an editor failed or no input came. */
"error.E2010.message" = "El comando se detuvo antes de terminar porque lo rechazaste, falló un editor o no llegó ninguna entrada. Vuelve a ejecutarlo.";
/* Text of error E2011, printed when a profile file or a record file is not valid against its schema. */
"error.E2011.message" = "El archivo de perfil o de registro no es válido. Corrígelo según su esquema y vuelve a intentarlo.";
/* Text of error E2012, printed when a name matches no controller, profile, binding or client, or matches more than one. The word list in quotes is the name of the matching list command and stays as written. */
"error.E2012.message" = "Ningún mando, perfil, asignación o cliente coincide, o coincide más de uno. Enuméralos con el comando «list» correspondiente e indica uno con exactitud.";
/* Text of error E2013, printed when the controller cannot take a requested action. The command in quotes stays as written. */
"error.E2013.message" = "El mando no puede hacer eso ahora. Puede que no sea compatible, que no esté listo o que esté desconectado. Compruébalo con «ojd controller list».";
/* Text of error E2014, printed when the app is not fully installed or its signature is not valid. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2014.message" = "OpenJoystickDriver no está instalado por completo o su firma no es válida. Vuelve a instalar la aplicación y ejecuta «ojd diagnose».";
/* Text of error E2015, printed when macOS does not complete or apply a request of the driver. */
"error.E2015.message" = "El sistema no completó o no aplicó la solicitud. Revisa los ajustes del sistema y vuelve a intentarlo.";
/* Text of error E2016, printed when a file cannot be read, written or deleted, or is present although it must not be. */
"error.E2016.message" = "No se pudo leer, escribir o eliminar un archivo, o ya existe. Revisa la ruta y sus permisos.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Ese cliente no está firmado o tiene una firma ad hoc, así que no se le puede dar acceso. Fírmalo con un Developer ID y vuelve a intentarlo.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "«ojd diagnose» encontró una comprobación fallida. Lee su salida y corrige los elementos fallidos.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "La búsqueda de actualizaciones no terminó. Revisa tu conexión de red y vuelve a intentarlo.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "La aplicación OpenJoystickDriver instalada es más antigua que este ojd. Ejecuta «./Scripts/ojd build install-fast dev» o define OJD_RUN_REPOSITORY_CLI=1 para ejecutar esta compilación.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Una compilación de ojd del repositorio no pudo pasar el comando a la aplicación instalada. Vuelve a instalar OpenJoystickDriver.app y ejecuta el comando de nuevo.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "El mando no está conectado o no está listo para la reasignación. Vuelve a conectarlo e inténtalo de nuevo.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "No se pudieron emparejar los Joy-Con seleccionados. Actualiza los mandos conectados e inténtalo de nuevo.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "El mando no informa datos de movimiento. Elige un mando con sensores de movimiento o deja desactivadas las opciones de movimiento.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Un valor de la solicitud es mayor de lo que acepta el servicio. Envía un valor más pequeño.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "La lista de perfiles activos está dañada y no se pudo cargar. Repara o elimina el archivo dañado y vuelve a intentarlo.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "Ya existe un perfil con ese nombre. Elige otro nombre; «ojd profile list» muestra los nombres en uso.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "La solicitud tiene argumentos ausentes o no válidos. Revisa los valores y vuelve a intentarlo.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "El perfil no es válido. Revisa las asignaciones y vuelve a intentarlo.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "La biblioteca de perfiles sería demasiado grande. Elimina los perfiles que no necesites y vuelve a intentarlo.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "Ya existe un perfil con ese identificador. Usa un identificador nuevo o actualiza el perfil existente.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "El perfil cambió en otro lugar después de cargarlo. Vuelve a cargarlo y haz el cambio de nuevo.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "La biblioteca ya tiene el máximo de perfiles que permite. Elimina un perfil que no necesites y vuelve a intentarlo.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "Ningún perfil tiene ese identificador. Enumera los perfiles con «ojd profile list».";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "El servicio no pudo codificar su respuesta. Vuelve a intentarlo e informa del problema si continúa.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "La respuesta es mayor de lo que el servicio puede enviar. Pide menos datos y vuelve a intentarlo.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "El motor de reasignación no está disponible. Espera un momento y vuelve a intentarlo, o reinicia el servicio.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "La biblioteca de perfiles y el motor de reasignación no están disponibles. Espera un momento y vuelve a intentarlo, o reinicia el servicio.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "La biblioteca de perfiles no está disponible. Espera un momento y vuelve a intentarlo, o reinicia el servicio.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "El enrutador de reasignación se apagó. Reinicia el servicio y vuelve a intentarlo.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "El servicio no pudo confirmar si el último cambio de perfil se guardó. Vuelve a cargar los perfiles y revísalos antes de cambiarlos de nuevo.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "No se pudo leer un archivo de perfil. Comprueba que el archivo existe y que el servicio puede leerlo.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "Hay que reparar o eliminar los archivos de perfil dañados antes de que los perfiles puedan cambiar. Repáralos o elimínalos y vuelve a intentarlo.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "No se pudo escribir un archivo de perfil. Revisa el espacio libre en disco y los permisos de la carpeta.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "El servicio de reasignación encontró un error que no reconoce. Ejecuta «ojd diagnose» e informa del problema con su salida.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "El perfil no genera ninguna salida. Añádele una asignación o un color de luz, o actívalo con --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "El perfil del par de Joy-Con toma el giroscopio del otro Joy-Con. Calibra el movimiento del mando que el perfil selecciona para el giroscopio.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Ningún perfil de reasignación está activo para el mando, así que no procesa movimiento. Activa un perfil para él, trae la app de destino al primer plano e inténtalo de nuevo.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "La sesión de reasignación del mando cambió mientras se ejecutaba la solicitud. Inténtalo de nuevo.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Un perfil de un paquete instalado no se puede modificar. Duplica el perfil y modifica la copia.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.json stays as written. */
"error.E4001.message" = "Falta el manifiesto del paquete mod.json o no es válido. Compruébalo con el esquema mod-package y vuelve a ejecutar el comando.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "El paquete requiere una versión de OpenJoystickDriver distinta de la que se está ejecutando. Instala una versión del paquete compatible con esta versión o actualiza OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.json stays as written. */
"error.E4003.message" = "Un archivo del paquete no es válido, falta o no figura en mod.json. Corrige el archivo que indica el comando y vuelve a ejecutarlo.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "El paquete abarca un mando, una persona o un perfil que ya existen en tus propios archivos o en otro paquete instalado. Elimina el archivo o paquete en conflicto, o modifica el paquete, y vuelve a ejecutar el comando.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Ya hay instalado un paquete con este nombre. Ejecuta el comando con --force para reemplazarlo.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Ningún paquete instalado tiene este nombre. Ejecuta ojd mod list para ver los paquetes instalados.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "No se pudo modificar la carpeta de paquetes. Revisa el espacio libre en disco y los permisos de la carpeta.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Un documento no tiene apiVersion, o su apiVersion no es compatible con esta versión de OpenJoystickDriver. Cambia el documento a la apiVersion compatible que indica el mensaje y vuelve a ejecutar el comando.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Una descripción de protocolo no es válida. Comprueba el archivo con el esquema protocol-description y corrige el campo que nombra el mensaje.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Una descripción de protocolo nombra una familia distinta del nombre de su archivo. Da al archivo el nombre de su familia.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Una descripción de protocolo enumera una variante que su familia no tiene. Usa una de las variantes de la familia.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.json is a file name and stays as written. */
"error.E5005.message" = "El archivo de acceso AccessGrants.json está dañado. Corrige el archivo o elimínalo y concede el acceso de nuevo.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "No se puede leer el archivo de clave de los ID de unidad, PortKeyInstallation.key, o no tiene 32 bytes. Restaura el archivo desde una copia de seguridad. Si lo eliminas, OpenJoystickDriver crea una clave nueva y cambian todos los ID de unidad.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Un registro de mando o un patch no es válido. Comprueba el archivo con su esquema y corrige el campo que nombra el mensaje.";
"ui.error.withCode" = "%1$@ (%2$@)";

