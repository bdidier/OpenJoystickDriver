"cli.access.grant.abstract" = "Permite que un programa firmado, o un token nuevo, use el punto de conexión.";
"platform.macos.cli.access.grant.adHoc" = "%@ tiene firma ad-hoc o no está firmado, así que cualquier programa local puede reclamar su firma. Fírmalo con un certificado Developer ID o Apple Development y luego concédele acceso.";
"platform.macos.cli.access.grant.platformWarning" = "Apple firmó este programa. Si ejecuta scripts, como python3 u osascript, todos los scripts que ejecute obtendrán este acceso.";
"cli.access.grant.clientOrToken" = "Indica CLIENT o --token NAME.";
"cli.access.grant.confirm" = "¿Permitir que %1$@, firmado como %2$@, use el punto de conexión con %3$@?";
"cli.access.grant.controlWarning" = "El ámbito control permite que el programa pulse botones de un mando virtual, que los juegos y las apps tratan como tu entrada.";
"cli.access.grant.discussion" = "CLIENT es la ruta del programa o un ID de «ojd access list». El acceso se asocia a la firma del programa, así que sigue siendo válido cuando el programa se actualiza o se mueve. No se puede conceder acceso a programas con firma ad-hoc ni a programas sin firmar. Con --token en lugar de CLIENT, crea un token con el que un cliente firma el desafío del servicio en su hello, por el socket, por el WebSocket desde una página de uno de los valores de --origin o, si el token no tiene --origin, por el WebSocket desde un programa que no envía encabezado Origin, como una app en un entorno aislado. Una página no puede usar el ámbito control. El token solo se muestra una vez. Pide confirmación primero.";
"cli.access.grant.origin" = "Un origen web, como http://127.0.0.1:8080, cuyas páginas pueden usar el token en el WebSocket. Repítelo para más. Las páginas de overlay que sirve el WebSocket tienen el origen http://127.0.0.1:PORT, con el puerto que muestra «ojd access status».";
"cli.access.grant.originControl" = "--origin no se puede combinar con el ámbito control. Una página nunca maneja un mando virtual; concede control a un token sin --origin.";
