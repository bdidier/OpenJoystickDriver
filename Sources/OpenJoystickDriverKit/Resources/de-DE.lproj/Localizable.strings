/* Status line of a service that is not running when its last request listener stopped with an error. %@ is the error code with its explanation, the error number and the time. */
"status.listenerFailure.earlier" = "Der Dienst läuft nicht. Seine letzte Anfrageannahme wurde beendet: %@";
/* Status line when the request listener cannot be restarted because the service is stopping or has not started. */
"status.listenerFailure.restartUnavailable" = "Der Dienst wird beendet oder ist noch nicht gestartet, daher lässt sich die Anfrageannahme nicht neu starten.";
/* Status line when restarting the request listener failed for a reason that is not an error number. %@ is the reason. */
"status.listenerFailure.restartFailedReason" = "Die Anfrageannahme ließ sich nicht neu starten: %@. Beende OpenJoystickDriver und öffne es erneut.";
/* Reason the listener failure file cannot be used: it is not a regular file. Fills the reason in the error E2035 message. */
"status.listenerFailure.notRegularFile" = "die Datei ist keine normale Datei";
/* Reason the listener failure file cannot be used: another user owns it, so ojd must run as that user. Fills the reason in the error E2035 message. */
"status.listenerFailure.otherUser" = "die Datei gehört einem anderen Benutzer; führe ojd als dieser Benutzer aus";
/* Reason the listener failure file cannot be used: the system would not say whether the process that wrote it runs. %1$@ is the system's reason, %2$@ the error number. Fills the reason in the error E2035 message. */
"status.listenerFailure.processCheckFailed" = "es ließ sich nicht prüfen, ob der Dienstprozess läuft: %1$@ (Fehlernummer %2$@)";
/* Abstract of the ojd setting test-notification command, in the command help. */
"cli.setting.testNotification.abstract" = "Zeigt eine Testmitteilung in der App an.";
/* Discussion of the ojd setting test-notification command, in the command help. */
"cli.setting.testNotification.discussion" = "Bittet den Dienst, die geöffnete OpenJoystickDriver-App eine Testmitteilung anzeigen zu lassen, und wartet, bis die App sie anzeigt. Schlägt mit einem benannten Fehler fehl, wenn Mitteilungen abgelehnt sind, die Zustellung scheitert oder keine App rechtzeitig antwortet. Standardwert von --timeout hier, in Sekunden: %@.";
/* Printed by ojd setting test-notification after the app reported that it showed the test notification. */
"cli.setting.testNotification.success" = "Die App hat die Testmitteilung angezeigt.";
