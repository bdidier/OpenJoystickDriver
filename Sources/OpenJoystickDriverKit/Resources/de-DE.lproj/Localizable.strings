"cli.access.grant.abstract" = "Erlaubt einem signierten Programm oder einem neuen Token, den Endpunkt zu nutzen.";
"platform.macos.cli.access.grant.adHoc" = "%@ ist ad hoc signiert oder nicht signiert, daher kann jedes lokale Programm seine Signatur beanspruchen. Signiere es mit einem Developer-ID- oder Apple-Development-Zertifikat und erteile ihm dann die Freigabe.";
"platform.macos.cli.access.grant.platformWarning" = "Apple hat dieses Programm signiert. Wenn es Skripte ausführt, etwa python3 oder osascript, erhält jedes Skript, das es ausführt, diesen Zugriff.";
"cli.access.grant.clientOrToken" = "Gib entweder CLIENT oder --token NAME an.";
"cli.access.grant.confirm" = "%1$@, signiert als %2$@, die Nutzung des Endpunkts mit %3$@ erlauben?";
"cli.access.grant.controlWarning" = "Der Bereich control erlaubt dem Programm, Tasten auf einem virtuellen Gamepad zu drücken, was Spiele und Apps als deine Eingabe behandeln.";
"cli.access.grant.discussion" = "CLIENT ist der Pfad des Programms oder eine ID aus „ojd access list“. Die Freigabe nennt die Signatur des Programms und bleibt daher gültig, wenn das Programm aktualisiert oder verschoben wird. Ad hoc signierte und nicht signierte Programme können nicht freigegeben werden. Mit --token statt CLIENT wird ein Token erstellt, mit dem ein Client die Challenge des Dienstes in seinem hello signiert, über den Socket, über den WebSocket von einer Seite eines der --origin-Werte oder, bei einem Token ohne --origin, über den WebSocket von einem Programm, das keinen Origin-Header sendet, etwa einer Sandbox-App. Eine Seite kann den Bereich control nicht verwenden. Das Token wird nur einmal angezeigt. Fragt zuerst nach einer Bestätigung.";
"cli.access.grant.origin" = "Ein Web-Ursprung, z. B. http://127.0.0.1:8080, dessen Seiten das Token über den WebSocket nutzen dürfen. Wiederhole die Option, um weitere hinzuzufügen. Die Overlay-Seiten, die der WebSocket ausliefert, haben den Ursprung http://127.0.0.1:PORT, mit dem Port, den „ojd access status“ anzeigt.";
"cli.access.grant.originControl" = "--origin lässt sich nicht mit dem Bereich control kombinieren. Eine Seite steuert nie ein virtuelles Gamepad; erteile control einem Token ohne --origin.";
