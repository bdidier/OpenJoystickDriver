"cli.record.group.abstract" = "Controller-Einträge entwerfen, auflisten, prüfen, installieren oder entfernen.";
"cli.record.group.discussion" = "Ein Controller-Eintrag sagt OpenJoystickDriver, wie ein Controller-Modell angesteuert wird. Deine Einträge liegen in ~/Library/Application Support/OpenJoystickDriver/Controllers und fügen ein Modell hinzu oder passen ein mitgeliefertes an. Der laufende Dienst wendet sie an, sobald sich der Ordner ändert. Nur „ojd record draft“ braucht den Dienst.";
"cli.record.draft.abstract" = "Einen Controller-Eintrag aus einem verbundenen Controller entwerfen.";
"cli.record.draft.captured" = "Eingabe-Reports aufgezeichnet: %lld.";
"cli.record.draft.changedByte" = "Byte %1$lld hat sich geändert: von %2$lld auf %3$lld.";
"cli.record.draft.discussion" = "Liest den HID-Report-Deskriptor des Controllers und zeichnet seine Eingabe-Reports auf, während du jedes Bedienelement betätigst, und gibt dann einen Eintrag als Ausgangspunkt aus. Der Eintrag ordnet die Tasten, Sticks, Trigger und das Steuerkreuz zu, die der Deskriptor eindeutig angibt. Die Bytes, die sich während der Aufzeichnung geändert haben, zeigen, wo die übrigen Bedienelemente liegen. Braucht den Dienst.";
"cli.record.draft.duration" = "Eingabe-Reports so viele Sekunden lang aufzeichnen.";
"cli.record.draft.next" = "Speichere den Eintrag in einer Datei, prüfe jedes Bedienelement und führe dann „ojd record validate FILE“ aus.";
