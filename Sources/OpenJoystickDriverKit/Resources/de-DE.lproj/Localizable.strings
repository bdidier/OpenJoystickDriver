"cli.record.test.difference" = "%1$@: erwartet %2$@, erhalten %3$@";
"cli.record.test.discussion" = "Spielt die empfangenen Pakete einer Aufzeichnung durch den Parser des Eintrags ab und vergleicht den Controller-Zustand nach dem letzten Eingabe-Report mit dem erwarteten Zustand. Die Aufzeichnung besteht aus den JSON-Zeilen von „ojd controller capture --json“. Der erwartete Zustand ist ein JSON-Objekt in der Form einer Zeile von „ojd controller watch --json“. Der Befehl listet jedes abweichende Feld auf und endet mit Code 1, sobald eines abweicht. Er vergleicht jedes Feld außer connection, das der laufende Dienst setzt. Er braucht keinen laufenden Dienst.";
"cli.record.test.expect" = "Der erwartete Controller-Zustand als JSON-Datei.";
"cli.record.test.expectInvalid" = "%1$@ ist kein Controller-Zustand: %2$@";
"cli.record.test.matched" = "%1$@ entspricht dem erwarteten Zustand: %2$lld Eingabe-Reports abgespielt.";
"cli.record.test.mismatch" = "Der Zustand, den der Parser von %1$@ erzeugt hat, weicht von %2$@ in %3$lld Feldern ab.";
"cli.record.test.noInput" = "Kein Report in %1$@ enthielt Eingaben für %2$@. Zeichne erneut auf, während du die Bedienelemente drückst.";
"cli.record.test.noParser" = "Die Familie von %@ hat keinen Parser, der ohne Controller läuft.";
"cli.record.test.packets" = "Eine Paketaufzeichnung als JSON-Zeilen von „ojd controller capture --json“.";
