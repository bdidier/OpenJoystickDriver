"error.E1001.message" = "Der Endpunkt ist aus. Schalte ihn mit „ojd access enable“ ein und verbinde dich erneut.";
"error.E1002.message" = "Der Dienst hat diesen Client abgelehnt. Er hat keine Freigabe für die angeforderten Bereiche, oder seine Signatur oder sein Nachweis ist ungültig. Führe „ojd access list“ aus, gib den Client mit „ojd access grant“ frei und verbinde dich erneut.";
"error.E1003.message" = "Der Dienst konnte die Zeile nicht annehmen. Sie ist ungültig oder kam zur falschen Zeit. Sende zuerst hello, dann eine Anfrage, und prüfe jede Zeile gegen das Endpunkt-Schema.";
"error.E1004.message" = "Der Endpunkt bedient bereits 8 Verbindungen pro Transportweg (je Socket und WebSocket). Schließe eine Verbindung, die du nicht brauchst, und verbinde dich erneut.";
"error.E1005.message" = "Die Freigabe dieses Clients wurde entfernt, während er verbunden war. Gib ihn mit „ojd access grant“ erneut frei und verbinde dich erneut.";
"error.E1006.message" = "Der Client hat Zeilen zu langsam gelesen, und 256 Zeilen haben gewartet. Lies Zeilen so schnell, wie sie ankommen, und verbinde dich erneut.";
"error.E1007.message" = "Der Dienst betreibt bereits 4 virtuelle Gamepads. Schließe einen Feed, den du nicht brauchst, und sende feed erneut.";
"error.E1008.message" = "Das virtuelle Gamepad wurde geschlossen, oder der Dienst betreibt keines. Verbinde dich erneut und sende feed.";
"error.E1009.message" = "Der Dienst unterstützt die apiVersion in einer Zeile nicht. Sende eine der Versionen in details.supportedAPIVersions und verbinde dich erneut.";
"error.E1010.message" = "Eine Zeile hat ein kind, das der Dienst nicht kennt oder an dieser Stelle nicht annimmt. Sende zuerst Hello, dann Subscription oder FeedRequest, dann Frame-Zeilen, und verbinde dich erneut.";
"error.E1011.message" = "Einer Zeile fehlt apiVersion oder kind. Jede Zeile trägt beides. Ergänze sie und verbinde dich erneut.";
