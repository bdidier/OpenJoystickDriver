"error.E2007.message" = "Der Dienst hat dieses ojd abgelehnt, weil es nicht wie die App signiert ist. Führe das ojd aus, das in OpenJoystickDriver.app enthalten ist.";
"error.E2008.message" = "Eine Berechtigung fehlt. Erteile sie mit „ojd permission request“.";
"error.E2009.message" = "Dieser Befehl ändert oder löscht Daten und braucht eine Bestätigung. Führe ihn erneut mit --force aus.";
"error.E2010.message" = "Der Befehl wurde beendet, bevor er fertig war, weil du abgelehnt hast, ein Editor fehlgeschlagen ist oder keine Eingabe kam. Führe ihn erneut aus.";
"error.E2011.message" = "Die Profil- oder Eintragsdatei ist ungültig. Korrigiere sie anhand ihres Schemas und versuche es erneut.";
"error.E2012.message" = "Kein Controller, Profil, keine Zuordnung und kein Client passt, oder es passen mehrere. Liste sie mit dem passenden „list“-Befehl auf und gib genau einen an.";
"error.E2013.message" = "Der Controller kann das gerade nicht. Er wird möglicherweise nicht unterstützt, ist nicht bereit oder getrennt. Prüfe ihn mit „ojd controller list“.";
"error.E2014.message" = "OpenJoystickDriver ist nicht vollständig installiert oder seine Signatur ist ungültig. Installiere die App erneut und führe „ojd diagnose“ aus.";
"error.E2015.message" = "Das System hat die Anfrage nicht abgeschlossen oder angewendet. Prüfe die Systemeinstellungen und versuche es erneut.";
"error.E2016.message" = "Eine Datei konnte nicht gelesen, geschrieben oder gelöscht werden, oder sie existiert bereits. Prüfe den Pfad und seine Berechtigungen.";
"error.E2017.message" = "Dieser Client ist nicht oder nur ad hoc signiert und kann daher keinen Zugriff erhalten. Signiere ihn mit einer Developer ID und versuche es erneut.";
"error.E2018.message" = "„ojd diagnose“ hat eine fehlgeschlagene Prüfung gefunden. Lies die Ausgabe und behebe die fehlgeschlagenen Punkte.";
"error.E2019.message" = "Die Suche nach Updates wurde nicht abgeschlossen. Prüfe deine Netzwerkverbindung und versuche es erneut.";
"error.E2020.message" = "Die installierte OpenJoystickDriver-App ist älter als dieses ojd. Führe „./Scripts/ojd build install-fast dev“ aus oder setze OJD_RUN_REPOSITORY_CLI=1, um diesen Build auszuführen.";
"error.E2021.message" = "Ein Repository-Build von ojd konnte den Befehl nicht an die installierte App übergeben. Installiere OpenJoystickDriver.app erneut und führe den Befehl noch einmal aus.";
"error.E3001.message" = "Der Controller ist nicht verbunden oder nicht bereit für die Neuzuordnung. Verbinde ihn erneut und versuche es noch einmal.";
"error.E3002.message" = "Die ausgewählten Joy-Cons konnten nicht gekoppelt werden. Aktualisiere die verbundenen Controller und versuche es erneut.";
"error.E3003.message" = "Der Controller meldet keine Bewegungsdaten. Wähle einen Controller mit Bewegungssensoren oder lass die Bewegungsoptionen aus.";
"error.E3004.message" = "Ein Wert in der Anfrage ist größer, als der Dienst annimmt. Sende einen kleineren Wert.";
