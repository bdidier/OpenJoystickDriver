"error.E3006.message" = "Ein Profil mit diesem Namen existiert bereits. Wähle einen anderen Namen; „ojd profile list“ zeigt die verwendeten Namen.";
"error.E3007.message" = "In der Anfrage fehlen Argumente oder sie sind ungültig. Prüfe die Werte und versuche es erneut.";
"error.E3008.message" = "Das Profil ist ungültig. Prüfe die Zuweisungen und versuche es erneut.";
"error.E3009.message" = "Die Profilbibliothek würde zu groß. Lösche Profile, die du nicht brauchst, und versuche es erneut.";
"error.E3010.message" = "Ein Profil mit dieser Kennung existiert bereits. Verwende eine neue Kennung oder aktualisiere das vorhandene Profil.";
"error.E3011.message" = "Das Profil wurde nach dem Laden anderswo geändert. Lade es neu und nimm deine Änderung erneut vor.";
"error.E3012.message" = "Die Bibliothek enthält bereits die höchste erlaubte Anzahl an Profilen. Lösche ein Profil, das du nicht brauchst, und versuche es erneut.";
"error.E3013.message" = "Kein Profil hat diese Kennung. Liste die Profile mit „ojd profile list“ auf.";
"error.E3014.message" = "Der Dienst konnte seine Antwort nicht kodieren. Versuche es erneut und melde das Problem, falls es bestehen bleibt.";
"error.E3015.message" = "Die Antwort ist größer, als der Dienst senden kann. Fordere weniger Daten an und versuche es erneut.";
"error.E3016.message" = "Die Neuzuordnungs-Engine ist nicht verfügbar. Warte einen Moment und versuche es erneut oder starte den Dienst neu.";
"error.E3017.message" = "Die Profilbibliothek und die Neuzuordnungs-Engine sind nicht verfügbar. Warte einen Moment und versuche es erneut oder starte den Dienst neu.";
"error.E3018.message" = "Die Profilbibliothek ist nicht verfügbar. Warte einen Moment und versuche es erneut oder starte den Dienst neu.";
"error.E3019.message" = "Der Neuzuordnungs-Router wurde heruntergefahren. Starte den Dienst neu und versuche es erneut.";
"error.E3020.message" = "Der Dienst konnte nicht bestätigen, ob die letzte Profiländerung gespeichert wurde. Lade die Profile neu und prüfe sie, bevor du sie wieder änderst.";
"error.E3021.message" = "Eine Profildatei konnte nicht gelesen werden. Prüfe, ob die Datei existiert und der Dienst sie lesen kann.";
"error.E3022.message" = "Beschädigte Profildateien müssen repariert oder entfernt werden, bevor Profile geändert werden können. Repariere oder entferne sie und versuche es erneut.";
"error.E3023.message" = "Eine Profildatei konnte nicht geschrieben werden. Prüfe den freien Speicherplatz und die Ordnerberechtigungen.";
"error.E3024.message" = "Der Neuzuordnungsdienst ist auf einen unbekannten Fehler gestoßen. Führe „ojd diagnose“ aus und melde das Problem zusammen mit der Ausgabe.";
"error.E3025.message" = "Das Profil erzeugt keine Ausgabe. Füge ihm eine Belegung oder eine Lichtfarbe hinzu oder aktiviere es mit --allow-empty.";
"error.E3026.message" = "Das Profil des Joy-Con-Paars bezieht das Gyroskop vom anderen Joy-Con. Kalibriere die Bewegung des Controllers, den das Profil für das Gyroskop auswählt.";
"error.E3027.message" = "Für den Controller ist kein Neuzuordnungsprofil aktiv, daher verarbeitet er keine Bewegung. Aktiviere ein Profil dafür, bringe die Ziel-App in den Vordergrund und versuche es noch einmal.";
"error.E3028.message" = "Die Neuzuordnungssitzung des Controllers hat sich während der Anfrage geändert. Versuche es noch einmal.";
"error.E3029.message" = "Ein Profil aus einem installierten Paket kann nicht geändert werden. Dupliziere das Profil und ändere die Kopie.";
"error.E4001.message" = "Das Paketmanifest mod.json fehlt oder ist ungültig. Prüfe es anhand des mod-package-Schemas und führe den Befehl erneut aus.";
"error.E4002.message" = "Das Paket benötigt eine andere Version von OpenJoystickDriver als die laufende. Installiere eine Paketversion, die diese Version unterstützt, oder aktualisiere OpenJoystickDriver.";
"error.E4003.message" = "Eine Datei des Pakets ist ungültig, fehlt oder ist in mod.json nicht aufgeführt. Korrigiere die im Befehl genannte Datei und führe ihn erneut aus.";
"error.E4004.message" = "Das Paket deckt einen Controller, eine Persona oder ein Profil ab, das bereits in deinen eigenen Dateien oder einem anderen installierten Paket vorhanden ist. Entferne die kollidierende Datei oder das Paket oder ändere das Paket und führe den Befehl erneut aus.";
"error.E4005.message" = "Ein Paket mit diesem Namen ist bereits installiert. Führe den Befehl mit --force aus, um es zu ersetzen.";
"error.E4006.message" = "Kein installiertes Paket hat diesen Namen. Führe ojd mod list aus, um die installierten Pakete anzuzeigen.";
"error.E4007.message" = "Der Paketordner konnte nicht geändert werden. Prüfe den freien Speicherplatz und die Ordnerberechtigungen.";
"error.E5001.message" = "Einem Dokument fehlt die apiVersion, oder seine apiVersion wird von dieser Version von OpenJoystickDriver nicht unterstützt. Ändere das Dokument auf die unterstützte apiVersion, die die Meldung nennt, und führe den Befehl erneut aus.";
"error.E5002.message" = "Eine Protokollbeschreibung ist ungültig. Prüfe die Datei gegen das Schema protocol-description und korrigiere das Feld, das die Meldung nennt.";
"error.E5003.message" = "Eine Protokollbeschreibung nennt eine Familie, die vom Dateinamen abweicht. Benenne die Datei nach ihrer Familie.";
"error.E5004.message" = "Eine Protokollbeschreibung führt eine Variante auf, die ihre Familie nicht hat. Verwende eine der Varianten der Familie.";
"error.E5005.message" = "Die Zugriffsdatei AccessGrants.json ist beschädigt. Repariere die Datei oder lösche sie und erteile den Zugriff dann erneut.";
"error.E5006.message" = "Die Schlüsseldatei der Geräte-IDs, PortKeyInstallation.key, kann nicht gelesen werden oder ist nicht 32 Byte groß. Stellen Sie die Datei aus einer Sicherung wieder her. Wenn Sie sie stattdessen löschen, erstellt OpenJoystickDriver einen neuen Schlüssel, und jede Geräte-ID ändert sich.";
"error.E5007.message" = "Ein Controller-Eintrag oder -Patch ist ungültig. Prüfe die Datei gegen ihr Schema und korrigiere das Feld, das die Meldung nennt.";
