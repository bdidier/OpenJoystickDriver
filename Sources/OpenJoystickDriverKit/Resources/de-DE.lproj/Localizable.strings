"cli.record.install.abstract" = "Einen Controller-Eintrag prüfen und für dein Konto installieren.";
"cli.record.install.confirm" = "%@ ersetzen?";
"cli.record.install.discussion" = "Schreibt den Eintrag als VVVV-PPPP.json in dein Eintragsverzeichnis. Der laufende Dienst wendet ihn sofort an. Beim Ersetzen des Eintrags, der für dieses Modell schon installiert ist, wird in einem Terminal zuerst nachgefragt, sonst ist --force nötig. --dry-run prüft den Eintrag und schreibt nichts. Endet mit 1 und schreibt nichts, wenn der Eintrag ungültig ist.";
