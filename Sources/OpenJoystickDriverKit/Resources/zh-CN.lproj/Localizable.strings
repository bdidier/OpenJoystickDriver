"platform.macos.cli.root.group.abstract" = "配置并检查 macOS 游戏手柄驱动程序 OpenJoystickDriver。";
"platform.macos.cli.root.group.discussion" = "从这里开始：\n  ojd status             检查服务、扩展和权限。\n  ojd diagnose           运行所有检查并报告问题。\n  ojd controller list    列出已连接的控制器。\n\n示例：\n  # 在输入变化时打印某个控制器的输入\n  ojd controller watch 045E:028E\n  # 以 JSON 列出已连接的控制器\n  ojd --json controller list\n\n环境变量（标志优先于变量）：\n  OJD_NO_INPUT=1         与 --no-input 相同。\n  OJD_TIMEOUT=SECONDS    与 --timeout 相同。\n  OJD_COLOR=WHEN         auto、always（即使不在终端中也使用颜色）或 never。\n\nShell 补全：\n  ojd --generate-completion-script zsh|bash|fish\n\n退出码：\n  0    成功。\n  1    命令失败。\n  64   用法错误。\n  69   服务未运行。请用“ojd service start”启动。\n  77   缺少 macOS 权限。\n  127  仓库构建无法将命令交给已安装的 App。\n  130  已中断。";
"cli.shared.help.globalOptions" = "每个命令也接受全局选项；“ojd --help”会列出它们。";
"cli.shared.error.envTimeout" = "OJD_TIMEOUT 需要大于 0 的秒数。";
"cli.shared.error.envColor" = "OJD_COLOR 需要 auto、always 或 never。";
"cli.shared.error.envNoInput" = "OJD_NO_INPUT 需要 1、true、yes、0、false 或 no。";
"cli.virtual.feed.errorPlain" = "--plain 不适用于输出 JSON 行的“virtual feed”。请去掉 --plain。";
"cli.controller.watch.examples" = "示例：\n  # 打印 10 秒的输入\n  ojd controller watch 045E:028E --duration 10\n  # 以 JSON 打印最先按下的控件\n  ojd controller watch 045E:028E --first-press --json\n  # 监视所有控制器及其虚拟游戏手柄发送的内容\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "示例：\n  # 让两个主马达以 180 的强度运行 0.45 秒\n  ojd controller rumble 045E:028E\n  # 让两个主马达以最大强度运行 2 秒\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "示例：\n  # 将灯条设为橙色\n  ojd controller light 054C:09CC --color FF8000\n  # 设置颜色和较低的亮度\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "示例：\n  # 为某一控制器型号创建配置文件\n  ojd profile create Racing --controller 045E:028E\n  # 仅在 Safari 位于最前面时应用\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "示例：\n  # 重命名配置文件\n  ojd profile set Racing name Rally\n  # 设置第一个摇杆映射的内死区\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "示例：\n  # 按住南键时按住空格键\n  ojd binding set Racing button:south key:space\n  # 每按一次切换 J 的开关\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # 按住时每秒重复 J 10 次\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "示例：\n  # 安装记录文件\n  ojd record install 045E-028E.json\n  # 从标准输入读取记录\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "示例：\n  # 允许某个程序使用服务\n  ojd access grant /Applications/Example.app\n  # 为来自某个源的页面创建令牌\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
