"platform.macos.cli.root.group.discussion" = "เริ่มที่นี่:\n  ojd status             ตรวจสอบบริการ ส่วนขยาย และสิทธิ์\n  ojd diagnose           เรียกใช้การตรวจสอบทั้งหมดและรายงานสิ่งที่ผิดปกติ\n  ojd controller list    แสดงรายการคอนโทรลเลอร์ที่เชื่อมต่อ\n\nตัวอย่าง:\n  # พิมพ์อินพุตของคอนโทรลเลอร์หนึ่งตัวเมื่อมีการเปลี่ยนแปลง\n  ojd controller watch 045E:028E\n  # แสดงรายการคอนโทรลเลอร์ที่เชื่อมต่อเป็น JSON\n  ojd --json controller list\n\nสภาพแวดล้อม (แฟล็กมีผลเหนือตัวแปร):\n  OJD_NO_INPUT=1         เหมือน --no-input\n  OJD_TIMEOUT=SECONDS    เหมือน --timeout\n  OJD_COLOR=WHEN         auto, always (มีสีแม้นอกเทอร์มินัล) หรือ never\n\nการเติมคำสั่งอัตโนมัติของเชลล์:\n  ojd --generate-completion-script zsh|bash|fish\n\nรหัสออก:\n  0    สำเร็จ\n  1    คำสั่งล้มเหลว\n  64   ข้อผิดพลาดการใช้งาน\n  69   บริการไม่ได้ทำงานอยู่ เริ่มด้วย “ojd service start”\n  77   ไม่มีสิทธิ์ของ macOS\n  127  บิลด์จากรีพอสิทอรีส่งคำสั่งต่อไปยังแอปที่ติดตั้งไว้ไม่ได้\n  130  ถูกขัดจังหวะ";
"cli.shared.help.globalOptions" = "ทุกคำสั่งรับตัวเลือกส่วนกลางด้วย “ojd --help” จะแสดงรายการตัวเลือกเหล่านั้น";
"cli.shared.error.envTimeout" = "OJD_TIMEOUT ต้องเป็นจำนวนวินาทีที่มากกว่า 0";
"cli.shared.error.envColor" = "OJD_COLOR ต้องเป็น auto, always หรือ never";
"cli.shared.error.envNoInput" = "OJD_NO_INPUT ต้องเป็น 1, true, yes, 0, false หรือ no";
"cli.virtual.feed.errorPlain" = "--plain ใช้กับ “virtual feed” ไม่ได้ เพราะคำสั่งนี้พิมพ์บรรทัด JSON ให้เอา --plain ออก";
"cli.controller.watch.examples" = "ตัวอย่าง:\n  # พิมพ์อินพุตเป็นเวลา 10 วินาที\n  ojd controller watch 045E:028E --duration 10\n  # พิมพ์ปุ่มควบคุมแรกที่ถูกกดเป็น JSON\n  ojd controller watch 045E:028E --first-press --json\n  # ดูคอนโทรลเลอร์ทุกตัวและสิ่งที่เกมแพดเสมือนของแต่ละตัวส่ง\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "ตัวอย่าง:\n  # เปิดมอเตอร์หลักทั้งสองที่ค่า 180 เป็นเวลา 0.45 วินาที\n  ojd controller rumble 045E:028E\n  # เปิดมอเตอร์หลักทั้งสองที่กำลังเต็มเป็นเวลา 2 วินาที\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "ตัวอย่าง:\n  # ตั้งไลต์บาร์เป็นสีส้ม\n  ojd controller light 054C:09CC --color FF8000\n  # ตั้งสีและความสว่างต่ำ\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "ตัวอย่าง:\n  # สร้างโปรไฟล์สำหรับคอนโทรลเลอร์รุ่นหนึ่ง\n  ojd profile create Racing --controller 045E:028E\n  # ใช้เฉพาะเมื่อ Safari อยู่ด้านหน้าสุด\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "ตัวอย่าง:\n  # เปลี่ยนชื่อโปรไฟล์\n  ojd profile set Racing name Rally\n  # ตั้งเดดโซนด้านในของการแมปสติ๊กแรก\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "ตัวอย่าง:\n  # กด Space ค้างไว้ขณะที่กดปุ่มทิศใต้ค้างไว้\n  ojd binding set Racing button:south key:space\n  # สลับ J ทุกครั้งที่กด\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # กด J ซ้ำ 10 ครั้งต่อวินาทีขณะกดค้างไว้\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "ตัวอย่าง:\n  # ติดตั้งไฟล์เรคคอร์ด\n  ojd record install 045E-028E.json\n  # อ่านเรคคอร์ดจาก stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "ตัวอย่าง:\n  # อนุญาตให้โปรแกรมใช้บริการ\n  ojd access grant /Applications/Example.app\n  # สร้างโทเค็นสำหรับหน้าเว็บที่ให้บริการจากต้นทางเดียว\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
"cli.service.group.abstract" = "เริ่มหรือหยุดบริการ OpenJoystickDriver หรือรอจนกว่าบริการจะรับคำขอ";
"cli.service.group.running" = "บริการกำลังทำงานอยู่";
"cli.service.start.abstract" = "เปิดแอพในพื้นหลังและรอจนกว่าบริการของแอพจะรับคำขอ";
"cli.service.start.noBundle" = "ojd นี้ไม่ได้อยู่ใน OpenJoystickDriver.app จึงไม่สามารถเริ่มบริการได้ เปิดแอพที่ติดตั้งไว้ หรือเรียกใช้ ojd ที่อยู่ในแอพนั้น";
