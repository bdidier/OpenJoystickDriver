"cli.access.enable.confirm" = "เปิดเอนด์พอยต์ เพื่อให้โปรแกรมที่คุณให้สิทธิ์อ่านอินพุตของคอนโทรลเลอร์ทุกตัวได้หรือไม่";
"cli.access.enable.discussion" = "ขอการยืนยันก่อน เฉพาะโปรแกรมที่ได้รับสิทธิ์เท่านั้นที่ใช้เอนด์พอยต์ได้ เพิ่มโปรแกรมด้วย “ojd access grant”";
"cli.access.enable.success" = "เอนด์พอยต์รับฟังที่ %@";
"cli.access.grant.abstract" = "อนุญาตให้โปรแกรมที่ลงนามหรือโทเค็นใหม่ใช้เอนด์พอยต์";
"platform.macos.cli.access.grant.adHoc" = "%@ ลงนามแบบ ad-hoc หรือไม่ได้ลงนาม โปรแกรมภายในเครื่องใดๆ จึงอ้างลายเซ็นของมันได้ ลงนามด้วยใบรับรอง Developer ID หรือ Apple Development แล้วจึงให้สิทธิ์";
"platform.macos.cli.access.grant.platformWarning" = "Apple ลงนามโปรแกรมนี้ หากโปรแกรมเรียกใช้สคริปต์ เช่น python3 หรือ osascript สคริปต์ทุกตัวที่เรียกใช้จะได้รับสิทธิ์นี้";
"cli.access.grant.clientOrToken" = "ระบุ CLIENT หรือ --token NAME อย่างใดอย่างหนึ่ง";
