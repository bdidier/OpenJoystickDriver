{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "XboxXID",
  "variants": ["Gamepad"],
  "storesVariant": true,
  "endpoints": {
    "in": 129,
    "out": 2
  },
  "rawUSB": true,
  "recordSections": ["input", "rumble"],
  "interfaceSignatures": [
    {
      "variant": "Gamepad",
      "interfaceClass": 88,
      "interfaceSubclass": 66,
      "interfaceProtocol": 0
    }
  ],
  "controls": {
    "base": "Xbox"
  },
  "rawUSBTuningKeys": ["usbTransferTimeoutMs"],
  "defaults": {
    "tuning": {
      "usbTransferTimeoutMs": 2000
    },
    "session": {
      "rumble": {
        "report": {
          "kind": "USB",
          "length": 6
        },
        "bytes": "00 06 00 00 00 00",
        "lowFrequency": {
          "byte": 2,
          "encoding": "UInt16BigEndian"
        },
        "highFrequency": {
          "byte": 4,
          "encoding": "UInt16BigEndian"
        }
      }
    },
    "input": {
      "report": {
        "length": 20
      },
      "buttons": [
        {
          "control": "Start",
          "byte": 2,
          "mask": 16
        },
        {
          "control": "Back",
          "byte": 2,
          "mask": 32
        },
        {
          "control": "LeftStickClick",
          "byte": 2,
          "mask": 64
        },
        {
          "control": "RightStickClick",
          "byte": 2,
          "mask": 128
        },
        {
          "control": "South",
          "byte": 4,
          "mask": 255
        },
        {
          "control": "East",
          "byte": 5,
          "mask": 255
        },
        {
          "control": "West",
          "byte": 6,
          "mask": 255
        },
        {
          "control": "North",
          "byte": 7,
          "mask": 255
        },
        {
          "control": "LeftShoulder",
          "byte": 8,
          "mask": 255
        },
        {
          "control": "RightShoulder",
          "byte": 9,
          "mask": 255
        }
      ],
      "axes": [
        {
          "control": "LeftStickX",
          "byte": 12,
          "bits": 16,
          "signed": true,
          "min": -32768,
          "max": 32767,
          "symmetric": true
        },
        {
          "control": "LeftStickY",
          "byte": 14,
          "bits": 16,
          "signed": true,
          "min": -32768,
          "max": 32767,
          "inverted": true,
          "symmetric": true
        },
        {
          "control": "RightStickX",
          "byte": 16,
          "bits": 16,
          "signed": true,
          "min": -32768,
          "max": 32767,
          "symmetric": true
        },
        {
          "control": "RightStickY",
          "byte": 18,
          "bits": 16,
          "signed": true,
          "min": -32768,
          "max": 32767,
          "inverted": true,
          "symmetric": true
        }
      ],
      "hat": [
        {
          "encoding": "Table",
          "byte": 2,
          "mask": 15,
          "values": {
            "1": "North",
            "2": "South",
            "4": "West",
            "8": "East",
            "9": "NorthEast",
            "10": "SouthEast",
            "6": "SouthWest",
            "5": "NorthWest"
          }
        }
      ],
      "leftTrigger": {
        "byte": 10
      },
      "rightTrigger": {
        "byte": 11
      }
    }
  }
}
