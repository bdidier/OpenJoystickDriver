{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "NintendoSwitchInputOnly",
  "variants": ["USB", "BluetoothClassic"],
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["input"],
  "tuningKeys": ["hidStartupIntervalMs", "minimumHIDOutputIntervalMs"],
  "controls": {
    "base": "Xbox",
    "add": ["Guide", "Capture"],
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "input": {
      "report": {
        "length": { "atLeast": 7 }
      },
      "buttons": [
        {
          "control": "West",
          "byte": 0,
          "mask": 1
        },
        {
          "control": "South",
          "byte": 0,
          "mask": 2
        },
        {
          "control": "East",
          "byte": 0,
          "mask": 4
        },
        {
          "control": "North",
          "byte": 0,
          "mask": 8
        },
        {
          "control": "LeftShoulder",
          "byte": 0,
          "mask": 16
        },
        {
          "control": "RightShoulder",
          "byte": 0,
          "mask": 32
        },
        {
          "control": "LeftTrigger",
          "byte": 0,
          "mask": 64
        },
        {
          "control": "RightTrigger",
          "byte": 0,
          "mask": 128
        },
        {
          "control": "Back",
          "byte": 1,
          "mask": 1
        },
        {
          "control": "Start",
          "byte": 1,
          "mask": 2
        },
        {
          "control": "LeftStickClick",
          "byte": 1,
          "mask": 4
        },
        {
          "control": "RightStickClick",
          "byte": 1,
          "mask": 8
        },
        {
          "control": "Guide",
          "byte": 1,
          "mask": 16
        },
        {
          "control": "Capture",
          "byte": 1,
          "mask": 32
        }
      ],
      "axes": [
        {
          "control": "LeftStickX",
          "byte": 3
        },
        {
          "control": "LeftStickY",
          "byte": 4
        },
        {
          "control": "RightStickX",
          "byte": 5
        },
        {
          "control": "RightStickY",
          "byte": 6
        }
      ],
      "hat": [
        {
          "encoding": "EightWay",
          "byte": 2,
          "mask": 255
        }
      ]
    }
  }
}
