{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "valve.steam-triton",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "lizardResendTicks"
  ],
  "controls": {
    "base": "xbox",
    "add": [
      "Guide",
      "Auxiliary1",
      "LeftPaddle1",
      "LeftPaddle2",
      "RightPaddle1",
      "RightPaddle2",
      "LeftStickTouch",
      "RightStickTouch",
      "LeftTrackpadClick",
      "RightTrackpadClick",
      "LeftTrackpadTouch",
      "RightTrackpadTouch"
    ],
    "touchContactCount": 1,
    "motion": true,
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "session": {
      "keepAlive": {
        "intervalMilliseconds": 40,
        "writes": [
          {
            "report": {
              "kind": "feature",
              "id": 1,
              "length": 64
            },
            "bytes": "87 03 09 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
            "resendTuning": "lizardResendTicks"
          }
        ]
      }
    },
    "tuning": {
      "lizardResendTicks": 75,
      "frameQueueCapacity": 64
    }
  }
}
