{
	"apiVersion": "openjoystickdriver/v1alpha1",
	"kind": "ProtocolDescription",
	"family": "vendor.gamesir",
	"endpoints": {
		"in": 130,
		"out": 2
	},
	"rawUSB": [
		"usb"
	],
	"tuningKeys": [
		"hidStartupIntervalMs",
		"minimumHIDOutputIntervalMs",
		"keepAliveIntervalMs"
	],
	"parameters": {
		"innerGrips": {
			"type": "flag"
		},
		"lightingMemory": {
			"type": "enum",
			"values": [
				"ProfileSlots"
			]
		}
	},
	"controls": {
		"base": "xbox",
		"add": [
			"guide",
			"paddle-left-1",
			"paddle-right-1",
			"auxiliary-1"
		]
	},
	"rawUSBTuningKeys": [
		"keepAliveIntervalMs",
		"usbCommandTimeoutMs"
	],
	"defaults": {
		"tuning": {
			"hidStartupIntervalMs": 20,
			"minimumHIDOutputIntervalMs": 20,
			"keepAliveIntervalMs": 500,
			"usbCommandTimeoutMs": 2000
		}
	}
}
