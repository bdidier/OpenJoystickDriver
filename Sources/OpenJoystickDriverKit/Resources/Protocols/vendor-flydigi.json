{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "VendorFlydigi",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["input"],
  "tuningKeys": ["hidStartupIntervalMs", "minimumHIDOutputIntervalMs"],
  "controls": {
    "base": "Xbox",
    "add": ["Guide"],
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "input": {
      "report": {
        "id": 1,
        "length": { "exactly": 15 }
      },
      "buttons": [
        {
          "control": "South",
          "byte": 9,
          "mask": 16
        },
        {
          "control": "East",
          "byte": 9,
          "mask": 32
        },
        {
          "control": "West",
          "byte": 9,
          "mask": 64
        },
        {
          "control": "North",
          "byte": 9,
          "mask": 128
        },
        {
          "control": "LeftShoulder",
          "byte": 10,
          "mask": 1
        },
        {
          "control": "RightShoulder",
          "byte": 10,
          "mask": 2
        },
        {
          "control": "LeftTrigger",
          "byte": 10,
          "mask": 4
        },
        {
          "control": "RightTrigger",
          "byte": 10,
          "mask": 8
        },
        {
          "control": "Back",
          "byte": 10,
          "mask": 16
        },
        {
          "control": "Start",
          "byte": 10,
          "mask": 32
        },
        {
          "control": "LeftStickClick",
          "byte": 10,
          "mask": 64
        },
        {
          "control": "RightStickClick",
          "byte": 10,
          "mask": 128
        },
        {
          "control": "Guide",
          "byte": 12,
          "mask": 128
        }
      ],
      "axes": [
        {
          "control": "LeftStickX",
          "byte": 1,
          "bits": 8,
          "signed": true,
          "min": -128,
          "max": 127,
          "symmetric": true
        },
        {
          "control": "LeftStickY",
          "byte": 2,
          "bits": 8,
          "signed": true,
          "min": -128,
          "max": 127,
          "symmetric": true
        },
        {
          "control": "RightStickX",
          "byte": 3,
          "bits": 8,
          "signed": true,
          "min": -128,
          "max": 127,
          "symmetric": true
        },
        {
          "control": "RightStickY",
          "byte": 4,
          "bits": 8,
          "signed": true,
          "min": -128,
          "max": 127,
          "symmetric": true
        }
      ],
      "hat": [
        {
          "encoding": "Table",
          "byte": 9,
          "mask": 15,
          "values": {
            "1": "North",
            "2": "NorthEast",
            "3": "East",
            "4": "SouthEast",
            "5": "South",
            "6": "SouthWest",
            "7": "West",
            "8": "NorthWest"
          }
        }
      ],
      "leftTrigger": {
        "byte": 13
      },
      "rightTrigger": {
        "byte": 14
      }
    }
  }
}
