	"kind": "ProtocolDescription",
	"family": "sony.dualsense",
	"endpoints": {
		"in": 130,
		"out": 2
	},
	"tuningKeys": [
		"hidStartupIntervalMs",
		"minimumHIDOutputIntervalMs"
	],
	"buttonLabels": "PlayStation",
	"parameters": {
