			"type": "enum",
			"values": [
				"ThirdParty"
			]
		},
		"unprobedSensors": {
			"type": "flag"
		},
		"unprobedTouchpad": {
			"type": "flag"
		},
		"forcedVibration": {
			"type": "flag"
		},
		"role": {
			"type": "enum",
			"values": [
				"Receiver"
			]
		}
	}
