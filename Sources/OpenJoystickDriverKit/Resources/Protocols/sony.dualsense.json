{
	"apiVersion": "openjoystickdriver/v1alpha1",
	"kind": "ProtocolDescription",
	"family": "sony.dualsense",
	"endpoints": {
		"in": 130,
		"out": 2
	},
	"tuningKeys": [
		"hidStartupIntervalMs",
		"minimumHIDOutputIntervalMs"
	],
	"buttonLabels": "PlayStation",
	"parameters": {
		"maker": {
			"type": "enum",
			"values": [
				"ThirdParty"
			]
		},
		"unprobedSensors": {
			"type": "flag"
		},
		"unprobedTouchpad": {
			"type": "flag"
		},
		"forcedVibration": {
			"type": "flag"
		},
		"role": {
			"type": "enum",
			"values": [
				"Receiver"
			]
		}
	},
	"controls": {
		"base": "xbox",
		"add": [
			"guide",
			"left-trigger-button",
			"right-trigger-button",
			"touchpad-click",
			"microphone"
		],
		"touchContactCount": 2,
		"motion": true
	},
	"recordCapabilities": {
		"present": [
			"paddle-left-1",
			"paddle-right-1",
			"auxiliary-1",
			"auxiliary-2"
		]
	}
}
