{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "nintendo.switch1",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "recordSections": ["rumble"],
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "hidStartupRecoveryIntervalMs",
    "hidStartupRecoveryRounds"
  ],
  "parameters": {
    "layout": {
      "type": "enum",
      "values": ["Pro", "JoyConLeft", "JoyConRight"]
    },
    "usbProtocol": {
      "type": "enum",
      "values": ["ChargingOnly"]
    }
  },
  "defaults": {
    "session": {
      "rumble": {
        "report": {
          "kind": "output",
          "id": 16,
          "length": 10
        },
        "bytes": "10 00 00 01 40 40 00 01 40 40",
        "counter": {
          "byte": 1
        },
        "leftMain": {
          "byte": 2,
          "encoding": "SwitchHDRumble"
        },
        "rightMain": {
          "byte": 6,
          "encoding": "SwitchHDRumble"
        }
      },
      "startup": [
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": "02",
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": "03",
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": "02",
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": "04",
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        }
      ],
      "subcommands": {
        "reportId": 1,
        "counterModulus": 16,
        "playerIndicator": {
          "subcommand": 48,
          "patterns": {
            "off": 0,
            "player1": 1,
            "player2": 3,
            "player3": 7,
            "player4": 15
          }
        },
        "requests": [
          {
            "subcommand": 3,
            "data": "30"
          },
          {
            "subcommand": 64,
            "data": "01"
          },
          {
            "subcommand": 72,
            "data": "01"
          },
          {
            "subcommand": 16,
            "spiRead": {
              "address": 24608,
              "length": 24,
              "purpose": "factoryMotionCalibration"
            }
          },
          {
            "subcommand": 16,
            "spiRead": {
              "address": 32806,
              "length": 20,
              "purpose": "userMotionCalibration"
            }
          }
        ]
      }
    },
    "tuning": {
      "minimumHIDOutputIntervalMs": 50,
      "hidStartupRecoveryIntervalMs": 200,
      "hidStartupRecoveryRounds": 2
    },
    "variants": {
      "bluetooth-classic": {
        "tuning": {
          "hidStartupIntervalMs": 60
        }
      },
      "usb": {
        "tuning": {
          "hidStartupIntervalMs": 20
        }
      }
    }
  }
}
