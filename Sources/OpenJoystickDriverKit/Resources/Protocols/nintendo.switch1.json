{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "nintendo.switch1",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "hidStartupRecoveryIntervalMs",
    "hidStartupRecoveryRounds"
  ],
  "buttonLabels": "Nintendo",
  "parameters": {
    "layout": {
      "type": "enum",
      "values": ["Pro", "JoyConLeft", "JoyConRight"]
    },
    "usbProtocol": {
      "type": "enum",
      "values": ["ChargingOnly"]
    }
  },
  "defaults": {
    "session": {
      "subcommands": {
        "reportId": 1,
        "counterModulus": 16,
        "requests": [
          { "subcommand": 3, "data": [48] },
          { "subcommand": 64, "data": [1] },
          { "subcommand": 72, "data": [1] },
          {
            "subcommand": 16,
            "spiRead": {
              "address": 24608,
              "length": 24,
              "purpose": "factoryMotionCalibration"
            }
          },
          {
            "subcommand": 16,
            "spiRead": {
              "address": 32806,
              "length": 20,
              "purpose": "userMotionCalibration"
            }
          }
        ]
      }
    },
    "tuning": {
      "minimumHIDOutputIntervalMs": 50,
      "hidStartupRecoveryIntervalMs": 200,
      "hidStartupRecoveryRounds": 2,
      "frameQueueCapacity": 64
    },
    "variants": {
      "bluetooth-classic": {
        "tuning": {
          "hidStartupIntervalMs": 60
        }
      },
      "usb": {
        "tuning": {
          "hidStartupIntervalMs": 20
        }
      }
    },
    "output": {
      "startup": [
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": [2],
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": [3],
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": [2],
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        },
        {
          "report": {
            "kind": "output",
            "id": 128,
            "length": 2
          },
          "bytes": [4],
          "phase": "startup",
          "variants": ["usb"],
          "when": {
            "parameter": "layout",
            "isNot": ["JoyConLeft", "JoyConRight"]
          }
        }
      ]
    }
  }
}
