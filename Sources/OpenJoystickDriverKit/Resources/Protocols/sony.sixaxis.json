{
	"apiVersion": "openjoystickdriver/v1alpha1",
	"kind": "ProtocolDescription",
	"family": "sony.sixaxis",
	"endpoints": {
		"in": 130,
		"out": 2
	},
	"tuningKeys": [
		"hidStartupIntervalMs",
		"minimumHIDOutputIntervalMs"
	],
	"macOSOwnedOutput": {
		"lightingFeatures": [
			"playerIndicator"
		],
		"drivesRumble": true,
		"reports": [
			{
				"kind": "output",
				"id": 1,
				"length": 49
			}
		],
		"setsStartupPlayerIndicator": true,
		"readsStartupFeatures": true
	}
}
