"platform.macos.cli.root.group.abstract" = "設定並檢查 macOS 遊戲控制器驅動程式 OpenJoystickDriver。";
"platform.macos.cli.root.group.discussion" = "從這裡開始：\n  ojd status             檢查服務、延伸功能和權限。\n  ojd diagnose           執行所有檢查並回報問題。\n  ojd controller list    列出已連接的控制器。\n\n範例：\n  # 在輸入變化時列印某個控制器的輸入\n  ojd controller watch 045E:028E\n  # 以 JSON 列出已連接的控制器\n  ojd --json controller list\n\n環境變數（旗標優先於變數）：\n  OJD_NO_INPUT=1         與 --no-input 相同。\n  OJD_TIMEOUT=SECONDS    與 --timeout 相同。\n  OJD_COLOR=WHEN         auto、always（即使不在終端機中也使用顏色）或 never。\n\nShell 自動補全：\n  ojd --generate-completion-script zsh|bash|fish\n\n結束碼：\n  0    成功。\n  1    指令失敗。\n  64   用法錯誤。\n  69   服務未在執行。請用「ojd service start」啟動。\n  77   缺少 macOS 權限。\n  127  儲存庫建置無法將指令交給已安裝的 App。\n  130  已中斷。";
"cli.shared.help.globalOptions" = "每個指令也接受全域選項；「ojd --help」會列出它們。";
"cli.shared.error.envTimeout" = "OJD_TIMEOUT 需要大於 0 的秒數。";
"cli.shared.error.envColor" = "OJD_COLOR 需要 auto、always 或 never。";
"cli.shared.error.envNoInput" = "OJD_NO_INPUT 需要 1、true、yes、0、false 或 no。";
"cli.virtual.feed.errorPlain" = "--plain 不適用於輸出 JSON 行的「virtual feed」。請移除 --plain。";
"cli.controller.watch.examples" = "範例：\n  # 列印 10 秒的輸入\n  ojd controller watch 045E:028E --duration 10\n  # 以 JSON 列印最先按下的控制項\n  ojd controller watch 045E:028E --first-press --json\n  # 監看所有控制器及其虛擬遊戲控制器傳送的內容\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "範例：\n  # 讓兩個主馬達以 180 的強度運轉 0.45 秒\n  ojd controller rumble 045E:028E\n  # 讓兩個主馬達以最大強度運轉 2 秒\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "範例：\n  # 將燈條設為橘色\n  ojd controller light 054C:09CC --color FF8000\n  # 設定顏色和較低的亮度\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "範例：\n  # 為某一控制器型號建立設定檔\n  ojd profile create Racing --controller 045E:028E\n  # 只在 Safari 位於最前面時套用\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "範例：\n  # 重新命名設定檔\n  ojd profile set Racing name Rally\n  # 設定第一個搖桿對應的內死區\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "範例：\n  # 按住南鍵時按住空白鍵\n  ojd binding set Racing button:south key:space\n  # 每按一次切換 J 的開關\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # 按住時每秒重複 J 10 次\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "範例：\n  # 安裝記錄檔\n  ojd record install 045E-028E.json\n  # 從標準輸入讀取記錄\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "範例：\n  # 允許某個程式使用服務\n  ojd access grant /Applications/Example.app\n  # 為來自某個來源的頁面建立權杖\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
