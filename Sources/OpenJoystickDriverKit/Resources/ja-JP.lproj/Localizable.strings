"platform.macos.cli.root.group.abstract" = "macOS 用ゲームパッドドライバ OpenJoystickDriver を設定し、状態を確認します。";
"platform.macos.cli.root.group.discussion" = "ここから始める:\n  ojd status             サービス、拡張機能、権限を確認します。\n  ojd diagnose           すべてのチェックを実行し、問題点を報告します。\n  ojd controller list    接続中のコントローラを一覧表示します。\n\n例:\n  # 1 台のコントローラの入力を変化に合わせて表示\n  ojd controller watch 045E:028E\n  # 接続中のコントローラを JSON で一覧表示\n  ojd --json controller list\n\n環境変数（フラグが変数より優先されます）:\n  OJD_NO_INPUT=1         --no-input と同じ。\n  OJD_TIMEOUT=SECONDS    --timeout と同じ。\n  OJD_COLOR=WHEN         auto、always（端末以外でも色を付ける）、または never。\n\nシェル補完:\n  ojd --generate-completion-script zsh|bash|fish\n\n終了コード:\n  0    成功。\n  1    コマンドが失敗しました。\n  64   使用方法のエラー。\n  69   サービスが実行されていません。「ojd service start」で開始してください。\n  77   macOS の権限がありません。\n  127  リポジトリのビルドがコマンドをインストール済みのアプリに渡せませんでした。\n  130  中断されました。";
"cli.shared.help.globalOptions" = "すべてのコマンドでグローバルオプションも使えます。一覧は「ojd --help」で確認できます。";
"cli.shared.error.envTimeout" = "OJD_TIMEOUT には 0 より大きい秒数を指定してください。";
"cli.shared.error.envColor" = "OJD_COLOR には auto、always、never のいずれかを指定してください。";
"cli.shared.error.envNoInput" = "OJD_NO_INPUT には 1、true、yes、0、false、no のいずれかを指定してください。";
"cli.virtual.feed.errorPlain" = "--plain は JSON 行を出力する「virtual feed」には使えません。--plain を外してください。";
"cli.controller.watch.examples" = "例:\n  # 10 秒間入力を表示\n  ojd controller watch 045E:028E --duration 10\n  # 最初に押されたコントロールを JSON で表示\n  ojd controller watch 045E:028E --first-press --json\n  # すべてのコントローラと、その仮想ゲームパッドが送る内容を監視\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "例:\n  # 2 つのメインモーターを強さ 180 で 0.45 秒間動かす\n  ojd controller rumble 045E:028E\n  # 2 つのメインモーターを最大の強さで 2 秒間動かす\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "例:\n  # ライトバーをオレンジに設定\n  ojd controller light 054C:09CC --color FF8000\n  # 色と低い明るさを設定\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "例:\n  # コントローラのモデル用にプロファイルを作成\n  ojd profile create Racing --controller 045E:028E\n  # Safari が最前面にあるときだけ適用\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "例:\n  # プロファイル名を変更\n  ojd profile set Racing name Rally\n  # 最初のスティックマッピングの内側デッドゾーンを設定\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
