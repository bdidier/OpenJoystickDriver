"cli.binding.group.optionLongHold" = "Send another target when the source is held this long, such as 500:key:key-b.";
"cli.binding.group.optionPulseMs" = "How long a pulse holds the target, 1 to 5000 ms. Default: 100.";
"cli.binding.group.optionResponseCurve" = "Axis sources: how output grows with travel. Default: linear.";
