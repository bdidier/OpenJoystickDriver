"platform.macos.cli.diagnose.group.transportExtensionAbsent" = "non enregistrée dans macOS; exécutez « ojd transport-extension activate »";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has the extension active. */
"platform.macos.cli.diagnose.group.transportExtensionActive" = "active dans macOS";
/* Detail of the transport extension check of 'ojd diagnose' when the extension bundle has an unexpected identifier. %@ is that identifier. OpenJoystickDriver is the product name. */
"cli.diagnose.group.transportExtensionBundleInvalid" = "identifiant de bundle inattendu %@; réinstallez OpenJoystickDriver";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is not inside the app. OpenJoystickDriver is the product name. */
"cli.diagnose.group.transportExtensionBundleMissing" = "non intégrée à l’app; réinstallez OpenJoystickDriver";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is inside the app. */
"cli.diagnose.group.transportExtensionBundlePresent" = "intégrée à l’app";
/* Detail of the transport extension check of 'ojd diagnose' when the extension is registered but the user has not approved it. The command in quotes stays as written. */
"cli.diagnose.group.transportExtensionInactive" = "enregistrée mais inactive; approuvez-la avec « ojd transport-extension activate »";
/* Detail of the transport extension check of 'ojd diagnose' when macOS does not report the registration. %@ is the reason from macOS. */
"platform.macos.cli.diagnose.group.transportExtensionUnavailable" = "macOS n’a pas signalé l’enregistrement : %@";
/* Last line of 'ojd diagnose' when checks failed. %lld is the number of failed checks. The command with <path> in quotes stays as written. */
"cli.diagnose.group.failed" = "Vérifications en échec : %lld. Corrigez-les à l’aide des détails ci-dessus, ou exécutez « ojd diagnose --output <path> » et joignez le fichier à un rapport de bogue.";
/* Help text of the --footprint-limit-mib option of 'ojd diagnose'. The physical footprint is the memory charged to the service in MiB, mebibytes. The range 0-65536 is fixed. */
"cli.diagnose.group.footprintLimit" = "Avec --soak, échoue au-delà de cette empreinte physique en MiB; 0 désactive (0-65536).";
/* Help text of the --interval-ms option of 'ojd diagnose'. The range 100-60000 is fixed. */
"cli.diagnose.group.interval" = "Avec --soak, millisecondes entre deux échantillons (100-60000).";
/* Error of 'ojd diagnose' when --interval-ms is out of range. --interval-ms stays as written. */
"cli.diagnose.group.intervalRange" = "--interval-ms doit être compris entre 100 et 60000.";
/* Error of 'ojd diagnose' when a memory limit option is out of range. Both option names stay as written. */
"cli.diagnose.group.limitRange" = "--rss-limit-mib et --footprint-limit-mib doivent être compris entre 0 et 65536.";
/* Detail of a permission check of 'ojd diagnose' when macOS denied the permission. The command in quotes stays as written. */
"cli.diagnose.group.permissionDenied" = "refusée; accordez-la avec « ojd permission request »";
/* Detail of a permission check of 'ojd diagnose' when the state of the permission cannot be read. */
"cli.diagnose.group.permissionUnknown" = "état inconnu";
/* Help text of the --rss-limit-mib option of 'ojd diagnose'. The resident size is the memory of the service held in RAM, in MiB, mebibytes. The range 0-65536 is fixed. */
"cli.diagnose.group.rssLimit" = "Avec --soak, échoue au-delà de cette taille résidente en MiB; 0 désactive (0-65536).";
/* Detail of the service check of 'ojd diagnose' when the service runs. %@ is the version of the service. */
"cli.diagnose.group.serviceRunning" = "en cours d’exécution %@";
/* Detail of the service check of 'ojd diagnose' when the service is stopped. The command in quotes stays as written. */
"cli.diagnose.group.serviceStopped" = "arrêté; démarrez-le avec « ojd service start »";
/* Reason shown for a skipped check of 'ojd diagnose' when the service did not answer. */
"cli.diagnose.group.skipServiceFailed" = "le service n’a pas répondu";
/* Reason shown for a skipped check of 'ojd diagnose' when the service is not running. */
"cli.diagnose.group.skipServiceStopped" = "service arrêté";
/* Help text of the --soak option of 'ojd diagnose'. The number is a count of seconds from 1 to 86400. */
"cli.diagnose.group.soak" = "Échantillonne aussi la mémoire, les descripteurs de fichier et le CPU du service pendant cette durée (1-86400).";
/* Error of the runtime sampling in 'ojd diagnose --soak' when the settings are out of range. %1$lld and %2$lld are the lowest and highest duration in seconds; %3$lld and %4$lld are the lowest and highest interval in ms, milliseconds. The three dots between two numbers mean a range. */
"cli.diagnose.group.soakErrorInvalidConfiguration" = "L’échantillonnage requiert %1$lld...%2$lld secondes et un intervalle d’échantillonnage de %3$lld...%4$lld ms.";
/* Error of the runtime sampling in 'ojd diagnose --soak' when the service returned no sample. */
"cli.diagnose.group.soakErrorNoSamples" = "Le service n’a produit aucun échantillon d’exécution.";
/* Error of the runtime sampling in 'ojd diagnose --soak' when the system does not report the service process. %d is the process ID. */
"cli.diagnose.group.soakErrorProcessUnavailable" = "Impossible de lire les informations d’exécution du processus du service %d.";
/* Detail of the runtime health check of 'ojd diagnose' when --soak is not given. --soak SECONDS stays as written. */
"cli.diagnose.group.soakNotRequested" = "non demandé; utilisez --soak SECONDS";
/* Progress line of 'ojd diagnose --soak'. %@ is the sampling duration, such as 30 seconds. Keep the three dots. */
"cli.diagnose.group.soakProgress" = "Échantillonnage du service pendant %@…";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when the physical footprint passed its limit. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictFootprintLimit" = "Limite d’empreinte mémoire dépassée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when too few samples were taken. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictInsufficientData" = "Données insuffisantes : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when the memory of the service grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictMemoryGrowth" = "Croissance de la mémoire observée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when the resident size passed its limit. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictResidentLimit" = "Limite de taille résidente dépassée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when resources such as file descriptors grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictResourceGrowth" = "Croissance des ressources observée : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Verdict of the runtime health check of 'ojd diagnose --soak' when nothing grew during sampling. %1$.1f is the resident size in MiB, %2$.1f is the footprint in MiB, %3$lld is the number of open file descriptors, %4$.1f is the CPU load in percent and %5$.0f is the sampling time in seconds. The double percent sign prints one percent sign. */
"cli.diagnose.group.soakVerdictStable" = "Stable : taille résidente %1$.1f MiB, empreinte mémoire %2$.1f MiB, descripteurs de fichier %3$lld, processeur %4$.1f %% sur %5$.0f s";
/* Error of 'ojd diagnose' when --soak is out of range. --soak stays as written. The range is fixed. */
"cli.diagnose.group.soakRange" = "--soak doit être compris entre 1 et 86400 secondes.";
