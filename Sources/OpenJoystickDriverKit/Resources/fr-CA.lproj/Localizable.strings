"cli.binding.group.optionDigitalThreshold" = "Sources d’axe : la course qui compte comme un appui pour les cibles de type bouton. Par défaut : 0.5.";
/* Help text of the --double-tap option of 'ojd binding set'. The example 300:key:key-c stays as written. */
