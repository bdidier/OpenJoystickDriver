"platform.macos.cli.access.grant.adHoc" = "%@ est signé ad hoc ou non signé, donc n’importe quel programme local peut revendiquer sa signature. Signez-le avec un certificat Developer ID ou Apple Development, puis autorisez-le.";
"platform.macos.cli.access.grant.platformWarning" = "Apple a signé ce programme. S’il exécute des scripts, comme python3 ou osascript, chaque script qu’il exécute obtient cet accès.";
"cli.access.grant.clientOrToken" = "Indiquez soit CLIENT, soit --token NAME.";
"cli.access.grant.confirm" = "Autoriser %1$@, signé %2$@, à utiliser le point d’accès avec %3$@?";
"cli.access.grant.controlWarning" = "La portée control permet au programme d’appuyer sur les boutons d’une manette virtuelle, que les jeux et les apps traitent comme votre saisie.";
"cli.access.grant.discussion" = "CLIENT est le chemin du programme ou un identifiant issu de « ojd access list ». L’autorisation désigne la signature du programme; elle reste donc valide quand le programme est mis à jour ou déplacé. Les programmes signés ad hoc et non signés ne peuvent pas être autorisés. Avec --token à la place de CLIENT, crée un jeton avec lequel un client signe le défi du service dans son hello, sur le socket, sur le WebSocket depuis une page de l’une des valeurs de --origin ou, pour un jeton sans --origin, sur le WebSocket depuis un programme qui n’envoie aucun en-tête Origin, comme une app en bac à sable. Une page ne peut pas utiliser la portée control. Le jeton n’est affiché qu’une seule fois. Demande d’abord une confirmation.";
"cli.access.grant.origin" = "Une origine web, comme http://127.0.0.1:8080, dont les pages peuvent utiliser le jeton sur le WebSocket. À répéter pour en ajouter. Les pages d’overlay que sert le WebSocket ont pour origine http://127.0.0.1:PORT, avec le port qu’affiche « ojd access status ».";
"cli.access.grant.originControl" = "--origin ne peut pas être combiné avec la portée control. Une page ne pilote jamais une manette virtuelle; accordez control à un jeton sans --origin.";
