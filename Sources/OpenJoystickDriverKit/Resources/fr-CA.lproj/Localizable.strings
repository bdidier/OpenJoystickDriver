/* One-line summary of 'ojd explain' in the command list and at the top of its help. */
"cli.explain.group.abstract" = "Explique un code d’erreur : sa signification et comment y remédier.";
/* Long description in the help of 'ojd explain'. ojd explain stays as written. The code case does not matter, so E2004 and e2004 are the same. */
"cli.explain.group.discussion" = "ojd explain couvre tous les codes d’erreur. La commande fonctionne hors ligne, et la casse du code n’a pas d’importance.";
/* Help text of the CODE argument of 'ojd explain'. E2004 is an example of an error code and stays as written. */
"cli.explain.group.code" = "Le code d’erreur, par exemple E2004.";
/* Error of 'ojd explain' when the code does not exist. %@ is the text the user gave. Error-Codes is the name of a wiki page and stays as written. */
"cli.explain.group.unknown" = "%@ n’est pas un code d’erreur actif. Vérifiez l’orthographe; la page Error-Codes du wiki liste tous les codes.";
/* Line of the output of 'ojd explain' that names the area of the error. %@ is the area name, one of the area labels. */
"cli.explain.group.area" = "Domaine : %@";
/* Area label in the output of 'ojd explain' for errors of the endpoint that programs connect to. */
"cli.explain.group.areaEndpoint" = "Point de terminaison";
/* Area label in the output of 'ojd explain' for errors of the command line. */
"cli.explain.group.areaCli" = "Ligne de commande";
/* Area label in the output of 'ojd explain' for errors of button remapping. */
"cli.explain.group.areaRemapping" = "Réaffectation";
/* Area label in the output of 'ojd explain' for errors of mod packages, the packages that add controller support. */
"cli.explain.group.areaMod" = "Paquets de mods";
/* Area label in the output of 'ojd explain' for errors of the documents that the driver reads, such as profiles and records. */
"cli.explain.group.areaDocument" = "Fichiers de configuration";
/* Line of the output of 'ojd explain' with the exit status that the command ends with for this error. %@ is the number. */
"cli.explain.group.exitCode" ="Code de sortie : %@";
/* Line of the output of 'ojd explain' with the wire value of the code, which other programs read. %@ is that value and stays as written. */
"cli.explain.group.wire" = "Valeur de transmission : %@";
/* Error when the installed app is older than the repository sources that built this ojd. The build command, the environment variable OJD_RUN_REPOSITORY_CLI=1 and OpenJoystickDriver.app stay as written. */
"cli.shared.error.staleInstallation" = "L’application OpenJoystickDriver.app installée est plus ancienne que ces sources du dépôt. Exécutez « ./Scripts/ojd build install-fast dev » ou définissez OJD_RUN_REPOSITORY_CLI=1 pour exécuter cette version.";
/* Error when ojd cannot hand the command line to the installed ojd. ojd stays as written. */
"cli.shared.error.forwarderAllocation" = "Impossible de réserver les arguments pour l’ojd installé. Relancez la commande.";
/* Error when ojd cannot start the installed ojd. %@ is the reason from the system. OpenJoystickDriver.app stays as written. */
"cli.shared.error.forwarderExec" = "Impossible d’exécuter l’ojd installé : %@. Réinstallez OpenJoystickDriver.app.";
/* Text of error E2001, printed when ojd meets a failure that has no code of its own. ojd and the command in quotes stay as written. */
"error.E2001.message" = "ojd a rencontré une erreur qu’il ne reconnaît pas. Exécutez « ojd diagnose » et signalez le problème avec sa sortie.";
/* Text of error E2002, printed when the first word after ojd is not a command. ojd and the command in quotes stay as written. */
"error.E2002.message" = "Ce n’est pas une commande d’ojd. Exécutez « ojd --help » pour voir les commandes.";
/* Text of error E2003, printed when the options or values of a command are wrong or missing. --help stays as written. */
"error.E2003.message" = "La ligne de commande contient une option ou une valeur incorrecte ou manquante. Exécutez la commande avec --help pour voir ce qu’elle attend.";
/* Text of error E2004, printed when a command needs the service and it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2004.message" = "Le service OpenJoystickDriver n’est pas en cours d’exécution. Démarrez-le avec « ojd service start ».";
/* Text of error E2005, printed when the service does not answer in time. The command in quotes and --timeout stay as written. */
"error.E2005.message" = "Le service n’a pas répondu à temps. Vérifiez-le avec « ojd status » ou attendez plus longtemps avec --timeout.";
/* Text of error E2006, printed when the service reports that it could not complete a request. The command in quotes stays as written. */
"error.E2006.message" = "Le service n’a pas terminé la requête. Vérifiez-le avec « ojd status » et réessayez.";
/* Text of error E2007, printed when the service refuses this ojd because its code signature differs from the app. ojd and OpenJoystickDriver.app stay as written. */
"error.E2007.message" = "Le service a refusé cet ojd car il n’est pas signé comme l’application. Exécutez l’ojd fourni dans OpenJoystickDriver.app.";
/* Text of error E2008, printed when a command needs a macOS permission that is missing. The command in quotes stays as written. */
"error.E2008.message" = "Une autorisation manque. Accordez-la avec « ojd permission request ».";
/* Text of error E2009, printed when a command that changes or deletes data runs without a terminal and without --force. --force stays as written. */
"error.E2009.message" = "Cette commande modifie ou supprime des données et demande une confirmation. Relancez-la avec --force.";
/* Text of error E2010, printed when a command stops before it finishes because the user declined, an editor failed or no input came. */
"error.E2010.message" = "La commande s’est arrêtée avant la fin parce que vous avez refusé, qu’un éditeur a échoué ou qu’aucune entrée n’est arrivée. Relancez-la.";
/* Text of error E2011, printed when a profile file or a record file is not valid against its schema. */
"error.E2011.message" = "Le fichier de profil ou de fiche de manette n’est pas valide. Corrigez-le d’après son schéma et réessayez.";
/* Text of error E2012, printed when a name matches no controller, profile, binding or client, or matches more than one. The word list in quotes is the name of the matching list command and stays as written. */
"error.E2012.message" = "Aucune manette, aucun profil, aucune affectation ni aucun client ne correspond, ou plusieurs correspondent. Listez-les avec la commande « list » appropriée et désignez-en un seul.";
/* Text of error E2013, printed when the controller cannot take a requested action. The command in quotes stays as written. */
"error.E2013.message" = "La manette ne peut pas faire cela pour le moment. Elle n’est peut-être pas prise en charge, pas prête ou déconnectée. Vérifiez-la avec « ojd controller list ».";
/* Text of error E2014, printed when the app is not fully installed or its signature is not valid. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2014.message" = "OpenJoystickDriver n’est pas entièrement installé ou sa signature n’est pas valide. Réinstallez l’application et exécutez « ojd diagnose ».";
/* Text of error E2015, printed when macOS does not complete or apply a request of the driver. */
"error.E2015.message" = "Le système n’a pas terminé ou appliqué la requête. Vérifiez les réglages système et réessayez.";
/* Text of error E2016, printed when a file cannot be read, written or deleted, or is present although it must not be. */
"error.E2016.message" = "Un fichier n’a pas pu être lu, écrit ou supprimé, ou il existe déjà. Vérifiez le chemin et ses autorisations.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Ce client n’est pas signé ou est signé ad hoc, il ne peut donc pas obtenir l’accès. Signez-le avec un Developer ID et réessayez.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "« ojd diagnose » a trouvé une vérification en échec. Lisez sa sortie et corrigez les éléments en échec.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "La recherche de mises à jour ne s’est pas terminée. Vérifiez votre connexion réseau et réessayez.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "L’application OpenJoystickDriver installée est plus ancienne que cet ojd. Exécutez « ./Scripts/ojd build install-fast dev » ou définissez OJD_RUN_REPOSITORY_CLI=1 pour exécuter cette version.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Une version d’ojd issue du dépôt n’a pas pu transmettre la commande à l’application installée. Réinstallez OpenJoystickDriver.app et relancez la commande.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "La manette n’est pas connectée ou n’est pas prête pour le remappage. Reconnectez-la et réessayez.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "Les Joy-Con sélectionnés n’ont pas pu être appairés. Actualisez les manettes connectées et réessayez.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "La manette ne signale pas de données de mouvement. Choisissez une manette dotée de capteurs de mouvement ou laissez les options de mouvement désactivées.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Une valeur de la requête est plus grande que ce que le service accepte. Envoyez une valeur plus petite.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "La liste des profils actifs est corrompue et n’a pas pu être chargée. Réparez ou supprimez le fichier corrompu et réessayez.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "Un profil portant ce nom existe déjà. Choisissez un autre nom; « ojd profile list » affiche les noms utilisés.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "La requête contient des arguments manquants ou non valides. Vérifiez les valeurs et réessayez.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "Le profil n’est pas valide. Vérifiez les affectations et réessayez.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "La bibliothèque de profils deviendrait trop grande. Supprimez les profils dont vous n’avez pas besoin et réessayez.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "Un profil portant cet identifiant existe déjà. Utilisez un nouvel identifiant ou mettez à jour le profil existant.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "Le profil a été modifié ailleurs après son chargement. Rechargez-le et refaites votre modification.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "La bibliothèque contient déjà le nombre maximal de profils autorisé. Supprimez un profil dont vous n’avez pas besoin et réessayez.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "Aucun profil n’a cet identifiant. Listez les profils avec « ojd profile list ».";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "Le service n’a pas pu encoder sa réponse. Réessayez et signalez le problème s’il persiste.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "La réponse est plus grande que ce que le service peut envoyer. Demandez moins de données et réessayez.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "Le moteur de remappage n’est pas disponible. Patientez un instant et réessayez, ou redémarrez le service.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "La bibliothèque de profils et le moteur de remappage ne sont pas disponibles. Patientez un instant et réessayez, ou redémarrez le service.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "La bibliothèque de profils n’est pas disponible. Patientez un instant et réessayez, ou redémarrez le service.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "Le routeur de remappage a été arrêté. Redémarrez le service et réessayez.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "Le service n’a pas pu confirmer que la dernière modification de profil a été enregistrée. Rechargez les profils et vérifiez-les avant de les modifier à nouveau.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "Un fichier de profil n’a pas pu être lu. Vérifiez que le fichier existe et que le service peut le lire.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "Les fichiers de profil corrompus doivent être réparés ou supprimés avant de pouvoir modifier les profils. Réparez-les ou supprimez-les et réessayez.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "Un fichier de profil n’a pas pu être écrit. Vérifiez l’espace disque libre et les autorisations du dossier.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "Le service de remappage a rencontré une erreur qu’il ne reconnaît pas. Exécutez « ojd diagnose » et signalez le problème avec sa sortie.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "Le profil ne produit aucune sortie. Ajoutez-lui une affectation ou une couleur de voyant, ou activez-le avec --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "Le profil de la paire de Joy-Con prend le gyroscope de l’autre Joy-Con. Calibrez le mouvement de la manette que le profil sélectionne pour le gyroscope.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Aucun profil de remappage n’est actif pour la manette, elle ne traite donc pas le mouvement. Activez un profil pour elle, amenez l’app cible au premier plan et réessayez.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "La session de remappage de la manette a changé pendant la requête. Réessayez.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Un profil provenant d’un paquet installé ne peut pas être modifié. Dupliquez le profil et modifiez la copie.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.json stays as written. */
"error.E4001.message" = "Le manifeste du paquet mod.json est absent ou invalide. Vérifiez-le avec le schéma mod-package et relancez la commande.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "Le paquet exige une autre version d’OpenJoystickDriver que celle qui s’exécute. Installez une version du paquet compatible avec cette version ou mettez OpenJoystickDriver à jour.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.json stays as written. */
"error.E4003.message" = "Un fichier du paquet est invalide, absent ou non listé dans mod.json. Corrigez le fichier indiqué par la commande et relancez-la.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "Le paquet couvre une manette, une persona ou un profil que vos propres fichiers ou un autre paquet installé contiennent déjà. Supprimez le fichier ou le paquet en conflit, ou modifiez le paquet, puis relancez la commande.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Un paquet portant ce nom est déjà installé. Lancez la commande avec --force pour le remplacer.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Aucun paquet installé ne porte ce nom. Lancez ojd mod list pour voir les paquets installés.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "Le dossier des paquets n’a pas pu être modifié. Vérifiez l’espace disque libre et les autorisations du dossier.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Un document n’a pas d’apiVersion, ou son apiVersion n’est pas prise en charge par cette version d’OpenJoystickDriver. Remplacez-la dans le document par l’apiVersion prise en charge que le message indique, puis relancez la commande.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Une description de protocole n’est pas valide. Vérifiez le fichier avec le schéma protocol-description et corrigez le champ que le message nomme.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Une description de protocole nomme une famille différente du nom de son fichier. Nommez le fichier d’après sa famille.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Une description de protocole liste une variante que sa famille n’a pas. Utilisez l’une des variantes de la famille.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.json is a file name and stays as written. */
"error.E5005.message" = "Le fichier d’accès AccessGrants.json est endommagé. Corrigez le fichier ou supprimez-le, puis accordez de nouveau l’accès.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Le fichier de clé des identifiants d’unité, PortKeyInstallation.key, est illisible ou ne fait pas 32 octets. Restaurez le fichier depuis une sauvegarde. Si vous le supprimez, OpenJoystickDriver crée une nouvelle clé et chaque identifiant d’unité change.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Une fiche de manette ou un patch n’est pas valide. Vérifiez le fichier avec son schéma et corrigez le champ que le message nomme.";
"ui.error.withCode" = "%1$@ (%2$@)";

