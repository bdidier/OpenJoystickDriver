"cli.controller.calibrate.abstract" = "Mostra o modifica la calibrazione del movimento di un controller.";
/* Help text of the ACTION argument of 'ojd controller calibrate'. start, pause and reset are values the user types and stay as written. */
"cli.controller.calibrate.action" = "Cosa fare: start, pause o reset. Omettilo per stampare la calibrazione.";
