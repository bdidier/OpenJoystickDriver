/* One-line summary of 'ojd explain' in the command list and at the top of its help. */
"cli.explain.group.abstract" = "Spiega un codice di errore: cosa significa e come risolverlo.";
/* Long description in the help of 'ojd explain'. ojd explain stays as written. The code case does not matter, so E2004 and e2004 are the same. */
"cli.explain.group.discussion" = "ojd explain copre tutti i codici di errore. Funziona offline e le maiuscole o minuscole del codice non contano.";
/* Help text of the CODE argument of 'ojd explain'. E2004 is an example of an error code and stays as written. */
"cli.explain.group.code" = "Il codice di errore, ad esempio E2004.";
/* Error of 'ojd explain' when the code does not exist. %@ is the text the user gave. Error-Codes is the name of a wiki page and stays as written. */
"cli.explain.group.unknown" = "%@ non è un codice di errore attivo. Controlla l’ortografia; la pagina Error-Codes della wiki elenca tutti i codici.";
/* Line of the output of 'ojd explain' that names the area of the error. %@ is the area name, one of the area labels. */
"cli.explain.group.area" = "Ambito: %@";
/* Area label in the output of 'ojd explain' for errors of the endpoint that programs connect to. */
"cli.explain.group.areaEndpoint" = "Punto di accesso";
/* Area label in the output of 'ojd explain' for errors of the command line. */
"cli.explain.group.areaCli" = "Riga di comando";
/* Area label in the output of 'ojd explain' for errors of button remapping. */
"cli.explain.group.areaRemapping" = "Rimappatura";
/* Area label in the output of 'ojd explain' for errors of mod packages, the packages that add controller support. */
"cli.explain.group.areaMod" = "Pacchetti mod";
/* Area label in the output of 'ojd explain' for errors of the documents that the driver reads, such as profiles and records. */
"cli.explain.group.areaDocument" = "Documenti";
/* Line of the output of 'ojd explain' with the exit status that the command ends with for this error. %@ is the number. */
"cli.explain.group.exitCode" ="Codice di uscita: %@";
/* Line of the output of 'ojd explain' with the wire value of the code, which other programs read. %@ is that value and stays as written. */
"cli.explain.group.wire" = "Valore di trasmissione: %@";
/* Error when the installed app is older than the repository sources that built this ojd. The build command, the environment variable OJD_RUN_REPOSITORY_CLI=1 and OpenJoystickDriver.app stay as written. */
"cli.shared.error.staleInstallation" = "L’app OpenJoystickDriver.app installata è più vecchia di questi sorgenti del repository. Esegui «./Scripts/ojd build install-fast dev» oppure imposta OJD_RUN_REPOSITORY_CLI=1 per eseguire questa build.";
/* Error when ojd cannot hand the command line to the installed ojd. ojd stays as written. */
"cli.shared.error.forwarderAllocation" = "Impossibile riservare gli argomenti per l’ojd installato. Esegui di nuovo il comando.";
/* Error when ojd cannot start the installed ojd. %@ is the reason from the system. OpenJoystickDriver.app stays as written. */
"cli.shared.error.forwarderExec" = "Impossibile eseguire l’ojd installato: %@. Reinstalla OpenJoystickDriver.app.";
/* Text of error E2001, printed when ojd meets a failure that has no code of its own. ojd and the command in quotes stay as written. */
"error.E2001.message" = "ojd ha incontrato un errore che non riconosce. Esegui «ojd diagnose» e segnala il problema insieme al suo output.";
/* Text of error E2002, printed when the first word after ojd is not a command. ojd and the command in quotes stay as written. */
"error.E2002.message" = "Questo non è un comando di ojd. Esegui «ojd --help» per vedere i comandi.";
/* Text of error E2003, printed when the options or values of a command are wrong or missing. --help stays as written. */
"error.E2003.message" = "La riga di comando contiene un’opzione o un valore errato o mancante. Esegui il comando con --help per vedere cosa si aspetta.";
/* Text of error E2004, printed when a command needs the service and it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2004.message" = "Il servizio OpenJoystickDriver non è in esecuzione. Avvialo con «ojd service start».";
/* Text of error E2005, printed when the service does not answer in time. The command in quotes and --timeout stay as written. */
"error.E2005.message" = "Il servizio non ha risposto in tempo. Controllalo con «ojd status» oppure attendi più a lungo con --timeout.";
/* Text of error E2006, printed when the service reports that it could not complete a request. The command in quotes stays as written. */
"error.E2006.message" = "Il servizio non ha completato la richiesta. Controllalo con «ojd status» e riprova.";
/* Text of error E2007, printed when the service refuses this ojd because its code signature differs from the app. ojd and OpenJoystickDriver.app stay as written. */
"error.E2007.message" = "Il servizio ha rifiutato questo ojd perché non è firmato come l’app. Esegui l’ojd incluso in OpenJoystickDriver.app.";
/* Text of error E2008, printed when a command needs a macOS permission that is missing. The command in quotes stays as written. */
"error.E2008.message" = "Manca un’autorizzazione. Concedila con «ojd permission request».";
/* Text of error E2009, printed when a command that changes or deletes data runs without a terminal and without --force. --force stays as written. */
"error.E2009.message" = "Questo comando modifica o elimina dati e richiede conferma. Eseguilo di nuovo con --force.";
/* Text of error E2010, printed when a command stops before it finishes because the user declined, an editor failed or no input came. */
"error.E2010.message" = "Il comando si è interrotto prima di finire perché hai rifiutato, un editor ha fallito o non è arrivato alcun input. Eseguilo di nuovo.";
/* Text of error E2011, printed when a profile file or a record file is not valid against its schema. */
"error.E2011.message" = "Il file di profilo o di record non è valido. Correggilo in base al suo schema e riprova.";
/* Text of error E2012, printed when a name matches no controller, profile, binding or client, or matches more than one. The word list in quotes is the name of the matching list command and stays as written. */
"error.E2012.message" = "Nessun controller, profilo, associazione o client corrisponde, oppure ne corrisponde più di uno. Elencali con il comando «list» appropriato e indicane esattamente uno.";
/* Text of error E2013, printed when the controller cannot take a requested action. The command in quotes stays as written. */
"error.E2013.message" = "Il controller non può farlo ora. Potrebbe non essere supportato, non essere pronto o essere scollegato. Controllalo con «ojd controller list».";
/* Text of error E2014, printed when the app is not fully installed or its signature is not valid. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2014.message" = "OpenJoystickDriver non è installato completamente o la sua firma non è valida. Reinstalla l’app ed esegui «ojd diagnose».";
/* Text of error E2015, printed when macOS does not complete or apply a request of the driver. */
"error.E2015.message" = "Il sistema non ha completato o applicato la richiesta. Controlla le impostazioni di sistema e riprova.";
/* Text of error E2016, printed when a file cannot be read, written or deleted, or is present although it must not be. */
"error.E2016.message" = "Non è stato possibile leggere, scrivere o eliminare un file, oppure esiste già. Controlla il percorso e i suoi permessi.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Quel client non è firmato o è firmato ad hoc, quindi non può ottenere l’accesso. Firmalo con un Developer ID e riprova.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "«ojd diagnose» ha trovato un controllo non riuscito. Leggi il suo output e correggi gli elementi non riusciti.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "Il controllo degli aggiornamenti non è terminato. Controlla la connessione di rete e riprova.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "L’app OpenJoystickDriver installata è più vecchia di questo ojd. Esegui «./Scripts/ojd build install-fast dev» oppure imposta OJD_RUN_REPOSITORY_CLI=1 per eseguire questa build.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Una build di ojd del repository non è riuscita a passare il comando all’app installata. Reinstalla OpenJoystickDriver.app ed esegui di nuovo il comando.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "Il controller non è collegato o non è pronto per la rimappatura. Ricollegalo e riprova.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "Non è stato possibile abbinare i Joy-Con selezionati. Aggiorna i controller collegati e riprova.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "Il controller non segnala dati di movimento. Scegli un controller con sensori di movimento oppure lascia disattivate le opzioni di movimento.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Un valore nella richiesta è più grande di quello che il servizio accetta. Invia un valore più piccolo.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "L’elenco dei profili attivi è danneggiato e non è stato possibile caricarlo. Ripara o rimuovi il file danneggiato e riprova.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "Esiste già un profilo con questo nome. Scegli un altro nome; «ojd profile list» mostra i nomi in uso.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "La richiesta ha argomenti mancanti o non validi. Controlla i valori e riprova.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "Il profilo non è valido. Controlla le assegnazioni e riprova.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "La libreria dei profili diventerebbe troppo grande. Elimina i profili che non ti servono e riprova.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "Esiste già un profilo con questo identificatore. Usa un nuovo identificatore o aggiorna il profilo esistente.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "Il profilo è stato modificato altrove dopo averlo caricato. Ricaricalo e rifai la modifica.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "La libreria contiene già il numero massimo di profili consentito. Elimina un profilo che non ti serve e riprova.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "Nessun profilo ha questo identificatore. Elenca i profili con «ojd profile list».";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "Il servizio non è riuscito a codificare la sua risposta. Riprova e segnala il problema se persiste.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "La risposta è più grande di quanto il servizio possa inviare. Richiedi meno dati e riprova.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "Il motore di rimappatura non è disponibile. Attendi un momento e riprova, oppure riavvia il servizio.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "La libreria dei profili e il motore di rimappatura non sono disponibili. Attendi un momento e riprova, oppure riavvia il servizio.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "La libreria dei profili non è disponibile. Attendi un momento e riprova, oppure riavvia il servizio.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "Il router di rimappatura è stato arrestato. Riavvia il servizio e riprova.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "Il servizio non è riuscito a confermare se l’ultima modifica al profilo è stata salvata. Ricarica i profili e controllali prima di modificarli di nuovo.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "Non è stato possibile leggere un file di profilo. Controlla che il file esista e che il servizio possa leggerlo.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "I file di profilo danneggiati devono essere riparati o rimossi prima di poter modificare i profili. Riparali o rimuovili e riprova.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "Non è stato possibile scrivere un file di profilo. Controlla lo spazio libero su disco e i permessi della cartella.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "Il servizio di rimappatura ha incontrato un errore che non riconosce. Esegui «ojd diagnose» e segnala il problema insieme al suo output.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "Il profilo non produce alcun output. Aggiungi un’assegnazione o un colore della luce, oppure attivalo con --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "Il profilo della coppia di Joy-Con prende il giroscopio dall’altro Joy-Con. Calibra il movimento del controller che il profilo seleziona per il giroscopio.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Nessun profilo di rimappatura è attivo per il controller, quindi non elabora il movimento. Attiva un profilo per il controller, porta in primo piano l’app di destinazione e riprova.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "La sessione di rimappatura del controller è cambiata mentre la richiesta era in corso. Riprova.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Un profilo proveniente da un pacchetto installato non può essere modificato. Duplica il profilo e modifica la copia.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.json stays as written. */
"error.E4001.message" = "Il manifesto del pacchetto mod.json è mancante o non valido. Controllalo con lo schema mod-package ed esegui di nuovo il comando.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "Il pacchetto richiede una versione di OpenJoystickDriver diversa da quella in esecuzione. Installa una versione del pacchetto compatibile con questa versione oppure aggiorna OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.json stays as written. */
"error.E4003.message" = "Un file del pacchetto non è valido, manca o non è elencato in mod.json. Correggi il file indicato dal comando ed eseguilo di nuovo.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "Il pacchetto copre un controller, una persona o un profilo già presenti nei tuoi file o in un altro pacchetto installato. Rimuovi il file o il pacchetto in conflitto, oppure modifica il pacchetto, ed esegui di nuovo il comando.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Un pacchetto con questo nome è già installato. Esegui il comando con --force per sostituirlo.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Nessun pacchetto installato ha questo nome. Esegui ojd mod list per vedere i pacchetti installati.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "Non è stato possibile modificare la cartella dei pacchetti. Controlla lo spazio libero su disco e i permessi della cartella.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Un documento non ha apiVersion, oppure la sua apiVersion non è supportata da questa versione di OpenJoystickDriver. Cambia il documento con l’apiVersion supportata indicata dal messaggio ed esegui di nuovo il comando.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Una descrizione di protocollo non è valida. Controlla il file con lo schema protocol-description e correggi il campo indicato dal messaggio.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Una descrizione di protocollo indica una famiglia diversa dal nome del suo file. Dai al file il nome della sua famiglia.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Una descrizione di protocollo elenca una variante che la sua famiglia non ha. Usa una delle varianti della famiglia.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.json is a file name and stays as written. */
"error.E5005.message" = "Il file di accesso AccessGrants.json è danneggiato. Correggi il file o eliminalo, poi concedi di nuovo l’accesso.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Il file della chiave degli ID unità, PortKeyInstallation.key, non può essere letto o non è di 32 byte. Ripristina il file da un backup. Se invece lo elimini, OpenJoystickDriver crea una nuova chiave e ogni ID unità cambia.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Un record del controller o una patch non è valido. Controlla il file con il suo schema e correggi il campo indicato dal messaggio.";
"ui.error.withCode" = "%1$@ (%2$@)";

