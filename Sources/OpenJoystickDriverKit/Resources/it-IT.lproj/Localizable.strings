/* Line printed by 'ojd record draft' with the number of input reports it captured. %lld is that number. */
"cli.record.draft.captured" = "Report di input acquisiti: %lld.";
/* Line printed by 'ojd record draft' for a byte that changed between reports. %1$lld is the byte position, %2$lld is the value before and %3$lld is the value after. */
"cli.record.draft.changedByte" = "Il byte %1$lld è cambiato: da %2$lld a %3$lld.";
/* Long description in the help of 'ojd record draft'. HID report descriptor and input report are terms of the USB HID standard. */
"cli.record.draft.discussion" = "Legge il descrittore di report HID del controller e acquisisce i suoi report di input mentre premi ogni controllo, poi stampa un record da cui partire. Il record associa i pulsanti, gli stick, i grilletti e il tasto direzionale che il descrittore indica in modo chiaro. I byte cambiati durante l’acquisizione mostrano dove si trovano gli altri controlli. Richiede il servizio.";
/* Help text of the duration option of 'ojd record draft'. */
"cli.record.draft.duration" = "Acquisisce i report di input per questo numero di secondi.";
/* Hint printed after 'ojd record draft'. The command in quotes stays as written, including FILE. */
"cli.record.draft.next" = "Salva il record in un file, controlla ogni controllo e poi esegui «ojd record validate FILE».";
/* Message of 'ojd record draft' when the descriptor of the controller yields no controls and the bundled record names the family. %1$@ is the controller identity, VVVV:PPPP, and %2$@ repeats it as the argument of the command in quotes, which stays as written. */
"cli.record.draft.noLayout" = "Non è stato possibile leggere nessun controllo di %1$@ dal suo descrittore di report HID e il suo record incluso ne indica già la famiglia. «ojd record show %2$@» mostra quel record.";
/* Prompt of 'ojd record draft' while it captures reports. %1$@ is the controller name and %2$@ is its vendor and product ID. */
"cli.record.draft.started" = "Premi ogni controllo su %1$@ (%2$@) e muovi ogni levetta e ogni grilletto.";
/* Error of the 'ojd record' commands when a record file cannot be read. %1$@ is the file path and %2$@ is the reason from the system. */
"cli.record.group.errorUnreadable" = "Impossibile leggere %1$@: %2$@";
/* Help text of the file argument of the 'ojd record' commands. The single hyphen means stdin and stays as written. */
"cli.record.group.file" = "Un file di record, oppure - per leggere il record da stdin.";
/* Help text of the controller model argument of the 'ojd record' commands. VVVV:PPPP is the vendor ID and product ID in hexadecimal and stays as written. */
"cli.record.group.identity" = "Il modello di controller, come VVVV:PPPP.";
/* One-line summary of 'ojd record install' in the command list and at the top of its help. */
"cli.record.install.abstract" = "Controlla un record del controller e lo installa per il tuo utente.";
/* Yes or no question that 'ojd record install' asks on a terminal before it replaces an installed record. %@ is the path of the installed file. */
"cli.record.install.confirm" = "Sostituire %@?";
/* Long description in the help of 'ojd record install'. VVVV-PPPP.json and --force stay as written. */
"cli.record.install.discussion" = "Scrive il record come VVVV-PPPP.json nella tua cartella dei record. Il servizio in esecuzione lo applica subito. Sostituire il record già installato per quel modello chiede conferma in un terminale; altrimenti serve --force. --dry-run controlla il record e non scrive nulla. Termina con 1 e non scrive nulla se il record non è valido.";
/* Message printed by 'ojd record install --dry-run' instead of installing. %@ is the target file path. */
"cli.record.install.dryRun" = "Installerebbe %@.";
/* Error when the record file cannot be written. %1$@ is the target file path and %2$@ is the reason from the system. */
"cli.record.install.failed" = "Impossibile scrivere %1$@: %2$@";
/* Message printed after 'ojd record install'. %@ is the target file path. The service picks the record up without a restart. */
"cli.record.install.success" = "Installato: %@. Il servizio in esecuzione lo applica ora.";
/* Error of the 'ojd record' commands when a record is invalid. %1$@ is the file path or the word stdin and %2$@ is the description of the problem. */
"cli.record.group.invalid" = "%1$@ non è un record valido: %2$@";
/* One-line summary of 'ojd record list' in the command list and at the top of its help. */
"cli.record.list.abstract" = "Elenca ogni record del controller e il livello da cui proviene.";
/* Help text of the flag of 'ojd record list' that limits the list to the bundled catalog. The bundled catalog is the set of records inside the app. */
"cli.record.list.bundled" = "Elenca solo il catalogo incluso.";
/* Long description in the help of 'ojd record list'. OJD is the short product name. */
"cli.record.list.discussion" = "Elenca i record inclusi con i tuoi record applicati e indica ogni file che OJD ha ignorato e perché.";
/* One-line summary of 'ojd record remove' in the command list and at the top of its help. */
"cli.record.remove.abstract" = "Elimina il tuo record del controller per un modello di controller.";
/* Yes or no question that 'ojd record remove' asks on a terminal. %@ is the list of files to delete. */
"cli.record.remove.confirm" = "Eliminare %@?";
/* Long description in the help of 'ojd record remove'. --force stays as written. */
"cli.record.remove.discussion" = "Un modello incluso torna al suo record incluso. Chiede conferma in un terminale; altrimenti serve --force.";
/* Message printed by 'ojd record remove --dry-run' instead of deleting. %@ is the list of files. */
"cli.record.remove.dryRun" = "Eliminerebbe %@.";
/* Error of 'ojd record remove' when a file cannot be deleted. %1$@ is the file path and %2$@ is the reason from the system. */
"cli.record.remove.failed" = "Impossibile eliminare %1$@: %2$@";
/* Error of 'ojd record remove' when the user has no record for the model. %@ is the model, VVVV:PPPP. The command in quotes stays as written. */
"cli.record.remove.notFound" = "Non hai alcun record per %@. «ojd record list» mostra i tuoi record.";
/* Message printed after 'ojd record remove'. %@ is the list of deleted files. */
"cli.record.remove.success" = "Eliminato: %@.";
/* One-line summary of 'ojd record show' in the command list and at the top of its help. */
"cli.record.show.abstract" = "Mostra il record effettivo di un modello di controller e il livello di ogni parte.";
/* Error of 'ojd record show' and 'ojd config show' when no record matches the model. %@ is the model, VVVV:PPPP. The command in quotes stays as written. */
"cli.record.show.notFound" = "Nessun record del controller per %@. «ojd record list» mostra ogni record.";
/* Line of the output of 'ojd record list' for a record file the driver skipped. %1$@ is the file name and %2$@ is the reason. */
"cli.record.group.skipped" = "Ignorato %1$@: %2$@";
/* One-line summary of 'ojd record test' in the command list and at the top of its help. A parser turns the packets of a controller into its state. */
"cli.record.test.abstract" = "Riproduce i report acquisiti con il parser di un record e confronta lo stato analizzato.";
/* Error of 'ojd record test' when the capture file is not a packet capture. %1$@ is the file path and %2$@ is the line number and the problem found on that line. */
"cli.record.test.captureInvalid" = "%1$@ non è un’acquisizione di pacchetti: %2$@";
/* Line of the output of 'ojd record test' for each field of the controller state that differs. %1$@ is the field name, %2$@ is the expected value and %3$@ is the value found. */
"cli.record.test.difference" = "%1$@: atteso %2$@, ottenuto %3$@";
/* Long description in the help of 'ojd record test'. The command in quotes and the JSON terms stay as written. */
"cli.record.test.discussion" = "Riproduce i pacchetti ricevuti in un’acquisizione con il parser del record, poi confronta lo stato del controller dopo l’ultimo report di input con lo stato atteso. L’acquisizione è costituita dalle righe JSON di «ojd controller capture --json». Lo stato atteso è un oggetto JSON nella forma di una riga di «ojd controller watch --json». Il comando elenca ogni campo diverso e termina con codice 1 se ce n’è almeno uno. Confronta tutti i campi tranne connection, che imposta il servizio in esecuzione. Non richiede un servizio in esecuzione.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "Lo stato atteso del controller, come file JSON.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ non è uno stato del controller: %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "Nessun report in %1$@ conteneva input per %2$@. Acquisisci di nuovo mentre premi i comandi.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "La famiglia di %@ non ha un parser che funzioni senza un controller.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "Un’acquisizione di pacchetti, come righe JSON di «ojd controller capture --json».";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "Il parser di %1$@ ha rifiutato il pacchetto ricevuto %2$lld di %3$@.";
/* Text of error E2022, printed when the controller state that a record parser produces from a capture differs from the expected state. */
"error.E2022.message" = "Lo stato che il parser del record ha prodotto dai report acquisiti differisce dallo stato atteso. Leggi i campi elencati dal comando.";
/* Text of error E2023, printed when a controller cannot be claimed or released because its protocol family uses raw USB or the system does not serve it natively. The settings window shows it too. */
"error.E2023.message" = "Questo controller non può essere preso in carico né restituito: la sua famiglia di protocollo usa USB raw, oppure il sistema non lo gestisce in modo nativo. Il messaggio indica il motivo.";
/* Text of error E2024, printed when no endpoint client or token has the given ID. ojd access is the command that lists the IDs and stays as written. */
"error.E2024.message" = "Nessun client o token dell’endpoint ha questo ID. Esegui ojd access per elencare gli ID, poi usane uno.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "Non si può concedere l’accesso a un client con questo tipo di firma, perché qualsiasi programma locale può rivendicarne la firma.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Scegli almeno un ambito da concedere.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "Il servizio si sta arrestando. Avvialo, poi riprova.";
/* Text of error E2028, printed when a token with the chosen name exists. */
"error.E2028.message" = "Esiste già un token con questo nome. Revocalo prima oppure scegli un altro nome.";
/* Text of error E2029, printed when a token name has characters that are not allowed. The limit of 64 characters is fixed. */
"error.E2029.message" = "Questo non è un nome di token. Usa da 1 a 64 lettere, cifre, punti, trattini o trattini bassi.";
/* Text of error E2030, printed when a web origin is not valid. scheme://host[:port], http, https and the example in backticks stay as written. */
"error.E2030.message" = "Questa non è un’origine web. Usa scheme://host[:port] con http o https, ad esempio `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Questa porta su 127.0.0.1 è in uso o non può essere aperta. Scegline un’altra con --port.";
/* Text of error E2032, printed when the control scope is granted to a token that has origins. */
"error.E2032.message" = "Un token con origini non può avere l’ambito control, perché una pagina non deve mai pilotare un gamepad virtuale. Concedi control a un token senza origini.";
/* Text of error E2033, printed when 'ojd virtual launch' cannot start the program. */
"error.E2033.message" = "Il programma non può essere avviato. Controlla che il suo percorso indichi un file eseguibile o un'app e che tu possa eseguirlo.";
/* Error E2034, shown in the app or the CLI when the service no longer accepts requests. */
"error.E2034.message" = "Il servizio non accetta più richieste. Chiudi OpenJoystickDriver, riaprilo e riprova.";
/* Error E2035, shown in the app or the CLI when the file that records why the request listener stopped is unusable. */
"error.E2035.message" = "Il file che registra perché l’ascolto delle richieste si è fermato non è utilizzabile. Elimina il file, poi riapri OpenJoystickDriver.";
/* Error E2036, shown by ojd and the app when no OpenJoystickDriver app took the test notification or reported on it before the deadline. */
"error.E2036.message" = "Nessuna app OpenJoystickDriver ha risposto in tempo alla notifica di prova. Verifica che l’app sia in esecuzione e riprova.";
/* Error E2037, shown by ojd and the app when notifications are not allowed for the app, so the test notification could not be shown. */
"error.E2037.message" = "Le notifiche non sono consentite per OpenJoystickDriver. Consentile nelle impostazioni delle notifiche del sistema e riprova.";
/* Note about a controller record whose raw USB family the USB extension cannot claim because Apple signs its product list. OJD is the short product name. */
"platform.macos.cli.record.group.usbNotClaimed" = "La famiglia usa USB grezzo e l’estensione USB non può acquisire questo controller, perché il suo elenco di prodotti è firmato da Apple. OJD lo raggiunge solo tramite accesso USB diretto, quando macOS lo consente.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "Solo USB: aggiungi bluetoothLE.vibrationCharacteristic a questo record Switch 2 per collegare il controller tramite Bluetooth LE.";
/* One-line summary of 'ojd record validate' in the command list and at the top of its help. */
"cli.record.validate.abstract" = "Controlla un record del controller senza installarlo.";
/* Long description in the help of 'ojd record validate'. */
"cli.record.validate.discussion" = "Controlla la forma del record, i suoi campi tra loro e la sua compatibilità con il catalogo incluso, e indica se il controller richiede l’estensione USB. Termina con 1 se il record non è valido.";
/* Message printed by 'ojd record validate' for a correct record. %1$@ is the file path, %2$@ is the operation in kebab case such as install, %3$@ is the controller model and %4$@ is the protocol family. The command in quotes stays as written. */
"cli.record.validate.valid" = "%1$@ è un record %2$@ valido per %3$@ (%4$@). Installalo con «ojd record install».";
/* Heading in the output of 'ojd status' above the defaults file that the driver ignores. */
"cli.status.group.labelIgnoredDefaults" = "File dei valori predefiniti ignorato";
/* Heading in the output of 'ojd status' above the list of skipped persona files. %lld is the number of files. */
"cli.status.group.labelSkippedPersonas" = "File persona ignorati (%lld)";
/* Heading in the output of 'ojd status' above the list of skipped controller records. %lld is the number of records. */
"cli.status.group.labelSkippedRecords" = "Record del controller ignorati (%lld)";
/* One-line summary of 'ojd binding' in the command list and at the top of its help. */
"cli.binding.group.abstract" = "Elenca, imposta e cancella le assegnazioni di un profilo di rimappatura.";
/* Error of 'ojd binding set' when the JSON of --actions-json cannot be read. %@ is the description of the parse problem. --actions-json stays as written. */
"cli.binding.group.actionsInvalid" = "--actions-json non è un elenco di azioni valido: %@";
/* Error of 'ojd binding set' when the JSON of --actions-json exceeds the size limit. --actions-json stays as written. */
"cli.binding.group.actionsTooLarge" = "--actions-json è troppo grande.";
/* Error of 'ojd binding set' when the value of --double-tap or --long-hold does not have the form MS:TARGET. %@ is the option name. MS:TARGET and the example stay as written. */
"cli.binding.group.alternateFormat" = "%@ richiede MS:TARGET, ad esempio 500:key:key-b.";
/* Error of 'ojd binding set' when an axis option is used with a source that is not an axis. The option names stay as written. */
"cli.binding.group.axisOptionsSource" = "--deadzone, --gain, --invert, --response-curve e --digital-threshold richiedono una sorgente ad asse.";
/* One-line summary of 'ojd binding clear' in the command list and at the top of its help. */
"cli.binding.clear.abstract" = "Rimuove le assegnazioni delle sorgenti indicate, oppure tutte.";
/* Help text of the --all flag of 'ojd binding clear'. */
"cli.binding.clear.all" = "Rimuove ogni assegnazione, combinazione, sequenza e livello.";
/* Warning of 'ojd binding clear' when removing the bindings leaves an active profile without any binding, so its controller sends no input. %@ is the profile name. The two commands in quotes stay as written. */
"cli.binding.clear.blocksInput" = "«%@» è attivo su un controller collegato e ora ne blocca tutto l’input. Aggiungi un’assegnazione con «ojd binding set» oppure interrompi il profilo con «ojd profile deactivate».";
/* Yes or no question that 'ojd binding clear --all' asks on a terminal. %@ is the profile name. */
"cli.binding.clear.confirm" = "Rimuovere ogni assegnazione, combinazione, sequenza e livello da «%@»?";
/* Long description in the help of 'ojd binding clear'. --all and --force stay as written. */
"cli.binding.clear.discussion" = "--all rimuove anche le combinazioni, le sequenze e i livelli del profilo e chiede conferma su un terminale; altrimenti richiede --force. Le impostazioni di levette, grilletti, tocco, movimento e output restano.";
/* Message printed after 'ojd binding clear' removed bindings. %1$@ is the profile name and %2$lld is the number of removed bindings, shown after a colon. */
"cli.binding.clear.done" = "Assegnazioni rimosse da «%1$@»: %2$lld.";
/* Message printed by 'ojd binding clear --dry-run' instead of changing the profile. %1$@ is the profile name and %2$lld is the number of bindings that would be removed, shown after a colon. */
"cli.binding.clear.dryRun" = "Assegnazioni che verrebbero rimosse da «%1$@»: %2$lld.";
/* Message of 'ojd binding clear' when a source has no binding. %1$@ is the profile name and %2$@ is the source the user gave. */
"cli.binding.clear.missing" = "«%1$@» non ha nessuna assegnazione per %2$@. Nessuna modifica.";
/* Help text of the SOURCES argument of 'ojd binding clear'. */
"cli.binding.clear.sources" = "Le sorgenti di cui rimuovere le assegnazioni.";
/* Error of 'ojd binding clear' when neither sources nor --all are given. --all stays as written. */
"cli.binding.clear.usage" = "Indica una o più sorgenti, oppure --all.";
/* Long description in the help of 'ojd binding'. It lists the SOURCE and TARGET forms. Words in capitals, forms such as button:NAME and all option names stay as written. */
"cli.binding.group.discussion" = "Un’assegnazione invia un TARGET quando si usa una SOURCE del controller.\n\nSOURCE: button:NAME, dpad:DIRECTION, axis:NAME[:negative|positive], trigger:NAME:STAGE, motion:lean:DIRECTION, touch:SURFACE:contact, touch:SURFACE:grid:COLUMNS:ROWS:COLUMN:ROW oppure touch:SURFACE:swipe:DIRECTION:DISTANCE.\n\nTARGET: key:KEY[:mods=meta,control,alt,shift], mouse:BUTTON, move:x|y, scroll:x|y, gamepad:button:NAME, gamepad:dpad:DIRECTION, gamepad:axis:NAME oppure physical:... per vibrazione, luci e grilletti adattivi.\n\n’ojd profile show’ stampa le assegnazioni in queste forme. Modifica combinazioni, sequenze e livelli con «ojd profile edit».";
/* One-line summary of 'ojd binding list' in the command list and at the top of its help. */
"cli.binding.list.abstract" = "Elenca le assegnazioni di un profilo.";
/* Message of 'ojd binding list' when the profile has no bindings. %@ is the profile name. The command in quotes stays as written. */
"cli.binding.list.empty" = "«%@» non ha assegnazioni. Aggiungine una con «ojd binding set».";
/* Help text of the --actions-json option of 'ojd binding set'. 'ojd profile export' stays as written. */
"cli.binding.group.optionActionsJson" = "Azioni aggiuntive come array JSON, nella forma in cui le scrive «ojd profile export».";
/* Help text of the --behavior option of 'ojd binding set'. The behavior hold is a value the user types. */
"cli.binding.group.optionBehavior" = "Quando viene inviata la destinazione. Predefinito: il comportamento dell’assegnazione attuale, oppure hold.";
/* Help text of the --deadzone option of 'ojd binding set'. The dead zone is the part of an axis travel that is ignored. */
"cli.binding.group.optionDeadzone" = "Sorgenti ad asse: la parte della corsa che viene ignorata, da 0 a 0.95. Predefinito: 0.1.";
/* Help text of the --digital-threshold option of 'ojd binding set'. It sets the axis travel that counts as a press. */
"cli.binding.group.optionDigitalThreshold" = "Sorgenti ad asse: la corsa che conta come pressione per le destinazioni a pulsante. Predefinito: 0.5.";
/* Help text of the --double-tap option of 'ojd binding set'. The example 300:key:key-c stays as written. */
"cli.binding.group.optionDoubleTap" = "Invia un’altra destinazione quando la sorgente viene premuta due volte entro questo tempo, ad esempio 300:key:key-c.";
/* Help text of the --gain option of 'ojd binding set'. Gain scales the axis output. */
"cli.binding.group.optionGain" = "Sorgenti ad asse: la scala dell’output, da 0.1 a 10. Predefinito: 1.";
/* Help text of the --invert flag of 'ojd binding set'. */
"cli.binding.group.optionInvert" = "Sorgenti ad asse: inverte la direzione.";
/* Help text of the --long-hold option of 'ojd binding set'. The example 500:key:key-b stays as written. */
"cli.binding.group.optionLongHold" = "Invia un’altra destinazione quando la sorgente resta premuta per questo tempo, ad esempio 500:key:key-b.";
/* Help text of the --pulse-ms option of 'ojd binding set'. ms means milliseconds. */
"cli.binding.group.optionPulseMs" = "Per quanto tempo un impulso mantiene la destinazione, da 1 a 5000 ms. Predefinito: 100.";
/* Help text of the --response-curve option of 'ojd binding set'. linear is a value the user types. */
"cli.binding.group.optionResponseCurve" = "Sorgenti ad asse: come cresce l’output con la corsa. Predefinito: linear.";
/* Help text of the --turbo-duty option of 'ojd binding set'. The duty is the share of each turbo cycle in which the target is held. */
"cli.binding.group.optionTurboDuty" = "La quota di ogni ciclo turbo in cui la destinazione resta premuta, maggiore di 0 e minore di 1.";
/* Help text of the --turbo-rate option of 'ojd binding set'. --turbo-duty stays as written. */
"cli.binding.group.optionTurboRate" = "Ripete la destinazione questo numero di volte al secondo finché resta premuta. Richiede --turbo-duty.";
/* One-line summary of 'ojd binding set' in the command list and at the top of its help. */
"cli.binding.set.abstract" = "Associa una sorgente del controller a una destinazione, sostituendo l’assegnazione attuale della sorgente.";
/* Message printed after 'ojd binding set' stored a binding. %1$@ is the profile name and %2$@ describes the source bound to the target. */
"cli.binding.set.done" = "Ora «%1$@» è assegnato a %2$@.";
