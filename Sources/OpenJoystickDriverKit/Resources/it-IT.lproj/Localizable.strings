"cli.access.grant.abstract" = "Consenti a un programma firmato, o a un nuovo token, di usare l’endpoint.";
"platform.macos.cli.access.grant.adHoc" = "%@ ha una firma ad-hoc o non è firmato, quindi qualsiasi programma locale può rivendicarne la firma. Firmalo con un certificato Developer ID o Apple Development, poi concedi l’accesso.";
"platform.macos.cli.access.grant.platformWarning" = "Apple ha firmato questo programma. Se esegue script, come python3 o osascript, ogni script che esegue ottiene questo accesso.";
"cli.access.grant.clientOrToken" = "Indica CLIENT oppure --token NAME.";
"cli.access.grant.confirm" = "Consentire a %1$@, firmato come %2$@, di usare l’endpoint con %3$@?";
"cli.access.grant.controlWarning" = "L’ambito control permette al programma di premere i pulsanti di un gamepad virtuale, che giochi e app trattano come il tuo input.";
"cli.access.grant.discussion" = "CLIENT è il percorso del programma o un ID di «ojd access list». L’autorizzazione indica la firma del programma, quindi resta valida quando il programma viene aggiornato o spostato. I programmi con firma ad-hoc e quelli non firmati non possono essere autorizzati. Con --token al posto di CLIENT, crea un token con cui un client firma la sfida del servizio nel suo hello, sul socket, sul WebSocket da una pagina di uno dei valori di --origin o, per un token senza --origin, sul WebSocket da un programma che non invia l’intestazione Origin, come un’app in sandbox. Una pagina non può usare l’ambito control. Il token viene mostrato una sola volta. Chiede prima conferma.";
"cli.access.grant.origin" = "Un’origine web, come http://127.0.0.1:8080, le cui pagine possono usare il token sul WebSocket. Ripeti per aggiungerne altre. Le pagine di overlay servite dal WebSocket hanno l’origine http://127.0.0.1:PORT, con la porta mostrata da «ojd access status».";
"cli.access.grant.originControl" = "--origin non può essere combinato con l’ambito control. Una pagina non pilota mai un gamepad virtuale; concedi control a un token senza --origin.";
