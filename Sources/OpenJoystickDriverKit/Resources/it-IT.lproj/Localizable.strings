"cli.binding.set.source" = "Il controllo del controller, ad esempio button:south.";
/* Help text of the TARGET argument of 'ojd binding set'. key:space stays as written. */
"cli.binding.set.target" = "Cosa invia, ad esempio key:space.";
/* Error of 'ojd binding' commands when a source cannot be parsed. %@ is the text the user gave. The command in quotes stays as written. */
"cli.binding.group.sourceInvalid" = "«%@» non è una sorgente. «ojd binding set --help» elenca le forme delle sorgenti.";
/* Error of 'ojd binding set' when the target cannot be parsed. %@ is the text the user gave. The command in quotes stays as written. */
"cli.binding.group.targetInvalid" = "«%@» non è una destinazione. «ojd binding set --help» elenca le forme delle destinazioni.";
/* Error of 'ojd binding set' when only one of --turbo-rate and --turbo-duty is given. Both option names stay as written. */
"cli.binding.group.turboPair" = "--turbo-rate e --turbo-duty vanno indicati insieme.";
/* Error of 'ojd binding set' when turbo is requested for a pointer movement or scrolling target. */
"cli.binding.group.turboUnsupported" = "Il turbo non funziona con le destinazioni di movimento del puntatore o di scorrimento.";
