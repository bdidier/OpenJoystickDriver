"status.listenerFailure.restartFailedReason" = "L’ascolto delle richieste non è ripartito: %@. Chiudi OpenJoystickDriver e riaprilo.";
/* Reason the listener failure file cannot be used: it is not a regular file. Fills the reason in the error E2035 message. */
"status.listenerFailure.notRegularFile" = "il file non è un file normale";
/* Reason the listener failure file cannot be used: another user owns it, so ojd must run as that user. Fills the reason in the error E2035 message. */
"status.listenerFailure.otherUser" = "il record appartiene a un altro utente; esegui ojd come quell’utente";
