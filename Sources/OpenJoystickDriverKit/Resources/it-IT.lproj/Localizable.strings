"status.listenerFailure.earlier" = "Il servizio non è in esecuzione. Il suo ultimo ascolto delle richieste si è fermato: %@";
/* Status line when the request listener cannot be restarted because the service is stopping or has not started. */
"status.listenerFailure.restartUnavailable" = "Il servizio si sta arrestando o non è ancora avviato, quindi l’ascolto delle richieste non può ripartire.";
