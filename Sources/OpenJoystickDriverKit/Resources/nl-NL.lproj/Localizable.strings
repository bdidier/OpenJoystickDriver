/* Reason the listener failure file cannot be used: the system would not say whether the process that wrote it runs. %1$@ is the system's reason, %2$@ the error number. Fills the reason in the error E2035 message. */
"status.listenerFailure.processCheckFailed" = "kon niet controleren of het serviceproces draait: %1$@ (foutnummer %2$@)";
/* Abstract of the ojd setting test-notification command, in the command help. */
"cli.setting.testNotification.abstract" = "Toont een testmelding in de app.";
/* Discussion of the ojd setting test-notification command, in the command help. */
"cli.setting.testNotification.discussion" = "Vraagt de service om een testmelding door te geven aan de geopende OpenJoystickDriver-app en wacht tot de app de melding toont. Mislukt met een benoemde fout als meldingen zijn geweigerd, de aflevering mislukt of geen enkele app op tijd antwoordt. Standaardwaarde van --timeout hier, in seconden: %@.";
/* Printed by ojd setting test-notification after the app reported that it showed the test notification. */
"cli.setting.testNotification.success" = "De app heeft de testmelding getoond.";
