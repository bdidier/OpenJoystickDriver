/* Long description in the help of 'ojd record test'. The command in quotes and the JSON terms stay as written. */
"cli.record.test.discussion" = "Speelt de ontvangen pakketten van een opname af via de parser van het record en vergelijkt daarna de controllerstatus na het laatste invoerrapport met de verwachte status. De opname bestaat uit de JSON-regels van ‘ojd controller capture --json’. De verwachte status is één JSON-object in de vorm van een regel van ‘ojd controller watch --json’. De opdracht toont elk afwijkend veld en stopt met code 1 als er een afwijkt. Ze vergelijkt elk veld behalve connection, dat de draaiende service instelt. Er is geen draaiende service nodig.";
/* Help text of the expected state argument of 'ojd record test'. The state is a JSON file. */
"cli.record.test.expect" = "De verwachte controllerstatus, als JSON-bestand.";
/* Error of 'ojd record test' when the expected state file is invalid. %1$@ is the file path and %2$@ is the description of the problem. */
"cli.record.test.expectInvalid" = "%1$@ is geen controllerstatus: %2$@";
/* Error of 'ojd record test' when the capture holds no input report. %1$@ is the capture file path and %2$@ is the controller model. */
"cli.record.test.noInput" = "Geen enkel rapport in %1$@ bevatte invoer voor %2$@. Leg opnieuw vast terwijl je de bedieningselementen indrukt.";
/* Error of 'ojd record test' when the family of the controller has no parser that can run without the controller. %@ is the controller model. */
"cli.record.test.noParser" = "De familie van %@ heeft geen parser die zonder controller werkt.";
/* Help text of the packet capture argument of 'ojd record test'. The command in quotes stays as written. */
"cli.record.test.packets" = "Een pakketopname, als de JSON-regels van ‘ojd controller capture --json’.";
/* Error of 'ojd record test' when the parser rejects a packet. %1$@ is the controller model, %2$lld is the packet number and %3$@ is the capture file path. */
"cli.record.test.parseFailed" = "De parser van %1$@ heeft ontvangen pakket %2$lld van %3$@ geweigerd.";
/* Text of error E2022, printed when the controller state that a record parser produces from a capture differs from the expected state. */
"error.E2022.message" = "De status die de parser van het record uit de vastgelegde rapporten opleverde, wijkt af van de verwachte status. Lees de velden die de opdracht toont.";
/* Text of error E2023, printed when a controller cannot be claimed or released because its protocol family uses raw USB or the system does not serve it natively. The settings window shows it too. */
"error.E2023.message" = "Deze controller kan niet worden overgenomen of teruggegeven: de protocolfamilie gebruikt ruwe USB, of het systeem ondersteunt hem niet native. Het bericht noemt de reden.";
/* Text of error E2024, printed when no endpoint client or token has the given ID. ojd access is the command that lists the IDs and stays as written. */
"error.E2024.message" = "Geen endpoint-client of token heeft deze ID. Voer ojd access uit om de ID’s te tonen en gebruik er een.";
/* Text of error E2025, printed when a client with a signature that any local program can claim cannot be granted. */
"error.E2025.message" = "Een client met dit soort handtekening kan geen toegang krijgen, omdat elk lokaal programma die handtekening kan claimen.";
/* Text of error E2026, printed when a grant names no scope. */
"error.E2026.message" = "Kies minstens één bereik om te verlenen.";
/* Text of error E2027, printed when the service is shutting down while the command runs. */
"error.E2027.message" = "De service wordt gestopt. Start hem en probeer het opnieuw.";
/* Text of error E2028, printed when a token with the chosen name exists. */
"error.E2028.message" = "Er bestaat al een token met deze naam. Trek het eerst in of kies een andere naam.";
/* Text of error E2029, printed when a token name has characters that are not allowed. The limit of 64 characters is fixed. */
"error.E2029.message" = "Dit is geen tokennaam. Gebruik 1 tot 64 letters, cijfers, punten, streepjes of underscores.";
/* Text of error E2030, printed when a web origin is not valid. scheme://host[:port], http, https and the example in backticks stay as written. */
"error.E2030.message" = "Dit is geen webherkomst. Gebruik scheme://host[:port] met http of https, zoals `http://127.0.0.1:8080`.";
/* Text of error E2031, printed when the WebSocket port on 127.0.0.1 is in use or cannot be opened. 127.0.0.1 and --port stay as written. */
"error.E2031.message" = "Deze poort op 127.0.0.1 is in gebruik of kan niet worden geopend. Kies een andere met --port.";
/* Text of error E2032, printed when the control scope is granted to a token that has origins. */
"error.E2032.message" = "Een token met herkomsten kan het bereik control niet hebben, omdat een pagina nooit een virtuele gamepad mag besturen. Verleen control aan een token zonder herkomsten.";
/* Text of error E2033, printed when 'ojd virtual launch' cannot start the program. */
"error.E2033.message" = "Het programma kon niet worden gestart. Controleer of het pad een uitvoerbaar bestand of een app aanwijst en of je het mag uitvoeren.";
/* Error E2034, shown in the app or the CLI when the service no longer accepts requests. */
"error.E2034.message" = "De service accepteert geen verzoeken meer. Sluit OpenJoystickDriver af, open het opnieuw en probeer het opnieuw.";
/* Error E2035, shown in the app or the CLI when the file that records why the request listener stopped is unusable. */
"error.E2035.message" = "Het bestand dat vastlegt waarom de verzoeklistener is gestopt, kan niet worden gebruikt. Verwijder het bestand en open OpenJoystickDriver daarna opnieuw.";
/* Error E2036, shown by ojd and the app when no OpenJoystickDriver app took the test notification or reported on it before the deadline. */
"error.E2036.message" = "Geen enkele OpenJoystickDriver-app heeft op tijd op de testmelding geantwoord. Controleer of de app draait en probeer het opnieuw.";
/* Error E2037, shown by ojd and the app when notifications are not allowed for the app, so the test notification could not be shown. */
"error.E2037.message" = "Meldingen zijn niet toegestaan voor OpenJoystickDriver. Sta ze toe in de meldingsinstellingen van het systeem en probeer het opnieuw.";
"platform.macos.cli.record.group.usbNotClaimed" = "De familie gebruikt onbewerkte USB en de USB-extensie kan deze controller niet claimen, omdat de productlijst door Apple is ondertekend. OJD bereikt hem alleen via directe USB-toegang, wanneer macOS dat toestaat.";
/* Note about a Switch 2 controller record that connects over USB only. bluetoothLE.vibrationCharacteristic is a field of the record and stays as written. */
"cli.record.group.usbOnlySwitch2" = "Alleen USB: voeg bluetoothLE.vibrationCharacteristic toe aan dit Switch 2-record om de controller via Bluetooth LE te verbinden.";
