"error.E2013.message" = "De controller kan dit nu niet doen. Hij wordt mogelijk niet ondersteund, is niet gereed of is losgekoppeld. Controleer hem met „ojd controller list”.";
/* Text of error E2014, printed when the app is not fully installed or its signature is not valid. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2014.message" = "OpenJoystickDriver is niet volledig geïnstalleerd of de handtekening is ongeldig. Installeer de app opnieuw en voer „ojd diagnose” uit.";
/* Text of error E2015, printed when macOS does not complete or apply a request of the driver. */
"error.E2015.message" = "Het systeem heeft het verzoek niet voltooid of toegepast. Controleer de systeeminstellingen en probeer het opnieuw.";
/* Text of error E2016, printed when a file cannot be read, written or deleted, or is present although it must not be. */
"error.E2016.message" = "Een bestand kon niet worden gelezen, geschreven of verwijderd, of het bestaat al. Controleer het pad en de bijbehorende rechten.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Die client is niet of ad hoc ondertekend en kan daarom geen toegang krijgen. Onderteken hem met een Developer ID en probeer het opnieuw.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "„ojd diagnose” vond een mislukte controle. Lees de uitvoer en herstel de mislukte onderdelen.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "De controle op updates is niet voltooid. Controleer je netwerkverbinding en probeer het opnieuw.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "De geïnstalleerde OpenJoystickDriver-app is ouder dan deze ojd. Voer „./Scripts/ojd build install-fast dev” uit of stel OJD_RUN_REPOSITORY_CLI=1 in om deze build uit te voeren.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Een ojd-build uit de repository kon de opdracht niet doorgeven aan de geïnstalleerde app. Installeer OpenJoystickDriver.app opnieuw en voer de opdracht opnieuw uit.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "De controller is niet verbonden of niet gereed voor hertoewijzing. Verbind hem opnieuw en probeer het opnieuw.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "De geselecteerde Joy-Cons konden niet worden gekoppeld. Ververs de verbonden controllers en probeer het opnieuw.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "De controller meldt geen bewegingsgegevens. Kies een controller met bewegingssensoren of laat de bewegingsopties uit.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Een waarde in het verzoek is groter dan de service accepteert. Stuur een kleinere waarde.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "De lijst met actieve profielen is beschadigd en kon niet worden geladen. Herstel of verwijder het beschadigde bestand en probeer het opnieuw.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "Er bestaat al een profiel met deze naam. Kies een andere naam; „ojd profile list” toont de namen die in gebruik zijn.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "Het verzoek heeft ontbrekende of ongeldige argumenten. Controleer de waarden en probeer het opnieuw.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "Het profiel is ongeldig. Controleer de toewijzingen en probeer het opnieuw.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "De profielbibliotheek zou te groot worden. Verwijder profielen die je niet nodig hebt en probeer het opnieuw.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "Er bestaat al een profiel met deze identificatie. Gebruik een nieuwe identificatie of werk het bestaande profiel bij.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "Het profiel is elders gewijzigd nadat je het laadde. Laad het opnieuw en voer je wijziging opnieuw uit.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "De bibliotheek bevat al het maximaal toegestane aantal profielen. Verwijder een profiel dat je niet nodig hebt en probeer het opnieuw.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "Geen enkel profiel heeft deze identificatie. Toon de profielen met „ojd profile list”.";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "De service kon zijn antwoord niet coderen. Probeer het opnieuw en meld het probleem als het aanhoudt.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "Het antwoord is groter dan de service kan verzenden. Vraag minder gegevens op en probeer het opnieuw.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "De hertoewijzingsengine is niet beschikbaar. Wacht even en probeer het opnieuw, of start de service opnieuw op.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "De profielbibliotheek en de hertoewijzingsengine zijn niet beschikbaar. Wacht even en probeer het opnieuw, of start de service opnieuw op.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "De profielbibliotheek is niet beschikbaar. Wacht even en probeer het opnieuw, of start de service opnieuw op.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "De hertoewijzingsrouter is afgesloten. Start de service opnieuw op en probeer het opnieuw.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "De service kon niet bevestigen of de laatste profielwijziging is opgeslagen. Laad de profielen opnieuw en controleer ze voordat je ze opnieuw wijzigt.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "Een profielbestand kon niet worden gelezen. Controleer of het bestand bestaat en of de service het kan lezen.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "Beschadigde profielbestanden moeten worden hersteld of verwijderd voordat profielen kunnen worden gewijzigd. Herstel of verwijder ze en probeer het opnieuw.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "Een profielbestand kon niet worden geschreven. Controleer de vrije schijfruimte en de maprechten.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "De hertoewijzingsservice kwam een fout tegen die hij niet herkent. Voer „ojd diagnose” uit en meld het probleem samen met de uitvoer.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "Het profiel produceert geen uitvoer. Voeg er een koppeling of een lichtkleur aan toe, of activeer het met --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "Het profiel van het Joy-Con-paar haalt de gyro van de andere Joy-Con. Kalibreer de beweging van de controller die het profiel voor de gyro kiest.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Er is geen hertoewijzingsprofiel actief voor de controller, dus hij verwerkt geen beweging. Activeer een profiel ervoor, breng de doel-app naar voren en probeer het opnieuw.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "De hertoewijzingssessie van de controller is gewijzigd tijdens het verzoek. Probeer het opnieuw.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Een profiel uit een geïnstalleerd pakket kan niet worden gewijzigd. Dupliceer het profiel en wijzig de kopie.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.json stays as written. */
"error.E4001.message" = "Het pakketmanifest mod.json ontbreekt of is ongeldig. Controleer het aan de hand van het mod-package-schema en voer de opdracht opnieuw uit.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "Het pakket vereist een andere versie van OpenJoystickDriver dan die nu draait. Installeer een pakketversie die deze versie ondersteunt of werk OpenJoystickDriver bij.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.json stays as written. */
"error.E4003.message" = "Een bestand van het pakket is ongeldig, ontbreekt of staat niet in mod.json. Herstel het bestand dat de opdracht noemt en voer de opdracht opnieuw uit.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "Het pakket omvat een controller, persona of profiel dat je eigen bestanden of een ander geïnstalleerd pakket al bevatten. Verwijder het botsende bestand of pakket, of wijzig het pakket, en voer de opdracht opnieuw uit.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Er is al een pakket met deze naam geïnstalleerd. Voer de opdracht uit met --force om het te vervangen.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Geen geïnstalleerd pakket heeft deze naam. Voer ojd mod list uit om de geïnstalleerde pakketten te zien.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "De pakketmap kon niet worden gewijzigd. Controleer de vrije schijfruimte en de maprechten.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Een document heeft geen apiVersion, of de apiVersion wordt niet ondersteund door deze versie van OpenJoystickDriver. Wijzig het document naar de ondersteunde apiVersion die de melding noemt en voer de opdracht opnieuw uit.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Een protocolbeschrijving is ongeldig. Controleer het bestand met het schema protocol-description en herstel het veld dat het bericht noemt.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Een protocolbeschrijving noemt een familie die afwijkt van de bestandsnaam. Noem het bestand naar zijn familie.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Een protocolbeschrijving noemt een variant die de familie niet heeft. Gebruik een van de varianten van de familie.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.json is a file name and stays as written. */
"error.E5005.message" = "Het toegangsbestand AccessGrants.json is beschadigd. Herstel het bestand of verwijder het, en verleen daarna opnieuw toegang.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Het sleutelbestand van de apparaat-ID's, PortKeyInstallation.key, kan niet worden gelezen of is niet 32 bytes. Zet het bestand terug vanuit een reservekopie. Als je het in plaats daarvan verwijdert, maakt OpenJoystickDriver een nieuwe sleutel en verandert elke apparaat-ID.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Een controllerrecord of patch is ongeldig. Controleer het bestand met zijn schema en herstel het veld dat het bericht noemt.";
"ui.error.withCode" = "%1$@ (%2$@)";

