/* Button that dismisses an alert in the activity view and the main window. It only acknowledges the message. */
"action.ok" = "OK";
/* Toolbar item of the input test window and button of the developer controller summary that reads the controller state again. */
"action.refresh" = "Vernieuw";
/* Button of an error state view and of the controller detail facts that repeats the failed load. */
"action.tryAgain" = "Probeer opnieuw";
/* Button of the access sheets that closes the sheet without changing anything. It is also bound to the Escape key. */
"action.cancel" = "Annuleer";
/* Button of the motion and stick sheets of the profile editor that stores the edited values in the profile. */
"action.save" = "Bewaar";
/* Button of the profile creation sheet that creates the profile from the entered name. */
"action.create" = "Maak";
/* Menu item and toolbar button that deletes the selected profile. */
"action.delete" = "Verwijder";
/* Button that closes an error banner of the profile editor and of the profile list without further action. */
"action.dismiss" = "Sluit";
/* Button in the mapping capture banner that discards local edits and loads the stored profile again. It sits beside Keep editing. */
"action.reload" = "Laad opnieuw";
/* Button in the mapping capture banner that keeps the local edits when the stored profile changed. It sits beside Reload. */
"action.keepEditing" = "Blijf bewerken";
/* Button that removes the captured keys in the keyboard capture view and the captured packets in the developer packet capture view. */
"action.clear" = "Wis";
/* Button that asks macOS for the input permission shown on the row. Ends in an ellipsis because a system prompt follows. */
"action.request" = "Vraag aan…";
/* Button of the capture assignment sheet and of the profile editor sections that adds an assignment to the profile. */
"action.addAssignment" = "Voeg toewijzing toe";
/* Label and tooltip of the button that removes one assignment from the profile. */
"action.removeAssignment" = "Verwijder toewijzing";
/* Menu item of an assignment that opens the sheet to tune its analog values. Ends in an ellipsis because a sheet follows. */
"action.adjust" = "Pas aan…";
/* Toolbar button that creates a copy of the selected profile. */
"action.duplicate" = "Dupliceer";
/* Button of the profile editor that turns off the active profile. It swaps with Set active. */
"action.deactivate" = "Deactiveer";
/* Button of the profile editor and of the status menu alert that makes the profile the active one. It swaps with Deactivate. */
"action.setActive" = "Zet actief";
/* Status text in the menu bar menu while the app starts. Keep the three dots. */
"status.starting" = "Starten…";
/* Value of a permission row in the Access area while macOS is asked for its state. Keep the three dots. */
"status.checking" = "Controleren…";
/* Runtime state label: the service is up and can serve controllers. */
"status.ready" = "Gereed";
/* Value of a permission row in the Access area when macOS has granted the permission. */
"status.allowed" = "Toegestaan";
/* Value of a permission row in the Access area when the active profiles do not use the permission. */
"status.notNeeded" = "Niet nodig";
