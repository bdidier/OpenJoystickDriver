"status.listenerFailure.earlier" = "O serviço não está em execução. A última escuta de solicitações parou: %@";
/* Status line when the request listener cannot be restarted because the service is stopping or has not started. */
"status.listenerFailure.restartUnavailable" = "O serviço está parando ou ainda não foi iniciado, então a escuta de solicitações não pode reiniciar.";
/* Status line when restarting the request listener failed for a reason that is not an error number. %@ is the reason. */
