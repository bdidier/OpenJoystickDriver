/* One-line summary of ojd, the command line tool, at the top of its help. OpenJoystickDriver is the product name. */
"platform.macos.cli.root.group.abstract" = "Configura e inspeciona o OpenJoystickDriver, o driver de gamepad para macOS.";
/* Start of the help of ojd. It lists the first commands to run, in aligned columns; the command names stay as written and the descriptions after them are translated. Keep the alignment spaces. */
"platform.macos.cli.root.group.discussion" = "Comece aqui:\n  ojd status             Verifica o serviço, a extensão e as permissões.\n  ojd diagnose           Executa todas as verificações e informa o problema.\n  ojd controller list    Lista os controles conectados.\n\nExemplos:\n  # Mostra a entrada de um controle conforme ela muda\n  ojd controller watch 045E:028E\n  # Lista os controles conectados em JSON\n  ojd --json controller list\n\nAmbiente (uma opção vence a variável):\n  OJD_NO_INPUT=1         Igual a --no-input.\n  OJD_TIMEOUT=SECONDS    Igual a --timeout.\n  OJD_COLOR=WHEN         auto, always (cor mesmo fora de um terminal) ou never.\n\nAutocompletar do shell:\n  ojd --generate-completion-script zsh|bash|fish\n\nCódigos de saída:\n  0    Sucesso.\n  1    O comando falhou.\n  64   Erro de uso.\n  69   O serviço não está em execução. Inicie-o com “ojd service start”.\n  77   Falta uma permissão do macOS.\n  127  Um build do repositório não pôde passar o comando ao app instalado.\n  130  Interrompido.";
/* Last line of the help of every command. 'ojd --help' stays as written. */
"cli.shared.help.globalOptions" = "Todo comando também aceita as opções globais; “ojd --help” as lista.";
/* Error when the environment variable OJD_TIMEOUT is not a number above 0. OJD_TIMEOUT stays as written. */
"cli.shared.error.envTimeout" = "OJD_TIMEOUT exige um número de segundos maior que 0.";
/* Error when the environment variable OJD_COLOR has another value. OJD_COLOR, auto, always and never stay as written. */
"cli.shared.error.envColor" = "OJD_COLOR exige auto, always ou never.";
/* Error when the environment variable OJD_NO_INPUT has another value. OJD_NO_INPUT and all the listed values stay as written. */
"cli.shared.error.envNoInput" = "OJD_NO_INPUT exige 1, true, yes, 0, false ou no.";
/* Error of 'ojd virtual feed' when --plain is given. The command in quotes and --plain stay as written. */
"cli.virtual.feed.errorPlain" = "--plain não se aplica a “virtual feed”, que imprime linhas JSON. Omita --plain.";
/* Examples block at the end of the help of 'ojd controller watch'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.watch.examples" = "Exemplos:\n  # Mostra a entrada por 10 segundos\n  ojd controller watch 045E:028E --duration 10\n  # Mostra o primeiro controle pressionado, em JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Observa todos os controles e o que o gamepad virtual envia\n  ojd controller watch --all --output";
/* Examples block at the end of the help of 'ojd controller rumble'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.rumble.examples" = "Exemplos:\n  # Aciona os dois motores principais em 180 por 0,45 segundo\n  ojd controller rumble 045E:028E\n  # Aciona os dois motores principais na força máxima por 2 segundos\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
/* Examples block at the end of the help of 'ojd controller light'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.controller.light.examples" = "Exemplos:\n  # Define a barra de luz como laranja\n  ojd controller light 054C:09CC --color FF8000\n  # Define a cor e um brilho baixo\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
/* Examples block at the end of the help of 'ojd profile create'. The command lines, option names and the app ID stay as written; translate only the lines that start with #. */
"cli.profile.create.examples" = "Exemplos:\n  # Cria um perfil para um modelo de controle\n  ojd profile create Racing --controller 045E:028E\n  # Aplica-o só enquanto o Safari está em primeiro plano\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
/* Examples block at the end of the help of 'ojd profile set'. The command lines and the key paths stay as written; translate only the lines that start with #. */
"cli.profile.set.examples" = "Exemplos:\n  # Renomeia um perfil\n  ojd profile set Racing name Rally\n  # Define a zona morta interna do primeiro mapeamento de analógico\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
/* Examples block at the end of the help of 'ojd binding set'. The command lines, option names and sources stay as written; translate only the lines that start with #. */
"cli.binding.set.examples" = "Exemplos:\n  # Mantém Espaço pressionada enquanto o botão sul está pressionado\n  ojd binding set Racing button:south key:space\n  # Alterna J a cada pressionamento\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Repete J 10 vezes por segundo enquanto pressionado\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
/* Examples block at the end of the help of 'ojd record install'. The command lines and file names stay as written; translate only the lines that start with #. */
"cli.record.install.examples" = "Exemplos:\n  # Instala um arquivo de registro\n  ojd record install 045E-028E.json\n  # Lê o registro da entrada padrão\n  ojd record install - < 045E-028E.json";
/* Examples block at the end of the help of 'ojd access grant'. The command lines and option names stay as written; translate only the lines that start with #. */
"cli.access.grant.examples" = "Exemplos:\n  # Permite que um programa use o serviço\n  ojd access grant /Applications/Example.app\n  # Cria um token para páginas servidas de uma única origem\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
/* One-line summary of 'ojd service' in the command list and at the top of its help. OpenJoystickDriver is the product name. */
"cli.service.group.abstract" = "Inicia ou para o serviço do OpenJoystickDriver, ou espera até que ele aceite solicitações.";
/* Message printed by 'ojd service' commands when the service runs. */
"cli.service.group.running" = "O serviço está em execução.";
/* One-line summary of 'ojd service start' in the command list and at the top of its help. */
"cli.service.start.abstract" = "Abre o app em segundo plano e espera até que o serviço dele aceite solicitações.";
/* Error of 'ojd service start' when the ojd program is not inside the app bundle. ojd and OpenJoystickDriver.app stay as written. */
"cli.service.start.noBundle" = "Este ojd não está dentro de OpenJoystickDriver.app e não pode iniciar o serviço. Abra o app instalado ou execute o ojd que está dentro dele.";
/* Error of 'ojd service start' when macOS cannot open the app. %@ is the path of the app. Finder is the macOS file manager. */
"platform.macos.cli.service.start.openFailed" = "O macOS não conseguiu abrir %@. Abra-o pelo Finder para ver o motivo.";
/* One-line summary of 'ojd service stop' in the command list and at the top of its help. */
"platform.macos.cli.service.stop.abstract" = "Para o serviço e espera até que ele saia. Os controles conectados voltam para o macOS.";
/* Error of 'ojd service stop' when the system refuses to stop the service. %@ is the reason from the system. OpenJoystickDriver is the product name. */
"cli.service.stop.signalFailed" = "Não foi possível parar o serviço: %@. Saia do OpenJoystickDriver pelo menu dele.";
/* Error of 'ojd service stop' when the service keeps running. %@ is the waited time, such as 5 seconds. --timeout stays as written. */
"cli.service.stop.timeout" = "O serviço não parou em %@. Tente de novo com um --timeout maior.";
/* Message printed by 'ojd service stop' when the service is stopped. */
"cli.service.group.stopped" = "O serviço está parado.";
/* One-line summary of 'ojd service wait' in the command list and at the top of its help. --timeout stays as written and the default of 5 seconds is fixed. */
"cli.service.wait.abstract" = "Espera até que o serviço aceite solicitações. --timeout limita a espera (padrão: 5 segundos).";
/* Error of 'ojd service wait' when the service does not answer in time. %@ is the waited time, such as 5 seconds. The command in quotes and --timeout stay as written. */
"cli.service.wait.timeout" = "O serviço não aceitou solicitações em %@. Inicie-o com “ojd service start” ou tente de novo com um --timeout maior.";
/* One-line summary of 'ojd status' in the command list and at the top of its help. */
"cli.status.group.abstract" = "Mostra o serviço, a extensão, as permissões e os controles conectados.";
/* Long description in the help of 'ojd status'. */
"cli.status.group.discussion" = "Funciona com o serviço parado: informa o serviço como parado e sai com 0.";
/* Row label in the output of 'ojd status' for the Accessibility permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputInject" = "Acessibilidade";
/* Row label in the output of 'ojd status'. The version of this command line tool follows. */
"cli.status.group.labelCommandLineTool" = "Ferramenta de Linha de Comando";
/* Heading in the output of 'ojd status' above the list of connected controllers. %lld is the number of controllers. */
"cli.status.group.labelControllers" = "Controles (%lld)";
/* Row label in the output of 'ojd status'. The state of the driver extension follows. */
"cli.status.group.labelTransportExtension" = "Extensão";
/* Row label in the output of 'ojd status' for the Input Monitoring permission. It is written as macOS names it. */
"platform.macos.cli.status.group.labelInputRead" = "Monitoramento de Entrada";
/* Row label in the output of 'ojd status'. The reason why the stored profile overrides could not be read follows. */
"cli.status.group.labelOverrideError" = "Erro de Substituição";
/* Heading in the output of 'ojd status' above the list of controllers that macOS serves natively. %lld is the number of controllers. */
"platform.macos.cli.status.group.labelPassThrough" = "Deixados ao macOS (%lld)";
/* Row label in the output of 'ojd status'. The state and version of the service follow. */
"cli.status.group.labelService" = "Serviço";
/* Heading in the output of 'ojd status' above the list of connected devices that the driver does not support. %lld is the number of devices. */
"cli.status.group.labelUnbound" = "Dispositivos Não Compatíveis (%lld)";
/* Row label in the output of 'ojd status'. The state of the virtual gamepad follows. */
"cli.status.group.labelVirtualDevice" = "Controle Virtual";
/* Hint printed by 'ojd status' when the service is stopped. The command in quotes stays as written. */
"cli.status.group.startHint" = "Controles e permissões aparecem quando o serviço está em execução: “ojd service start”.";
/* One-line summary of 'ojd access' in the command list and at the top of its help. */
"cli.access.group.abstract" = "Ativa o ponto de acesso e define quais programas podem ler controles por meio dele.";
/* Help text of the CLIENT argument of 'ojd access grant'. A client ID is the identifier that 'ojd access list' prints. */
"cli.access.group.client" = "O caminho do programa ou um ID de cliente.";
/* Error of 'ojd access grant' when CLIENT is neither a path nor a known client ID. %@ is the text the user typed. Keep the command in quotes as written. */
"cli.access.group.clientUnknown" = "Não há programa em %@ nem cliente com esse ID. Veja os IDs com “ojd access list”.";
/* Error of 'ojd access grant' when the program at the path has no code signature to grant. %@ is the path the user gave. */
"cli.access.group.clientUnsigned" = "%@ não contém nenhum programa assinado. Conceda acesso ao pacote do app ou ao executável do programa.";
/* One-line summary of 'ojd access disable' in the command list and at the top of its help. The endpoint is the local socket that granted programs connect to. */
"cli.access.disable.abstract" = "Desativa o ponto de acesso e fecha as conexões dele; as permissões concedidas são mantidas.";
/* Message printed after 'ojd access disable' turned the endpoint off. */
"cli.access.disable.success" = "O ponto de acesso está desativado e as conexões dele foram fechadas.";
/* Long description in the help of 'ojd access'. It explains the endpoint, that it is off until enabled and that only granted programs are served. Command names stay as written. */
"cli.access.group.discussion" = "O ponto de acesso é um soquete local do qual os programas autorizados leem eventos dos controles. Ele fica desativado até você executar “ojd access enable”, e o serviço atende apenas programas cuja assinatura você autorizou ou que enviam um token que você autorizou. “ojd access web enable” adiciona um WebSocket em 127.0.0.1 para páginas de overlay.";
/* One-line summary of 'ojd access enable' in the command list and at the top of its help. */
"cli.access.enable.abstract" = "Ativa o ponto de acesso.";
/* Yes or no question that 'ojd access enable' asks on a terminal before it turns the endpoint on. */
"cli.access.enable.confirm" = "Ativar o ponto de acesso, para que os programas que você autorizar possam ler a entrada de todos os controles?";
/* Long description in the help of 'ojd access enable'. It says that a confirmation comes first and that only granted programs can use the endpoint. Command names stay as written. */
"cli.access.enable.discussion" = "Pede confirmação primeiro. Apenas programas autorizados podem usar o ponto de acesso; adicione-os com “ojd access grant”.";
/* Message printed after 'ojd access enable' turned the endpoint on. %@ is the path of the socket it listens on. */
"cli.access.enable.success" = "O ponto de acesso escuta em %@.";
/* One-line summary of 'ojd access grant' in the command list and at the top of its help. A token is a named secret for pages served over the WebSocket. */
"cli.access.grant.abstract" = "Permite que um programa assinado, ou um novo token, use o ponto de acesso.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ tem assinatura ad-hoc ou não está assinado, então qualquer programa local pode reivindicar a assinatura dele. Assine-o com um certificado Developer ID ou Apple Development e depois conceda acesso.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
"platform.macos.cli.access.grant.platformWarning" = "A Apple assinou este programa. Se ele executa scripts, como python3 ou osascript, todo script que ele executar recebe esse acesso.";
/* Error of 'ojd access grant' when neither CLIENT nor --token is given, or both are. CLIENT and --token NAME stay as written. */
"cli.access.grant.clientOrToken" = "Informe CLIENT ou --token NAME.";
/* Yes or no question that 'ojd access grant' asks before it allows a program. %1$@ is the program identifier, %2$@ describes its code signer and %3$@ lists the scopes granted. */
"cli.access.grant.confirm" = "Permitir que %1$@, assinado como %2$@, use o ponto de acesso com %3$@?";
/* Warning printed before the question of 'ojd access grant' when the control scope is requested. Control lets the program press buttons on a virtual gamepad. */
"cli.access.grant.controlWarning" = "O escopo control permite que o programa pressione botões de um gamepad virtual, que jogos e apps tratam como a sua entrada.";
/* Long description in the help of 'ojd access grant'. It explains that the grant names the signature of the program and which programs cannot be granted. CLIENT and command names stay as written. */
"cli.access.grant.discussion" = "CLIENT é o caminho do programa ou um ID de “ojd access list”. A permissão se refere à assinatura do programa, então continua válida quando o programa é atualizado ou movido. Programas com assinatura ad-hoc e programas não assinados não podem receber acesso. Com --token no lugar de CLIENT, cria um token com o qual um cliente assina o desafio do serviço no hello dele, pelo soquete, pelo WebSocket a partir de uma página de um dos valores de --origin ou, no caso de um token sem --origin, pelo WebSocket a partir de um programa que não envia o cabeçalho Origin, como um app em sandbox. Uma página não pode usar o escopo control. O token é mostrado apenas uma vez. Pede confirmação primeiro.";
/* Help text of the --origin option of 'ojd access grant'. An origin is a web address such as http://127.0.0.1:8080; PORT in the second example stays as written. */
"cli.access.grant.origin" = "Uma origem web, como http://127.0.0.1:8080, cujas páginas podem usar o token no WebSocket. Repita para adicionar mais. As páginas de overlay que o WebSocket serve têm a origem http://127.0.0.1:PORT, com a porta que “ojd access status” mostra.";
/* Error of 'ojd access grant' when --origin is combined with the control scope. --origin stays as written. */
"cli.access.grant.originControl" = "--origin não pode ser combinado com o escopo control. Uma página nunca controla um gamepad virtual; conceda control a um token sem --origin.";
/* Error of 'ojd access grant' when --origin is given without --token. Both option names stay as written. */
"cli.access.grant.originNeedsToken" = "--origin exige --token.";
/* Help text of the --scope option of 'ojd access grant'. The values read and control stay as written because the user types them. */
"cli.access.grant.scope" = "Um escopo a conceder: read ou control. Repita para ambos.";
/* Message printed after 'ojd access grant' allowed a program. %1$@ is the list of granted scopes, %2$@ is the program identifier and %3$@ is the client ID. */
"cli.access.grant.success" = "%1$@ concedido a %2$@ (ID %3$@).";
/* Help text of the --token option of 'ojd access grant'. It creates a named token instead of granting a program. */
"cli.access.grant.token" = "Cria um token com este nome em vez de autorizar um programa.";
/* Yes or no question of 'ojd access grant --token' for a token without origins. %1$@ is the token name and %2$@ is the list of scopes. */
"platform.macos.cli.access.grant.tokenConfirm" = "Criar o token %1$@ com %2$@, para programas neste Mac?";
/* Message printed after 'ojd access grant --token' created a token; the line ends with a colon because the secret value follows on the next line. %1$@ is the list of granted scopes, %2$@ is the token name and %3$@ is the token ID. */
"cli.access.grant.tokenSuccess" = "%1$@ concedido ao token %2$@ (ID %3$@). Mantenha o token em segredo; ele não será mostrado novamente:";
/* Yes or no question of 'ojd access grant --token --origin' for a token with origins. %1$@ is the token name, %2$@ is the list of scopes and %3$@ is the list of origins. */
"platform.macos.cli.access.grant.tokenWebConfirm" = "Criar o token %1$@ com %2$@, para programas neste Mac e para páginas de %3$@?";
/* One-line summary of 'ojd access list' in the command list and at the top of its help. */
"cli.access.list.abstract" = "Lista os clientes e tokens autorizados e os recusados nas últimas 24 horas.";
/* Long description in the help of 'ojd access list'. It says that the printed IDs work with 'ojd access grant' and 'ojd access revoke'. token:NAME stays as written. */
"cli.access.list.discussion" = "Cada cliente tem um ID que “ojd access grant” e “ojd access revoke” aceitam; o ID de um token é token:NAME.";
/* Heading of the list of granted clients printed by 'ojd access list'. */
"cli.access.list.granted" = "Autorizados:";
/* Indented line printed under a heading of 'ojd access list' when the list is empty. Keep the two leading spaces. */
"cli.access.list.none" = "  Nenhum";
/* Heading of the list of clients that connected and were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refused" = "Recusados nas últimas 24 horas:";
/* Heading of the list of tokens that were refused in the last 24 hours, printed by 'ojd access list'. */
"cli.access.list.refusedTokens" = "Tokens recusados nas últimas 24 horas:";
/* Heading of the list of granted tokens printed by 'ojd access list'. */
"cli.access.list.tokens" = "Tokens autorizados:";
/* Lowercase placeholder printed in the token list when a refused token has no name. */
"cli.access.list.unknownToken" = "token desconhecido";
/* Error of 'ojd access' commands that change who may read the controllers, when the input is not a terminal and --force is missing. --force stays as written. */
"cli.access.group.needsForce" = "Esta alteração dá aos programas acesso aos seus controles. Adicione --force para confirmar sem solicitação.";
/* One-line summary of 'ojd access revoke' in the command list and at the top of its help. */
"cli.access.revoke.abstract" = "Remove a permissão de um programa ou alguns dos escopos dela.";
/* Help text of the CLIENT argument of 'ojd access revoke'. token:NAME stays as written. */
"cli.access.revoke.client" = "O caminho do programa, um ID de cliente ou token:NAME.";
/* Long description in the help of 'ojd access revoke'. CLIENT, --scope, 'ojd access list' and token:NAME stay as written. */
"cli.access.revoke.discussion" = "CLIENT é o caminho do programa, um ID de “ojd access list” ou token:NAME para um token. Sem --scope, remove toda a permissão. As conexões que perdem um escopo são fechadas.";
/* Message printed after 'ojd access revoke --scope' removed some scopes. %1$@ is the client ID, %2$@ is the list of scopes it keeps and %3$@ is the number of connections that were closed. */
"cli.access.revoke.partial" = "O cliente %1$@ mantém %2$@. Conexões fechadas: %3$@.";
/* Help text of the --scope option of 'ojd access revoke'. The values read and control stay as written because the user types them. */
"cli.access.revoke.scope" = "Um escopo a remover: read ou control. Repita para ambos.";
/* Message printed after 'ojd access revoke' removed a whole grant. %1$@ is the client ID and %2$@ is the number of connections that were closed. */
"cli.access.revoke.success" = "A permissão do cliente %1$@ foi removida. Conexões fechadas: %2$@.";
/* One-line summary of 'ojd access status' in the command list and at the top of its help. */
"cli.access.status.abstract" = "Mostra se o ponto de acesso está ativado, o soquete dele e os clientes conectados.";
/* Line of 'ojd access status' with three counts. %1$@ is the number of connected clients, %2$@ the number of granted clients and %3$@ the number of clients refused in the last 24 hours. */
"cli.access.status.counts" = "Clientes conectados: %1$@. Clientes autorizados: %2$@. Recusados nas últimas 24 horas: %3$@.";
/* Line of 'ojd access status' when the endpoint is off. Keep the colon and the space after it. */
"cli.access.status.off" = "Ponto de acesso: desativado";
/* Line of 'ojd access status' when the endpoint is on. Keep the colon and the space after it. */
"cli.access.status.on" = "Ponto de acesso: ativado";
/* Line of 'ojd access status' that shows where the endpoint listens. %@ is the socket path. */
"cli.access.status.socket" = "Soquete: %@";
/* Line of 'ojd access status' with two token counts. %1$@ is the number of granted tokens and %2$@ the number of tokens refused in the last 24 hours. */
"cli.access.status.tokenCounts" = "Tokens autorizados: %1$@. Tokens recusados nas últimas 24 horas: %2$@.";
/* Line of 'ojd access status' when the WebSocket is turned on but its port could not be opened. %@ is the port number. */
"cli.access.status.webClosed" = "WebSocket: ativado, mas não foi possível abrir a porta %@";
/* Line of 'ojd access status' when the WebSocket is off. Keep the colon and the space after it. */
"cli.access.status.webOff" = "WebSocket: desativado";
/* Line of 'ojd access status' when the WebSocket is on. %1$@ is the WebSocket address, %2$@ is the address of the overlay pages and %3$@ is the folder they are served from. */
"cli.access.status.webOn" = "WebSocket: ativado em %1$@; páginas de overlay em %2$@ a partir de %3$@";
/* One-line summary of 'ojd access web' in the command list and at the top of its help. The WebSocket serves overlay pages. */
"cli.access.web.abstract" = "Ativa ou desativa o WebSocket para páginas de overlay.";
/* One-line summary of 'ojd access web disable' in the command list and at the top of its help. */
"cli.access.web.disableAbstract" = "Desativa o WebSocket e fecha as conexões dele; os tokens são mantidos.";
/* Message printed after 'ojd access web disable' turned the WebSocket off. */
"cli.access.web.disableSuccess" = "O WebSocket está desativado e as conexões dele foram fechadas.";
/* Long description in the help of 'ojd access web'. It names the address, the path /endpoint and the Overlays folder, which stay as written, and explains which pages may connect. */
"cli.access.web.discussion" = "O WebSocket escuta apenas em 127.0.0.1, em /endpoint, e serve os arquivos da pasta Overlays dele na mesma porta. Uma página precisa vir de uma origem para a qual um token foi autorizado e assinar o desafio do serviço com esse token no hello dela; autorize um com “ojd access grant --token NAME --origin URL”.";
/* One-line summary of 'ojd access web enable' in the command list and at the top of its help. */
"cli.access.web.enableAbstract" = "Ativa o WebSocket.";
/* Yes or no question that 'ojd access web enable' asks on a terminal before it turns the WebSocket on. */
"cli.access.web.enableConfirm" = "Ativar o WebSocket, para que páginas das origens para as quais você autoriza tokens possam usar o ponto de acesso?";
/* Long description in the help of 'ojd access web enable'. It says that a confirmation comes first and how the port is chosen. --port stays as written. */
"cli.access.web.enableDiscussion" = "Pede confirmação primeiro. Sem --port, usa a porta salva; na primeira vez, o sistema escolhe uma porta livre e o serviço a salva.";
/* Help text of the --port option of 'ojd access web enable'. The range is a fixed fact of the command. */
"cli.access.web.port" = "A porta em 127.0.0.1, de 1024 a 65535.";
/* Help text of the --automatic option of 'ojd access web enable'. */
"cli.access.web.automatic" = "Deixar o sistema escolher uma porta livre em vez da salva.";
/* Error of 'ojd access web enable' when --automatic and --port are both given. Both option names stay as written. */
"cli.access.web.automaticConflict" = "--automatic não pode ser usado com --port.";
/* Error of 'ojd access web enable' when --port is outside the allowed range. --port stays as written. */
"cli.access.web.portRange" = "--port deve estar entre 1024 e 65535.";
/* One-line summary of 'ojd diagnose' in the command list and at the top of its help. */
"cli.diagnose.group.abstract" = "Executa todas as verificações e informa o que está errado.";
/* Help text of the --output option of 'ojd diagnose'. A support bundle is a file with the diagnostic report for a bug report. */
"cli.diagnose.group.output" = "Grava também um pacote de suporte neste arquivo.";
/* Error of 'ojd diagnose --output' when the support bundle could not be written. %@ is the reason from the system. --output stays as written. */
"cli.diagnose.group.outputFailed" = "O pacote de suporte não foi gravado: %@. Escolha outro caminho para --output.";
/* Error of 'ojd diagnose --output' when the folder of the path is missing. %@ is the folder path. --output stays as written. */
"cli.diagnose.group.outputParent" = "--output precisa de um diretório existente; %@ não existe.";
/* Progress line of 'ojd diagnose --output' while the support bundle is written. Keep the three dots. */
"cli.diagnose.group.outputProgress" = "Gravando o pacote de suporte…";
/* Message printed after 'ojd diagnose --output' wrote the support bundle. %@ is the file path. The bundle lists the names of the devices, so the user should read it first. */
"cli.diagnose.group.outputWritten" = "Pacote de suporte gravado em %@. Revise-o antes de compartilhar; ele inclui os nomes dos dispositivos.";
/* Long description in the help of 'ojd diagnose'. pass, warn, fail and skip are the check results printed by the command and stay as written, as do --soak and the other option names. */
"cli.diagnose.group.discussion" = "Cada verificação informa pass, warn, fail ou skip. As verificações que precisam do serviço são ignoradas enquanto ele está parado. Termina com código 1 quando alguma verificação falha. --soak acrescenta uma verificação de integridade em execução que amostra o serviço pelo tempo indicado; sem ele, essa verificação é ignorada. --output também grava um relatório de suporte; revise-o antes de compartilhar.";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has no registration of the extension. The command in quotes stays as written. */
"platform.macos.cli.diagnose.group.transportExtensionAbsent" = "não registrada no macOS; execute “ojd transport-extension activate”";
/* Detail of the transport extension check of 'ojd diagnose' when macOS has the extension active. */
"platform.macos.cli.diagnose.group.transportExtensionActive" = "ativa no macOS";
