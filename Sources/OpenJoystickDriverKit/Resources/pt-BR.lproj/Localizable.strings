"cli.explain.group.abstract" = "Explica um código de erro: o que significa e como corrigi-lo.";
/* Long description in the help of 'ojd explain'. ojd explain stays as written. The code case does not matter, so E2004 and e2004 are the same. */
"cli.explain.group.discussion" = "ojd explain cobre todos os códigos de erro. Funciona offline e maiúsculas ou minúsculas no código não importam.";
/* Help text of the CODE argument of 'ojd explain'. E2004 is an example of an error code and stays as written. */
"cli.explain.group.code" = "O código de erro, por exemplo E2004.";
/* Error of 'ojd explain' when the code does not exist. %@ is the text the user gave. Error-Codes is the name of a wiki page and stays as written. */
"cli.explain.group.unknown" = "%@ não é um código de erro ativo. Verifique a grafia; a página Error-Codes da wiki lista todos os códigos.";
/* Line of the output of 'ojd explain' that names the area of the error. %@ is the area name, one of the area labels. */
"cli.explain.group.area" = "Área: %@";
/* Area label in the output of 'ojd explain' for errors of the endpoint that programs connect to. */
"cli.explain.group.areaEndpoint" = "Ponto de acesso";
/* Area label in the output of 'ojd explain' for errors of the command line. */
"cli.explain.group.areaCli" = "Linha de comando";
/* Area label in the output of 'ojd explain' for errors of button remapping. */
"cli.explain.group.areaRemapping" = "Remapeamento";
/* Area label in the output of 'ojd explain' for errors of mod packages, the packages that add controller support. */
"cli.explain.group.areaMod" = "Pacotes de mods";
/* Area label in the output of 'ojd explain' for errors of the documents that the driver reads, such as profiles and records. */
"cli.explain.group.areaDocument" = "Documentos";
/* Line of the output of 'ojd explain' with the exit status that the command ends with for this error. %@ is the number. */
"cli.explain.group.exitCode" ="Código de saída: %@";
/* Line of the output of 'ojd explain' with the wire value of the code, which other programs read. %@ is that value and stays as written. */
"cli.explain.group.wire" = "Valor de transmissão: %@";
/* Error when the installed app is older than the repository sources that built this ojd. The build command, the environment variable OJD_RUN_REPOSITORY_CLI=1 and OpenJoystickDriver.app stay as written. */
"cli.shared.error.staleInstallation" = "O OpenJoystickDriver.app instalado é mais antigo que estas fontes do repositório. Execute “./Scripts/ojd build install-fast dev” ou defina OJD_RUN_REPOSITORY_CLI=1 para executar esta compilação.";
/* Error when ojd cannot hand the command line to the installed ojd. ojd stays as written. */
"cli.shared.error.forwarderAllocation" = "Não foi possível reservar os argumentos do ojd instalado. Execute o comando novamente.";
/* Error when ojd cannot start the installed ojd. %@ is the reason from the system. OpenJoystickDriver.app stays as written. */
"cli.shared.error.forwarderExec" = "Não foi possível executar o ojd instalado: %@. Reinstale o OpenJoystickDriver.app.";
/* Text of error E2001, printed when ojd meets a failure that has no code of its own. ojd and the command in quotes stay as written. */
"error.E2001.message" = "O ojd encontrou um erro que não reconhece. Execute “ojd diagnose” e relate o problema junto com a saída.";
/* Text of error E2002, printed when the first word after ojd is not a command. ojd and the command in quotes stay as written. */
"error.E2002.message" = "Este não é um comando do ojd. Execute “ojd --help” para ver os comandos.";
/* Text of error E2003, printed when the options or values of a command are wrong or missing. --help stays as written. */
"error.E2003.message" = "A linha de comando tem uma opção ou um valor incorreto ou ausente. Execute o comando com --help para ver o que ele espera.";
/* Text of error E2004, printed when a command needs the service and it is not running. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2004.message" = "O serviço do OpenJoystickDriver não está em execução. Inicie-o com “ojd service start”.";
/* Text of error E2005, printed when the service does not answer in time. The command in quotes and --timeout stay as written. */
"error.E2005.message" = "O serviço não respondeu a tempo. Verifique-o com “ojd status” ou espere mais com --timeout.";
/* Text of error E2006, printed when the service reports that it could not complete a request. The command in quotes stays as written. */
"error.E2006.message" = "O serviço não concluiu a solicitação. Verifique-o com “ojd status” e tente novamente.";
/* Text of error E2007, printed when the service refuses this ojd because its code signature differs from the app. ojd and OpenJoystickDriver.app stay as written. */
"error.E2007.message" = "O serviço recusou este ojd porque ele não está assinado como o app. Execute o ojd que vem com o OpenJoystickDriver.app.";
/* Text of error E2008, printed when a command needs a macOS permission that is missing. The command in quotes stays as written. */
"error.E2008.message" = "Falta uma permissão. Conceda-a com “ojd permission request”.";
/* Text of error E2009, printed when a command that changes or deletes data runs without a terminal and without --force. --force stays as written. */
"error.E2009.message" = "Este comando altera ou exclui dados e precisa de confirmação. Execute-o novamente com --force.";
/* Text of error E2010, printed when a command stops before it finishes because the user declined, an editor failed or no input came. */
"error.E2010.message" = "O comando parou antes de terminar porque você recusou, um editor falhou ou nenhuma entrada chegou. Execute-o novamente.";
/* Text of error E2011, printed when a profile file or a record file is not valid against its schema. */
"error.E2011.message" = "O arquivo de perfil ou de registro é inválido. Corrija-o conforme o esquema e tente novamente.";
/* Text of error E2012, printed when a name matches no controller, profile, binding or client, or matches more than one. The word list in quotes is the name of the matching list command and stays as written. */
"error.E2012.message" = "Nenhum controle, perfil, atribuição ou cliente corresponde, ou mais de um corresponde. Liste-os com o comando “list” apropriado e informe exatamente um.";
/* Text of error E2013, printed when the controller cannot take a requested action. The command in quotes stays as written. */
"error.E2013.message" = "O controle não pode fazer isso agora. Ele pode não ser compatível, não estar pronto ou estar desconectado. Verifique-o com “ojd controller list”.";
/* Text of error E2014, printed when the app is not fully installed or its signature is not valid. OpenJoystickDriver is the product name. The command in quotes stays as written. */
"error.E2014.message" = "O OpenJoystickDriver não está totalmente instalado ou sua assinatura é inválida. Reinstale o app e execute “ojd diagnose”.";
/* Text of error E2015, printed when macOS does not complete or apply a request of the driver. */
"error.E2015.message" = "O sistema não concluiu ou não aplicou a solicitação. Verifique os ajustes do sistema e tente novamente.";
/* Text of error E2016, printed when a file cannot be read, written or deleted, or is present although it must not be. */
"error.E2016.message" = "Não foi possível ler, gravar ou excluir um arquivo, ou ele já existe. Verifique o caminho e suas permissões.";
/* Text of error E2017, printed when a client is unsigned or signed ad hoc and so cannot be granted access. Developer ID is the name of an Apple signing identity and stays as written. */
"error.E2017.message" = "Esse cliente não está assinado ou tem assinatura ad hoc, então não pode obter acesso. Assine-o com um Developer ID e tente novamente.";
/* Text of error E2018, printed when 'ojd diagnose' found a failed check. The command in quotes stays as written. */
"error.E2018.message" = "O “ojd diagnose” encontrou uma verificação com falha. Leia a saída e corrija os itens que falharam.";
/* Text of error E2019, printed when the check for updates did not finish. */
"error.E2019.message" = "A verificação de atualizações não terminou. Verifique sua conexão de rede e tente novamente.";
/* Text of error E2020, printed when the installed app is older than the ojd that runs. OpenJoystickDriver is the product name. The build command and OJD_RUN_REPOSITORY_CLI=1 stay as written. */
"error.E2020.message" = "O app OpenJoystickDriver instalado é mais antigo que este ojd. Execute “./Scripts/ojd build install-fast dev” ou defina OJD_RUN_REPOSITORY_CLI=1 para executar esta compilação.";
/* Text of error E2021, printed when an ojd built from the repository cannot hand a command to the installed app. OpenJoystickDriver.app stays as written. */
"error.E2021.message" = "Uma compilação do ojd do repositório não conseguiu repassar o comando ao app instalado. Reinstale o OpenJoystickDriver.app e execute o comando novamente.";
/* Text of error E3001, returned when a remapping request names a controller that is not connected or not ready. */
"error.E3001.message" = "O controle não está conectado ou não está pronto para o remapeamento. Reconecte-o e tente novamente.";
/* Text of error E3002, returned when two Joy-Cons cannot be paired into one controller. Joy-Con is a Nintendo product name. */
"error.E3002.message" = "Não foi possível parear os Joy-Cons selecionados. Atualize os controles conectados e tente novamente.";
/* Text of error E3003, returned when a motion request names a controller without a motion sensor. */
"error.E3003.message" = "O controle não informa dados de movimento. Escolha um controle com sensores de movimento ou deixe as opções de movimento desativadas.";
/* Text of error E3004, returned when a value in a request is larger than the service accepts. */
"error.E3004.message" = "Um valor na solicitação é maior do que o serviço aceita. Envie um valor menor.";
/* Text of error E3005, returned when the list of active profiles is damaged and cannot be loaded. */
"error.E3005.message" = "A lista de perfis ativos está danificada e não pôde ser carregada. Repare ou remova o arquivo danificado e tente novamente.";
/* Text of error E3006, returned when a profile name is in use. The command in quotes stays as written. */
"error.E3006.message" = "Já existe um perfil com este nome. Escolha outro nome; “ojd profile list” mostra os nomes em uso.";
/* Text of error E3007, returned when a request has missing or invalid arguments. */
"error.E3007.message" = "A solicitação tem argumentos ausentes ou inválidos. Verifique os valores e tente novamente.";
/* Text of error E3008, returned when a profile is not valid. */
"error.E3008.message" = "O perfil é inválido. Verifique os mapeamentos e tente novamente.";
/* Text of error E3009, returned when saving a profile would make the profile library too large. */
"error.E3009.message" = "A biblioteca de perfis ficaria grande demais. Exclua perfis de que você não precisa e tente novamente.";
/* Text of error E3010, returned when a profile with the same identifier exists. */
"error.E3010.message" = "Já existe um perfil com este identificador. Use um novo identificador ou atualize o perfil existente.";
/* Text of error E3011, returned when a profile changed elsewhere after the client loaded it. */
"error.E3011.message" = "O perfil foi alterado em outro lugar depois que você o carregou. Carregue-o novamente e refaça a alteração.";
/* Text of error E3012, returned when the library holds the largest number of profiles it allows. */
"error.E3012.message" = "A biblioteca já tem o número máximo de perfis permitido. Exclua um perfil de que você não precisa e tente novamente.";
/* Text of error E3013, returned when no profile has the identifier. The command in quotes stays as written. */
"error.E3013.message" = "Nenhum perfil tem este identificador. Liste os perfis com “ojd profile list”.";
/* Text of error E3014, returned when the service cannot encode its reply. */
"error.E3014.message" = "O serviço não conseguiu codificar sua resposta. Tente novamente e relate o problema se ele persistir.";
/* Text of error E3015, returned when the reply exceeds the largest size the service can send. */
"error.E3015.message" = "A resposta é maior do que o serviço pode enviar. Peça menos dados e tente novamente.";
/* Text of error E3016, returned when the remapping engine is not available yet. */
"error.E3016.message" = "O mecanismo de remapeamento não está disponível. Aguarde um momento e tente novamente, ou reinicie o serviço.";
/* Text of error E3017, returned when neither the profile library nor the remapping engine is available yet. */
"error.E3017.message" = "A biblioteca de perfis e o mecanismo de remapeamento não estão disponíveis. Aguarde um momento e tente novamente, ou reinicie o serviço.";
/* Text of error E3018, returned when the profile library is not available yet. */
"error.E3018.message" = "A biblioteca de perfis não está disponível. Aguarde um momento e tente novamente, ou reinicie o serviço.";
/* Text of error E3019, returned when the remapping router has shut down. */
"error.E3019.message" = "O roteador de remapeamento foi encerrado. Reinicie o serviço e tente novamente.";
/* Text of error E3020, returned when the service cannot tell whether the last profile change is saved. */
"error.E3020.message" = "O serviço não conseguiu confirmar se a última alteração de perfil foi salva. Recarregue os perfis e verifique-os antes de alterá-los novamente.";
/* Text of error E3021, returned when a profile file cannot be read. */
"error.E3021.message" = "Não foi possível ler um arquivo de perfil. Verifique se o arquivo existe e se o serviço pode lê-lo.";
/* Text of error E3022, returned when damaged profile files block every profile change. */
"error.E3022.message" = "Arquivos de perfil danificados precisam ser reparados ou removidos antes que os perfis possam ser alterados. Repare ou remova-os e tente novamente.";
/* Text of error E3023, returned when a profile file cannot be written. */
"error.E3023.message" = "Não foi possível gravar um arquivo de perfil. Verifique o espaço livre em disco e as permissões da pasta.";
/* Text of error E3024, returned when the remapping service meets a failure it does not recognize. The command in quotes stays as written. */
"error.E3024.message" = "O serviço de remapeamento encontrou um erro que não reconhece. Execute “ojd diagnose” e relate o problema junto com a saída.";
/* Text of error E3025, returned when a profile that produces no output is activated. --allow-empty stays as written. */
"error.E3025.message" = "O perfil não produz nenhuma saída. Adicione a ele uma atribuição ou uma cor de luz, ou ative-o com --allow-empty.";
/* Text of error E3026, returned when a Joy-Con pair profile needs a gyro calibration of the other Joy-Con. Joy-Con is a Nintendo product name. */
"error.E3026.message" = "O perfil do par de Joy-Con usa o giroscópio do outro Joy-Con. Calibre o movimento do controle que o perfil seleciona para o giroscópio.";
/* Text of error E3027, returned when a motion request names a controller with no active remapping profile. */
"error.E3027.message" = "Nenhum perfil de remapeamento está ativo para o controle, então ele não processa movimento. Ative um perfil para ele, traga o app de destino para a frente e tente novamente.";
/* Text of error E3028, returned when the remapping session of the controller changed while a request ran. */
"error.E3028.message" = "A sessão de remapeamento do controle mudou enquanto a solicitação era executada. Tente novamente.";
/* Text of error E3029, returned when a profile that comes from an installed package is edited. */
"error.E3029.message" = "Um perfil de um pacote instalado não pode ser alterado. Duplique o perfil e altere a cópia.";
/* Text of error E4001, printed when the manifest of a mod package is missing or invalid. mod.json stays as written. */
"error.E4001.message" = "O manifesto do pacote mod.json está ausente ou é inválido. Verifique-o com o esquema mod-package e execute o comando novamente.";
/* Text of error E4002, printed when a mod package requires another version of the app than the one that runs. OpenJoystickDriver is the product name. */
"error.E4002.message" = "O pacote exige uma versão do OpenJoystickDriver diferente da que está em execução. Instale uma versão do pacote compatível com esta versão ou atualize o OpenJoystickDriver.";
/* Text of error E4003, printed when a file of a mod package is invalid, missing or not listed in the manifest. mod.json stays as written. */
"error.E4003.message" = "Um arquivo do pacote é inválido, está ausente ou não consta em mod.json. Corrija o arquivo indicado pelo comando e execute-o novamente.";
/* Text of error E4004, printed when a mod package covers a controller, persona or profile that the user's files or another package hold. */
"error.E4004.message" = "O pacote abrange um controle, uma persona ou um perfil que seus próprios arquivos ou outro pacote instalado já possuem. Remova o arquivo ou pacote em conflito, ou altere o pacote, e execute o comando novamente.";
/* Text of error E4005, printed when a mod package of the same name is installed. --force stays as written. */
"error.E4005.message" = "Já existe um pacote instalado com este nome. Execute o comando com --force para substituí-lo.";
/* Text of error E4006, printed when no installed mod package has the name. The command in quotes stays as written. */
"error.E4006.message" = "Nenhum pacote instalado tem este nome. Execute ojd mod list para ver os pacotes instalados.";
/* Text of error E4007, printed when the folder of the installed mod packages cannot be changed. */
"error.E4007.message" = "Não foi possível alterar a pasta de pacotes. Verifique o espaço livre em disco e as permissões da pasta.";
/* Text of error E5001, printed when a document has no apiVersion or an unsupported one. apiVersion stays as written. OpenJoystickDriver is the product name. */
"error.E5001.message" = "Um documento não tem apiVersion, ou sua apiVersion não é compatível com esta versão do OpenJoystickDriver. Altere o documento para a apiVersion compatível que a mensagem indica e execute o comando novamente.";
/* Text of error E5002, printed when a protocol description is invalid against its schema. */
"error.E5002.message" = "Uma descrição de protocolo é inválida. Verifique o arquivo com o esquema protocol-description e corrija o campo que a mensagem indica.";
/* Text of error E5003, printed when the family in a protocol description differs from its file name. */
"error.E5003.message" = "Uma descrição de protocolo indica uma família diferente do nome do arquivo. Dê ao arquivo o nome da sua família.";
/* Text of error E5004, printed when a protocol description lists a variant that its family lacks. */
"error.E5004.message" = "Uma descrição de protocolo lista uma variante que a família não tem. Use uma das variantes da família.";
/* Text of error E5005, printed when the access file is damaged. AccessGrants.json is a file name and stays as written. */
"error.E5005.message" = "O arquivo de acesso AccessGrants.json está danificado. Corrija o arquivo ou exclua-o e conceda o acesso novamente.";
/* Text of error E5006, printed when the key file of the unit IDs cannot be read or has the wrong size. PortKeyInstallation.key is a file name and stays as written. OpenJoystickDriver is the product name. */
"error.E5006.message" = "Não é possível ler o arquivo de chave dos IDs da Unidade, PortKeyInstallation.key, ou ele não tem 32 bytes. Restaure o arquivo a partir de um backup. Se você o apagar, o OpenJoystickDriver cria uma nova chave e todos os IDs da Unidade mudam.";
/* Error E5007, shown when a controller record or patch fails its schema; the message names the field. */
"error.E5007.message" = "Um registro de controle ou um patch é inválido. Verifique o arquivo com o esquema dele e corrija o campo que a mensagem indica.";
"ui.error.withCode" = "%1$@ (%2$@)";

