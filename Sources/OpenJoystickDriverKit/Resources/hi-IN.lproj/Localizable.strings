"cli.virtual.feed.abstract" = "stdin से चलने वाला वर्चुअल गेमपैड प्रकाशित करें।";
"cli.virtual.feed.discussion" = "हर पंक्ति में एक JSON ऑब्जेक्ट पढ़ता है: “buttons” और “dpad” दबाए गए कंट्रोल की सूची देते हैं, जैसे South और up, और “axes” अक्ष के नामों, जैसे LeftStickX, को मानों से जोड़ता है। जो कंट्रोल नहीं दिए गए हैं, वे न्यूट्रल रहते हैं। स्टिक -1 से 1 तक चलते हैं और Y नीचे की ओर होता है; ट्रिगर 0 से 1 तक चलते हैं। फ़्रेम क्रम से चलते हैं, हर फ़्रेम कम से कम 8 ms के लिए; “holdMilliseconds” किसी फ़्रेम को ज़्यादा देर तक रोकता है, 60000 तक। गेम गेमपैड को जो भी आउटपुट कमांड भेजते हैं, जैसे वाइब्रेशन, उसे हर पंक्ति में एक JSON ऑब्जेक्ट के रूप में प्रिंट करता है। इनपुट खत्म होने के बाद सभी फ़्रेम चल जाने पर रुक जाता है।";
"cli.virtual.feed.error.closed" = "सेवा ने वर्चुअल गेमपैड बंद कर दिया। “ojd status” से जाँचें।";
"cli.virtual.feed.error.closeInterrupted" = "वर्चुअल गेमपैड को बंद करने की प्रक्रिया बीच में रुक गई। “ojd status” से जाँचें।";
"cli.virtual.feed.error.frame" = "पंक्ति %@ मान्य फ़्रेम नहीं है। “ojd virtual feed --help” प्रारूप दिखाता है।";
"cli.virtual.feed.profile" = "प्रकाशित किया जाने वाला वर्चुअल गेमपैड प्रोफ़ाइल।";
"cli.virtual.feed.started" = "%@ वर्चुअल गेमपैड प्रकाशित हो रहा है। फ़्रेम stdin पर लिखें; रोकने के लिए इनपुट खत्म करें या Control-C दबाएँ।";
"cli.virtual.launch.abstract" = "कनेक्ट किए गए वर्चुअल गेमपैड के SDL मैपिंग के साथ एक प्रोग्राम चलाता है।";
"cli.virtual.launch.command" = "चलाया जाने वाला प्रोग्राम और उसके आर्गुमेंट। प्रोग्राम एक पाथ, PATH को मिलने वाला नाम या एक .app होता है। जब प्रोग्राम के आर्गुमेंट ojd के विकल्प भी हों, तो प्रोग्राम से पहले -- लगाएँ।";
"cli.virtual.launch.discussion" = "SDL_GAMECONTROLLERCONFIG को हर कनेक्टेड कंट्रोलर के वर्चुअल गेमपैड की मैपिंग पर सेट करता है, ताकि प्रोग्राम में SDL उन्हें सूचीबद्ध करे। पहले से सेट मान सबसे आगे रहता है और मैपिंग उसके बाद आती हैं। .app अपनी मुख्य एक्ज़ीक्यूटेबल चलाता है। प्रोग्राम इसी टर्मिनल का उपयोग करता रहता है। ojd को रोकने से प्रोग्राम रुकता है, और ojd प्रोग्राम की स्थिति के साथ बाहर निकलता है।";
"cli.virtual.launch.error.failed" = "%@ शुरू नहीं हुआ (%@)। जाँचें कि यह एक्ज़ीक्यूटेबल फ़ाइल या ऐप है और आपको इसे चलाने की अनुमति है।";
