"cli.virtual.feed.errorPlain" = "--plain не применяется к «virtual feed», которая выводит строки JSON. Уберите --plain.";
"cli.controller.watch.examples" = "Примеры:\n  # Выводить ввод 10 секунд\n  ojd controller watch 045E:028E --duration 10\n  # Вывести первый нажатый элемент управления в JSON\n  ojd controller watch 045E:028E --first-press --json\n  # Следить за всеми контроллерами и тем, что отправляет их виртуальный геймпад\n  ojd controller watch --all --output";
"cli.controller.rumble.examples" = "Примеры:\n  # Включить оба основных мотора на 180 на 0,45 секунды\n  ojd controller rumble 045E:028E\n  # Включить оба основных мотора на полную мощность на 2 секунды\n  ojd controller rumble 045E:028E --left 255 --right 255 --duration 2";
"cli.controller.light.examples" = "Примеры:\n  # Задать оранжевый цвет световой панели\n  ojd controller light 054C:09CC --color FF8000\n  # Задать цвет и низкую яркость\n  ojd controller light 054C:09CC --color 0000FF --brightness 40";
"cli.profile.create.examples" = "Примеры:\n  # Создать профиль для модели контроллера\n  ojd profile create Racing --controller 045E:028E\n  # Применять его, только пока Safari на переднем плане\n  ojd profile create Browsing --controller 045E:028E --app com.apple.Safari";
"cli.profile.set.examples" = "Примеры:\n  # Переименовать профиль\n  ojd profile set Racing name Rally\n  # Задать внутреннюю мёртвую зону первого сопоставления стика\n  ojd profile set Racing stickMappings.0.tuning.innerDeadzone 0.2";
"cli.binding.set.examples" = "Примеры:\n  # Удерживать пробел, пока удерживается южная кнопка\n  ojd binding set Racing button:south key:space\n  # Переключать J при каждом нажатии\n  ojd binding set Racing button:west key:key-j --behavior toggle\n  # Повторять J 10 раз в секунду, пока кнопка удерживается\n  ojd binding set Racing button:west key:key-j --turbo-rate 10 --turbo-duty 0.5";
"cli.record.install.examples" = "Примеры:\n  # Установить файл записи\n  ojd record install 045E-028E.json\n  # Прочитать запись из stdin\n  ojd record install - < 045E-028E.json";
"cli.access.grant.examples" = "Примеры:\n  # Разрешить программе использовать службу\n  ojd access grant /Applications/Example.app\n  # Создать токен для страниц, отдаваемых с одного источника\n  ojd access grant --token overlay --origin http://127.0.0.1:8080";
