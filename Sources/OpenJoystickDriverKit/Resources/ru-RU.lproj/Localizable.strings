"platform.macos.cli.controller.disconnect.discussion" = "Закрывает соединение классического Bluetooth. Контроллер остаётся сопряжённым и подключается снова при следующем включении. Ждёт подтверждения от Bluetooth не менее 6 секунд. Служба не может отключить контроллер Bluetooth Low Energy. Выключите его или отключите в Системных настройках > Bluetooth.";
/* Message printed after 'ojd controller disconnect' disconnected the controller. %@ is the controller name. */
"cli.controller.disconnect.done" = "%@ отключён.";
/* Error of 'ojd controller disconnect' for a Bluetooth Low Energy controller. %@ is the controller name. System Settings and Bluetooth are macOS names. */
"platform.macos.cli.controller.disconnect.bluetoothLe" = "%@ подключён по Bluetooth Low Energy, и служба не может его отключить. Выключите контроллер или отключите его в Системных настройках > Bluetooth.";
