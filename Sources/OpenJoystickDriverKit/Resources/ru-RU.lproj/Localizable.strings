"cli.access.grant.abstract" = "Разрешает подписанной программе или новому токену использовать конечную точку.";
/* Error of 'ojd access grant' for a program with an ad-hoc signature or none. %@ is the program identifier. Developer ID and Apple Development are names of certificate kinds and stay as written. */
"platform.macos.cli.access.grant.adHoc" = "%@ подписана ad-hoc или не подписана, поэтому любая локальная программа может присвоить её подпись. Подпишите её сертификатом Developer ID или Apple Development, затем предоставьте доступ.";
/* Warning of 'ojd access grant' about a program that Apple signed. python3 and osascript are program names and stay as written. */
