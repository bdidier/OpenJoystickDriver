"platform.macos.cli.access.grant.adHoc" = "%@ ditandatangani ad-hoc atau tidak ditandatangani, sehingga program lokal mana pun dapat mengklaim tanda tangannya. Tandatangani dengan sertifikat Developer ID atau Apple Development, lalu beri akses.";
"platform.macos.cli.access.grant.platformWarning" = "Apple menandatangani program ini. Jika menjalankan skrip, seperti python3 atau osascript, setiap skrip yang dijalankannya mendapat akses ini.";
"cli.access.grant.clientOrToken" = "Berikan CLIENT atau --token NAME.";
