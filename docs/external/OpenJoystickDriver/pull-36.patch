diff --git a/Tests/OpenJoystickDriverKitTests/Protocol/Parsers/FlydigiVader4ProModeTests.swift b/Tests/OpenJoystickDriverKitTests/Protocol/Parsers/FlydigiVader4ProModeTests.swift
