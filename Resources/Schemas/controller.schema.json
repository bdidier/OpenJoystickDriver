{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha1/controller.schema.json",
	"type": "object",
	"required": ["apiVersion", "kind", "vendorID", "productID", "protocol"],
	"additionalProperties": false,
	"properties": {
		"apiVersion": {
			"const": "openjoystickdriver/v1alpha1"
		},
		"kind": {
			"const": "Controller"
		},
		"vendorID": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"productID": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535
		},
		"protocol": {
			"$ref": "#/$defs/protocol"
		},
		"modes": {
			"$ref": "#/$defs/modes"
		},
		"usb": {
			"$ref": "#/$defs/usbOverride"
		},
		"bluetoothLE": {
			"$ref": "#/$defs/bluetoothLE"
		},
		"capabilities": {
			"$ref": "#/$defs/capabilities"
		},
		"ownership": {
			"$ref": "#/$defs/ownership"
		},
		"route": {
			"$ref": "#/$defs/route"
		},
		"output": {
			"$ref": "#/$defs/output"
		},
		"input": {
			"anyOf": [
				{
					"$ref": "#/$defs/input"
				},
				{
					"$ref": "#/$defs/hidInput"
				}
			]
		},
		"tuning": {
			"$ref": "#/$defs/tuning"
		}
	},
	"$defs": {
		"modes": {
			"description": "Alternative modes of one model. The record's protocol is the default mode, which a controller runs when no mode here matches or a probe gets no reply. Modes are tried in order and the first whose probes all hold is selected.",
			"type": "array",
			"minItems": 1,
			"items": {
				"$ref": "#/$defs/mode"
			}
		},
		"mode": {
			"type": "object",
			"required": ["id", "protocol", "match"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(?!\\n)$",
					"not": {
						"const": "default"
					}
				},
				"protocol": {
					"$ref": "#/$defs/protocol"
				},
				"match": {
					"$ref": "#/$defs/modeMatch"
				}
			}
		},
		"modeMatch": {
			"type": "object",
			"required": ["probes"],
			"additionalProperties": false,
			"properties": {
				"probes": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/modeProbe"
					}
				}
			}
		},
		"modeProbe": {
			"description": "A read of one feature report. A probe never writes. answers: the read succeeds. stalls: the device refuses the read. bytes: the reply holds the given bytes at offset.",
			"type": "object",
			"required": ["report", "length", "expect"],
			"additionalProperties": false,
			"properties": {
				"report": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"length": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"expect": {
					"enum": ["answers", "stalls", "bytes"]
				},
				"offset": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65534
				},
				"bytes": {
					"type": "string",
					"pattern": "^[0-9A-F]{2}( [0-9A-F]{2})*(?!\\n)$"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"expect": {
								"const": "bytes"
							}
						},
						"required": ["expect"]
					},
					"then": {
						"required": ["offset", "bytes"]
					},
					"else": {
						"properties": {
							"offset": false,
							"bytes": false
						}
					}
				}
			]
		},
		"protocol": {
			"type": "object",
			"required": ["family"],
			"additionalProperties": false,
			"properties": {
				"family": {
					"enum": [
						"hid.descriptor",
						"hid.report-layout",
						"xbox.xid",
						"xbox.xusb",
						"xbox.gip",
						"sony.sixaxis",
						"sony.dualshock4",
						"sony.dualsense",
						"nintendo.switch1",
						"nintendo.switch2",
						"nintendo.switch-input-only",
						"valve.steam-controller",
						"valve.steam-triton",
						"valve.steam-deck",
						"vendor.flydigi",
						"vendor.ps3-third-party",
						"vendor.gamesir",
						"vendor.nvidia-shield"
					]
				},
				"variant": {
					"enum": [
						"gamepad",
						"wired",
						"receiver",
						"dongle",
						"usb",
						"bluetooth-le",
						"enhanced-hid"
					]
				},
				"parameters": {
					"type": "object",
					"minProperties": 1
				},
				"initialization": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/gipInitializationAction"
					}
				},
				"keepAlive": {
					"type": "boolean"
				},
				"assembly": {
					"enum": []
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.xid"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["gamepad"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.xusb"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["wired", "receiver"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"enum": ["valve.steam-controller", "valve.steam-triton"]
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["wired", "dongle", "bluetooth-le"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "vendor.gamesir"
							}
						},
						"required": ["family"]
					},
					"then": {
						"required": ["variant"],
						"properties": {
							"variant": {
								"enum": ["usb", "enhanced-hid"]
							},
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"innerGrips": {
										"const": true
									},
									"lightingMemory": {
										"enum": ["ProfileSlots"]
									}
								}
							}
						},
						"allOf": [
							{
								"if": {
									"properties": {
										"variant": {
											"const": "usb"
										}
									},
									"required": ["variant"]
								},
								"then": {
									"not": {
										"required": ["parameters"]
									}
								}
							},
							{
								"if": {
									"properties": {
										"variant": {
											"const": "enhanced-hid"
										}
									},
									"required": ["variant"]
								},
								"then": {
									"required": ["parameters"],
									"properties": {
										"parameters": {
											"oneOf": [
												{
													"required": ["innerGrips"]
												},
												{
													"required": ["lightingMemory"]
												}
											]
										}
									}
								}
							}
						]
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"enum": [
										"xbox.xid",
										"xbox.xusb",
										"valve.steam-controller",
										"valve.steam-triton",
										"vendor.gamesir"
									]
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"required": ["variant"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"const": "xbox.gip"
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"anyOf": [
								{
									"required": ["keepAlive"]
								},
								{
									"required": ["initialization"]
								}
							]
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "xbox.gip"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"shareButton": {
										"type": "object",
										"additionalProperties": false,
										"required": ["fromEnd"],
										"properties": {
											"fromEnd": {
												"type": "integer",
												"minimum": 1,
												"maximum": 255
											}
										}
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "vendor.ps3-third-party"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"hatSource": {
										"enum": ["DpadPressure"]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "nintendo.switch1"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"layout": {
										"enum": ["Pro", "JoyConLeft", "JoyConRight"]
									},
									"usbProtocol": {
										"enum": ["ChargingOnly"]
									}
								},
								"not": {
									"required": ["usbProtocol", "layout"]
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "nintendo.switch2"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"layout": {
										"enum": ["Pro", "JoyConLeft", "JoyConRight", "GameCube"]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "sony.dualshock4"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"motionCalibration": {
										"enum": ["Factory"]
									},
									"role": {
										"enum": ["WirelessAdapter"]
									},
									"motionScale": {
										"enum": ["StrikePad"]
									}
								},
								"not": {
									"required": ["role", "motionScale"]
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "vendor.nvidia-shield"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"reportRevision": {
										"enum": ["Shield2015"]
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"const": "sony.dualsense"
							}
						},
						"required": ["family"]
					},
					"then": {
						"properties": {
							"parameters": {
								"type": "object",
								"additionalProperties": false,
								"properties": {
									"maker": {
										"enum": ["ThirdParty"]
									},
									"unprobedSensors": {
										"const": true
									},
									"unprobedTouchpad": {
										"const": true
									},
									"forcedVibration": {
										"const": true
									},
									"role": {
										"enum": ["Receiver"]
									}
								},
								"required": ["maker"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"family": {
								"not": {
									"enum": [
										"xbox.gip",
										"nintendo.switch1",
										"nintendo.switch2",
										"vendor.gamesir",
										"vendor.ps3-third-party",
										"sony.dualshock4",
										"vendor.nvidia-shield",
										"sony.dualsense"
									]
								}
							}
						},
						"required": ["family"]
					},
					"then": {
						"not": {
							"required": ["parameters"]
						}
					}
				}
			]
		},
		"gipInitializationAction": {
			"enum": [
				"xbox.gip/power-on",
				"xbox.gip/s-init",
				"xbox.gip/enable-extra-input",
				"xbox.gip/hori-ack",
				"xbox.gip/led-on",
				"xbox.gip/auth-done",
				"xbox.gip/rumble-begin",
				"xbox.gip/rumble-end"
			]
		},
		"capabilities": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"absent": {
					"$ref": "#/$defs/controlList"
				},
				"present": {
					"$ref": "#/$defs/controlList"
				},
				"rumble": {
					"const": "absent"
				}
			}
		},
		"controlList": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/controlID"
			}
		},
		"controlID": {
			"enum": [
				"dpad",
				"left-stick-x",
				"left-stick-y",
				"right-stick-x",
				"right-stick-y",
				"left-stick-click",
				"right-stick-click",
				"face-south",
				"face-east",
				"face-west",
				"face-north",
				"left-shoulder",
				"right-shoulder",
				"left-trigger",
				"right-trigger",
				"left-trigger-button",
				"right-trigger-button",
				"view",
				"menu",
				"guide",
				"share",
				"capture",
				"touchpad-click",
				"microphone",
				"paddle-left-1",
				"paddle-left-2",
				"paddle-right-1",
				"paddle-right-2",
				"auxiliary-1",
				"auxiliary-2",
				"auxiliary-3",
				"auxiliary-4",
				"auxiliary-5",
				"auxiliary-6",
				"auxiliary-7",
				"auxiliary-8",
				"left-stick-touch",
				"right-stick-touch",
				"left-trackpad-click",
				"right-trackpad-click",
				"left-trackpad-touch",
				"right-trackpad-touch"
			]
		},
		"usbOverride": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"configuration": {
					"const": "set1-before-claim"
				},
				"postHandshakeSettleMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"endpoints": {
					"type": "object",
					"required": ["in", "out"],
					"additionalProperties": false,
					"properties": {
						"in": {
							"type": "integer",
							"minimum": 128,
							"maximum": 255
						},
						"out": {
							"type": "integer",
							"minimum": 1,
							"maximum": 127
						}
					}
				}
			},
			"minProperties": 1
		},
		"bluetoothLE": {
			"type": "object",
			"required": ["vibrationCharacteristic"],
			"additionalProperties": false,
			"properties": {
				"vibrationCharacteristic": {
					"type": "string",
					"pattern": "^[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
				}
			}
		},
		"tuning": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"stickDeadzone": {
					"type": "number",
					"exclusiveMinimum": 0,
					"exclusiveMaximum": 1
				},
				"inputLivenessTimeoutMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"hidStartupIntervalMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 60000
				},
				"minimumHIDOutputIntervalMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 60000
				},
				"hidStartupRecoveryIntervalMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 60000
				},
				"hidStartupRecoveryRounds": {
					"type": "integer",
					"minimum": 1,
					"maximum": 10
				},
				"frameQueueCapacity": {
					"type": "integer",
					"minimum": 1,
					"maximum": 1024
				}
			}
		},
		"ownership": {
			"enum": ["macos", "ojd"]
		},
		"route": {
			"enum": ["ExtensionOwned"]
		},
		"output": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"rumble": {
					"$ref": "#/$defs/rumbleTemplate"
				},
				"startup": {
					"type": "array",
					"minItems": 1,
					"maxItems": 16,
					"items": {
						"$ref": "#/$defs/startupWrite"
					}
				}
			}
		},
		"rumbleTemplate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["report"],
			"minProperties": 2,
			"properties": {
				"report": {
					"$ref": "#/$defs/templateReport"
				},
				"leftMain": {
					"$ref": "#/$defs/templateByte"
				},
				"rightMain": {
					"$ref": "#/$defs/templateByte"
				},
				"leftTrigger": {
					"$ref": "#/$defs/templateByte"
				},
				"rightTrigger": {
					"$ref": "#/$defs/templateByte"
				}
			}
		},
		"startupWrite": {
			"type": "object",
			"additionalProperties": false,
			"required": ["report", "bytes"],
			"properties": {
				"report": {
					"$ref": "#/$defs/templateReport"
				},
				"bytes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 64,
					"items": {
						"type": "integer",
						"minimum": 0,
						"maximum": 255
					}
				},
				"delayMilliseconds": {
					"type": "integer",
					"minimum": 0,
					"maximum": 1000
				},
				"transport": {
					"enum": ["usb", "bluetooth-classic", "bluetooth-le"]
				}
			}
		},
		"templateReport": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "id", "length"],
			"properties": {
				"kind": {
					"enum": ["output", "feature"]
				},
				"id": {
					"type": "integer",
					"minimum": 0,
					"maximum": 255
				},
				"length": {
					"type": "integer",
					"minimum": 2,
					"maximum": 64
				}
			}
		},
		"templateByte": {
			"type": "object",
			"additionalProperties": false,
			"required": ["byte"],
			"properties": {
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				}
			}
		},
		"input": {
			"type": "object",
			"additionalProperties": false,
			"required": ["report"],
			"minProperties": 2,
			"properties": {
				"report": {
					"type": "object",
					"additionalProperties": false,
					"required": ["length"],
					"properties": {
						"id": {
							"type": "integer",
							"minimum": 1,
							"maximum": 255
						},
						"length": {
							"type": "integer",
							"minimum": 1,
							"maximum": 64
						}
					}
				},
				"buttons": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/inputButton"
					}
				},
				"axes": {
					"type": "array",
					"minItems": 1,
					"maxItems": 4,
					"items": {
						"$ref": "#/$defs/inputAxis"
					}
				},
				"hat": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/inputHatSource"
					}
				},
				"leftTrigger": {
					"$ref": "#/$defs/inputTrigger"
				},
				"rightTrigger": {
					"$ref": "#/$defs/inputTrigger"
				}
			}
		},
		"hidInput": {
			"type": "object",
			"additionalProperties": false,
			"required": ["hidUsageMap"],
			"properties": {
				"hidUsageMap": {
					"$ref": "#/$defs/hidUsageMap"
				}
			}
		},
		"hidUsageMap": {
			"$comment": "Maps HID usages to canonical controls for hid.descriptor. A record's map replaces the family's map whole. Each (page, usage) appears once, an axis range has min below max, and a hat range is 0...7 or 1...8: the Swift decoder and the Python validators enforce the first two. reportID, when present, limits the map to element values of that report.",
			"type": "object",
			"additionalProperties": false,
			"required": ["usages"],
			"properties": {
				"reportID": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				},
				"usages": {
					"type": "array",
					"minItems": 1,
					"items": {
						"$ref": "#/$defs/hidUsage"
					}
				}
			}
		},
		"hidUsage": {
			"oneOf": [
				{
					"$ref": "#/$defs/hidButtonUsage"
				},
				{
					"$ref": "#/$defs/hidAxisUsage"
				},
				{
					"$ref": "#/$defs/hidHatUsage"
				}
			]
		},
		"hidUsagePage": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"hidUsageID": {
			"type": "integer",
			"minimum": 0,
			"maximum": 65535
		},
		"hidButtonUsage": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "page", "usage", "control"],
			"properties": {
				"kind": {
					"const": "button"
				},
				"page": {
					"$ref": "#/$defs/hidUsagePage"
				},
				"usage": {
					"$ref": "#/$defs/hidUsageID"
				},
				"control": {
					"allOf": [
						{
							"$ref": "#/$defs/controlID"
						},
						{
							"not": {
								"enum": [
									"dpad",
									"left-stick-x",
									"left-stick-y",
									"right-stick-x",
									"right-stick-y",
									"left-trigger",
									"right-trigger"
								]
							}
						}
					]
				}
			}
		},
		"hidAxisUsage": {
			"$comment": "A stick axis reads -1...1 and a trigger 0...1 from the element's logical range, or from range when set. deadZone is the fraction of travel around zero (the start of a trigger) that reads as zero; the rest rescales to full travel. inverted flips the sign of a stick or the travel of a trigger.",
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "page", "usage", "control"],
			"properties": {
				"kind": {
					"const": "axis"
				},
				"page": {
					"$ref": "#/$defs/hidUsagePage"
				},
				"usage": {
					"$ref": "#/$defs/hidUsageID"
				},
				"control": {
					"enum": [
						"left-stick-x",
						"left-stick-y",
						"right-stick-x",
						"right-stick-y",
						"left-trigger",
						"right-trigger"
					]
				},
				"inverted": {
					"type": "boolean"
				},
				"range": {
					"$ref": "#/$defs/hidAxisRange"
				},
				"deadZone": {
					"type": "number",
					"exclusiveMinimum": 0,
					"exclusiveMaximum": 1
				}
			}
		},
		"hidAxisRange": {
			"type": "object",
			"additionalProperties": false,
			"required": ["min", "max"],
			"properties": {
				"min": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"max": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				}
			}
		},
		"hidHatUsage": {
			"$comment": "A hat reads eight positions, north first and clockwise, from the first value of its range; any value outside the range is neutral. Without a range, the element's logical minimum is the first value.",
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "page", "usage", "control"],
			"properties": {
				"kind": {
					"const": "hat"
				},
				"page": {
					"$ref": "#/$defs/hidUsagePage"
				},
				"usage": {
					"$ref": "#/$defs/hidUsageID"
				},
				"control": {
					"const": "dpad"
				},
				"range": {
					"oneOf": [
						{
							"const": {
								"min": 0,
								"max": 7
							}
						},
						{
							"const": {
								"min": 1,
								"max": 8
							}
						}
					]
				}
			}
		},
		"inputField": {
			"type": "object",
			"additionalProperties": false,
			"required": ["byte", "mask"],
			"properties": {
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"mask": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"inputButton": {
			"type": "object",
			"additionalProperties": false,
			"required": ["control", "byte", "mask"],
			"properties": {
				"control": {
					"allOf": [
						{
							"$ref": "#/$defs/controlID"
						},
						{
							"not": {
								"enum": [
									"dpad",
									"left-stick-x",
									"left-stick-y",
									"right-stick-x",
									"right-stick-y",
									"left-trigger",
									"right-trigger"
								]
							}
						}
					]
				},
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"mask": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"inputAxis": {
			"type": "object",
			"additionalProperties": false,
			"required": ["control", "byte"],
			"properties": {
				"control": {
					"enum": [
						"left-stick-x",
						"left-stick-y",
						"right-stick-x",
						"right-stick-y"
					]
				},
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"bits": {
					"enum": [8, 16]
				},
				"signed": {
					"type": "boolean"
				},
				"min": {
					"type": "integer",
					"minimum": -32768,
					"maximum": 65535
				},
				"max": {
					"type": "integer",
					"minimum": -32768,
					"maximum": 65535
				},
				"inverted": {
					"type": "boolean"
				},
				"symmetric": {
					"type": "boolean"
				}
			},
			"if": {
				"properties": {
					"symmetric": {
						"const": true
					}
				},
				"required": ["symmetric"]
			},
			"then": {
				"required": ["signed"],
				"properties": {
					"signed": {
						"const": true
					},
					"min": {
						"maximum": -1
					},
					"max": {
						"minimum": 1
					}
				}
			}
		},
		"inputHatSource": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["encoding", "byte", "mask"],
					"properties": {
						"encoding": {
							"const": "8-way"
						},
						"byte": {
							"type": "integer",
							"minimum": 0,
							"maximum": 63
						},
						"mask": {
							"type": "integer",
							"minimum": 7,
							"maximum": 255
						},
						"neutralUntilNonzero": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["encoding", "up", "right", "down", "left"],
					"properties": {
						"encoding": {
							"const": "directions"
						},
						"up": {
							"$ref": "#/$defs/inputField"
						},
						"right": {
							"$ref": "#/$defs/inputField"
						},
						"down": {
							"$ref": "#/$defs/inputField"
						},
						"left": {
							"$ref": "#/$defs/inputField"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["encoding", "byte", "mask", "values"],
					"properties": {
						"encoding": {
							"const": "table"
						},
						"byte": {
							"type": "integer",
							"minimum": 0,
							"maximum": 63
						},
						"mask": {
							"type": "integer",
							"minimum": 1,
							"maximum": 255
						},
						"values": {
							"$comment": "Every key must be a value the mask can hold: 0 up to the mask shifted right by its trailing zero bits. JSON Schema cannot compare a key with the mask, so the Swift decoder checks it.",
							"type": "object",
							"minProperties": 1,
							"propertyNames": {
								"pattern": "^(0|[1-9][0-9]{0,2})$"
							},
							"additionalProperties": {
								"enum": [
									"north",
									"northEast",
									"east",
									"southEast",
									"south",
									"southWest",
									"west",
									"northWest"
								]
							}
						}
					}
				}
			]
		},
		"inputTrigger": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"byte": {
					"type": "integer",
					"minimum": 0,
					"maximum": 63
				},
				"button": {
					"$ref": "#/$defs/inputField"
				}
			}
		}
	},
