{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha1/controller-override.schema.json",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["apiVersion", "kind", "operation", "record"],
			"properties": {
				"apiVersion": {
					"const": "openjoystickdriver/v1alpha1"
				},
				"kind": {
					"const": "ControllerOverride"
				},
				"operation": {
					"const": "add"
				},
				"record": {
					"$ref": "controller.schema.json"
				}
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["apiVersion", "kind", "operation", "vendorID", "productID", "set"],
			"properties": {
				"apiVersion": {
					"const": "openjoystickdriver/v1alpha1"
				},
				"kind": {
					"const": "ControllerOverride"
				},
				"operation": {
					"const": "patch"
				},
				"vendorID": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"productID": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"set": {
					"type": "object",
					"minProperties": 1,
					"additionalProperties": false,
					"properties": {
						"protocol": {
							"$ref": "controller.schema.json#/$defs/protocol"
						},
						"modes": {
							"$ref": "controller.schema.json#/$defs/modes"
						},
						"usb": {
							"$ref": "controller.schema.json#/$defs/usbOverride"
						},
						"bluetoothLE": {
							"$ref": "controller.schema.json#/$defs/bluetoothLE"
						},
						"ownership": {
							"$ref": "controller.schema.json#/$defs/ownership"
						},
						"route": {
							"$ref": "controller.schema.json#/$defs/route"
						},
						"output": {
							"$ref": "controller.schema.json#/$defs/output"
						},
						"input": {
							"$ref": "controller.schema.json#/$defs/input"
						},
						"tuning": {
							"$ref": "controller.schema.json#/$defs/tuning"
						}
					}
				}
			}
		}
	]
}
