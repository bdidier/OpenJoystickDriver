	"$defs": {
		"interfaceSignature": {
			"type": "object",
			"additionalProperties": false,
			"required": ["variant", "interfaceClass", "interfaceSubclass", "interfaceProtocol"],
			"properties": {
				"variant": {
					"enum": ["usb", "bluetooth-classic", "bluetooth-le", "gamepad", "wired", "receiver", "dongle", "enhanced-hid"]
				},
				"interfaceClass": {
					"$ref": "#/$defs/byte"
				},
				"interfaceSubclass": {
					"$ref": "#/$defs/byte"
				},
				"interfaceProtocol": {
					"$ref": "#/$defs/byte"
				},
				"interfaceNumber": {
					"$ref": "#/$defs/byte"
				}
			}
		},
		"byte": {
			"type": "integer",
			"minimum": 0,
			"maximum": 255
		},
		"parameterDeclaration": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type"],
					"properties": {
						"type": {
							"const": "flag"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "values"],
					"properties": {
						"type": {
							"const": "enum"
						},
						"values": {
							"type": "array",
							"minItems": 1,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"pattern": "^[A-Z][A-Za-z0-9]*$"
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "fields"],
					"properties": {
						"type": {
							"const": "object"
						},
						"fields": {
							"type": "object",
							"minProperties": 1,
							"additionalProperties": {
								"$ref": "#/$defs/integerField"
							}
						}
					}
				}
			]
		},
		"integerField": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "minimum", "maximum"],
			"properties": {
				"type": {
					"const": "integer"
				},
				"minimum": {
					"type": "integer"
				},
				"maximum": {
					"type": "integer"
				}
			}
		},
		"defaults": {
			"type": "object",
			"additionalProperties": false,
			"minProperties": 1,
			"properties": {
				"capabilities": {
					"$ref": "controller.schema.json#/$defs/capabilities"
				},
				"output": {
					"$ref": "controller.schema.json#/$defs/output"
				},
				"input": {
					"$ref": "controller.schema.json#/$defs/input"
				},
				"tuning": {
					"$ref": "controller.schema.json#/$defs/tuning"
				}
			}
		}
	}
