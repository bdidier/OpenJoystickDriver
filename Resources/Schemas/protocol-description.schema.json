{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://xsyetopz.github.io/OpenJoystickDriver/schemas/v1alpha1/protocol-description.schema.json",
	"$comment": "Each family's variants are PhysicalProtocolID.variants in Swift; a family with none has no interface signatures.",
	"type": "object",
	"additionalProperties": false,
	"required": ["apiVersion", "kind", "family", "interfaceSignatures"],
	"properties": {
		"apiVersion": {
			"const": "openjoystickdriver/v1alpha1"
		},
		"kind": {
			"const": "ProtocolDescription"
		},
		"family": {
			"$ref": "controller.schema.json#/$defs/protocol/properties/family"
		},
		"interfaceSignatures": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"$ref": "#/$defs/interfaceSignature"
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"family": {
						"const": "hid.descriptor"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"maxItems": 0
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "hid.report-layout"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"maxItems": 0
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "xbox.xid"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["gamepad"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "xbox.xusb"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["wired", "receiver"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "xbox.gip"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "sony.sixaxis"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "bluetooth-classic"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "sony.dualshock4"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "bluetooth-classic"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "sony.dualsense"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "bluetooth-classic"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "nintendo.switch1"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "bluetooth-classic"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "nintendo.switch2"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "bluetooth-le"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "nintendo.switch-input-only"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "bluetooth-classic"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "valve.steam-controller"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["wired", "dongle", "bluetooth-le"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "valve.steam-triton"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["wired", "dongle", "bluetooth-le"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "valve.steam-deck"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"maxItems": 0
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "vendor.flydigi"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"maxItems": 0
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "vendor.ps3-third-party"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"maxItems": 0
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "vendor.gamesir"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"items": {
							"properties": {
								"variant": {
									"enum": ["usb", "enhanced-hid"]
								}
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"family": {
						"const": "vendor.nvidia-shield"
					}
				}
			},
			"then": {
				"properties": {
					"interfaceSignatures": {
						"maxItems": 0
					}
				}
			}
		}
	],
	"$defs": {
		"interfaceSignature": {
			"type": "object",
			"additionalProperties": false,
			"required": ["variant", "interfaceClass", "interfaceSubclass", "interfaceProtocol"],
			"properties": {
				"variant": {
					"enum": ["usb", "bluetooth-classic", "bluetooth-le", "gamepad", "wired", "receiver", "dongle", "enhanced-hid"]
				},
				"interfaceClass": {
					"$ref": "#/$defs/byte"
				},
				"interfaceSubclass": {
					"$ref": "#/$defs/byte"
				},
				"interfaceProtocol": {
					"$ref": "#/$defs/byte"
				},
				"interfaceNumber": {
					"$ref": "#/$defs/byte"
				}
			}
		},
		"byte": {
			"type": "integer",
			"minimum": 0,
			"maximum": 255
		}
	}
}
