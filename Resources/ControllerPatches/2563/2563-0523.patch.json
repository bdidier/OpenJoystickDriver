{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ControllerPatch",
  "selector": {
    "vendorID": 9571,
    "productID": 1315
  },
  "patch": {
    "modes": [
      {
        "id": "default",
        "protocol": {
          "family": "sony.sixaxis"
        }
      },
      {
        "id": "bluetooth",
        "protocol": {
          "family": "sony.sixaxis"
        },
        "match": {
          "link": "bluetooth-classic"
        },
        "session": {
          "startup": [
            {
              "report": {
                "kind": "feature",
                "id": 244,
                "length": 5
              },
              "bytes": [66, 3, 0, 0]
            }
          ]
        }
      }
    ]
  }
}
