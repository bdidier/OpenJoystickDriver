{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "valve.steam-deck",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "keepAliveIntervalMs"
  ],
  "controls": {
    "base": "xbox",
    "add": [
      "Guide",
      "Auxiliary1",
      "LeftPaddle1",
      "LeftPaddle2",
      "RightPaddle1",
      "RightPaddle2",
      "LeftStickTouch",
      "RightStickTouch",
      "LeftTrackpadClick",
      "RightTrackpadClick",
      "LeftTrackpadTouch",
      "RightTrackpadTouch"
    ],
    "touchContactCount": 1,
    "motion": true,
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "tuning": {
      "keepAliveIntervalMs": 1000,
      "frameQueueCapacity": 64
    }
  }
}
