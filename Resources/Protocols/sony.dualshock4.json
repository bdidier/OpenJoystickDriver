{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "sony.dualshock4",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "inputLivenessTimeoutMs",
    "adapterDisconnectDelayMs"
  ],
  "macOSOwnedOutput": {
    "readsStartupFeatures": true,
    "rationale": "A DualShock 4 on Bluetooth sends only the 10-byte input report until the host reads the calibration feature report, which macOS does not do."
  },
  "parameters": {
    "motionCalibration": {
      "type": "enum",
      "values": ["Factory"]
    },
    "role": {
      "type": "enum",
      "values": ["WirelessAdapter"]
    },
    "motionScale": {
      "type": "enum",
      "values": ["StrikePad"]
    }
  },
  "controls": {
    "base": "xbox",
    "add": ["Guide", "TouchpadClick"],
    "touchContactCount": 2,
    "motion": true,
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "defaults": {
    "session": {
      "startup": [
        {
          "report": {
            "kind": "output",
            "id": 17,
            "length": 78
          },
          "bytes": "C4 00 01 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00",
          "phase": "startup",
          "variants": ["bluetooth-classic"],
          "crc32Seed": 162
        }
      ]
    },
    "tuning": {
      "inputLivenessTimeoutMs": 1000,
      "adapterDisconnectDelayMs": 500,
      "frameQueueCapacity": 64
    }
  }
}
