{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "sony.dualsense",
  "endpoints": {
    "in": 130,
    "out": 2
  },
  "tuningKeys": [
    "hidStartupIntervalMs",
    "minimumHIDOutputIntervalMs",
    "adapterDisconnectDelayMs"
  ],
  "buttonLabels": "PlayStation",
  "parameters": {
    "maker": {
      "type": "enum",
      "values": ["ThirdParty"]
    },
    "unprobedSensors": {
      "type": "flag"
    },
    "unprobedTouchpad": {
      "type": "flag"
    },
    "forcedVibration": {
      "type": "flag"
    },
    "role": {
      "type": "enum",
      "values": ["Receiver"]
    }
  },
  "controls": {
    "base": "xbox",
    "add": ["Guide", "TouchpadClick", "Microphone"],
    "touchContactCount": 2,
    "motion": true,
    "digitalTriggers": ["LeftTrigger", "RightTrigger"]
  },
  "recordCapabilities": {
    "present": ["LeftPaddle1", "RightPaddle1", "Auxiliary1", "Auxiliary2"]
  },
  "defaults": {
    "tuning": {
      "adapterDisconnectDelayMs": 500,
      "frameQueueCapacity": 64
    }
  }
}
