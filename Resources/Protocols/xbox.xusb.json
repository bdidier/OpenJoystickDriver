{
  "apiVersion": "openjoystickdriver/v1alpha1",
  "kind": "ProtocolDescription",
  "family": "xbox.xusb",
  "endpoints": {
    "in": 129,
    "out": 1
  },
  "rawUSB": true,
  "interfaceSignatures": [
    {
      "variant": "wired",
      "interfaceClass": 255,
      "interfaceSubclass": 93,
      "interfaceProtocol": 1
    },
    {
      "variant": "receiver",
      "interfaceClass": 255,
      "interfaceSubclass": 93,
      "interfaceProtocol": 129
    }
  ],
  "controls": {
    "base": "xbox",
    "add": ["Guide"]
  },
  "rawUSBTuningKeys": ["presenceResendReports", "usbTransferTimeoutMs"],
  "defaults": {
    "session": {
      "startup": [
        {
          "bytes": "08 00 0F C0 00 00 00 00 00 00 00 00",
          "timeoutMilliseconds": 2000,
          "toleratesRejection": true,
          "variants": ["receiver"]
        }
      ],
      "receiverInquiryResendLimit": 8
    },
    "tuning": {
      "presenceResendReports": 16,
      "usbTransferTimeoutMs": 2000
    }
  }
}
