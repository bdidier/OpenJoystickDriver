{
	"apiVersion": "openjoystickdriver/v1alpha1",
	"kind": "ProtocolDescription",
	"family": "nintendo.switch1",
	"endpoints": {
		"in": 130,
		"out": 2
	},
	"tuningKeys": [
		"hidStartupIntervalMs",
		"minimumHIDOutputIntervalMs",
		"hidStartupRecoveryIntervalMs",
		"hidStartupRecoveryRounds"
	],
	"buttonLabels": "Nintendo",
	"parameters": {
		"layout": {
			"type": "enum",
			"values": [
				"Pro",
				"JoyConLeft",
				"JoyConRight"
			]
		},
		"usbProtocol": {
			"type": "enum",
			"values": [
				"ChargingOnly"
			]
		}
	},
	"defaults": {
		"tuning": {
			"minimumHIDOutputIntervalMs": 50
		}
	}
}
