{
	"apiVersion": "openjoystickdriver/v1alpha1",
	"kind": "ProtocolDescription",
	"family": "vendor.gamesir",
	"endpoints": {
		"in": 130,
		"out": 2
	},
	"rawUSB": [
		"usb"
	],
	"tuningKeys": [
		"hidStartupIntervalMs",
		"minimumHIDOutputIntervalMs"
	],
	"parameters": {
		"innerGrips": {
			"type": "flag"
		},
		"lightingMemory": {
			"type": "enum",
			"values": [
				"ProfileSlots"
			]
		}
	},
	"defaults": {
		"tuning": {
			"hidStartupIntervalMs": 20,
			"minimumHIDOutputIntervalMs": 20
		}
	}
}
